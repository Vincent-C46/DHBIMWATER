<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Compile Remove="Repositories\Revit\Element\**" />
    <EmbeddedResource Remove="Repositories\Revit\Element\**" />
    <None Remove="Repositories\Revit\Element\**" />
    <Page Remove="Repositories\Revit\Element\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DHBIMWATER.Core\DHBIMWATER.Core.csproj" />
    <ProjectReference Include="..\DHBIMWATER.Application\DHBIMWATER.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="3.6.51" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="ExcelDataReader" Version="3.8.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.8.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DidasUsage">
      <HintPath>..\DHBIMWATER.Revit\libs\DidasUsage\DidasUsage.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Revit 2025 API (.NET 8) — 2025/2027 공용. 로컬 Revit 설치 경로에 의존하지 않음 -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.4.60" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.4.60" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
