<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ========================================
         Base TextBlock Style
         ======================================== -->
    <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MainTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ========================================
         Heading Styles - 제목용 스타일
         ======================================== -->
    <Style x:Key="HeadingTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="SubHeadingTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- ========================================
         Body Styles - 본문용 스타일
         ======================================== -->
    <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>

    <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TextSubBrush}"/>
    </Style>

    <!-- ========================================
         Label Styles - 라벨용 스타일
         ======================================== -->
    <Style x:Key="LabelTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="RequiredLabelTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ========================================
         Status Styles - 상태 표시용 스타일
         ======================================== -->
    <Style x:Key="SuccessTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Success}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style x:Key="WarningTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style x:Key="ErrorTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Error}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style x:Key="InfoTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Info}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <!-- ========================================
         Highlight Styles - 강조용 스타일
         ======================================== -->
    <Style x:Key="PrimaryTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="BoldTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="LightTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{StaticResource TextSubBrush}"/>
        <Setter Property="FontWeight" Value="Light"/>
    </Style>

    <!-- ========================================
         Help Icon - 원 안 ? 아이콘, 마우스 올리면 Tag 문구 툴팁
         사용: <ContentControl Style="{StaticResource HelpIconStyle}" Tag="설명 문구"/>
         ======================================== -->
    <!-- 툴팁을 템플릿 안에 둔다. Style Setter로 ToolTip 객체 주면 인스턴스끼리 하나를 공유한다.
         ToolTip은 별도 트리라 TemplateBinding 안 됨 — PlacementTarget(Grid).Tag 경유로 읽는다. -->
    <Style x:Key="HelpIconStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Width="16" Height="16" Background="Transparent" Cursor="Help" Tag="{TemplateBinding Tag}"
                          ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                        <Grid.ToolTip>
                            <ToolTip MaxWidth="380">
                                <TextBlock TextWrapping="Wrap"
                                           Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}}"/>
                            </ToolTip>
                        </Grid.ToolTip>
                        <Ellipse x:Name="Circle" Stroke="{StaticResource Brush.Gray.500}" StrokeThickness="1.2"/>
                        <TextBlock x:Name="Mark" Text="?" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Gray.500}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="Stroke" Value="{StaticResource Brush.Primary}"/>
                            <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Brush.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
