<Window x:Class="DHBIMWATER.UI.Views.Modeling.ValveRoomDimensionCatalogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls"
        xmlns:vm="clr-namespace:DHBIMWATER.UI.ViewModels.Modeling"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ValveRoomDimensionCatalogViewModel}"
        Title="DHBIMWATER - 밸브실 제원표" Width="760" Height="620" WindowStartupLocation="CenterOwner"
        Background="#F4F7F9" WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic" ShowInTaskbar="False" ResizeMode="NoResize">
    <!-- docs/312. 유형별 관경 → 내부 길이·폭·높이 표. [확인]하면 문서(DataStorage)에 저장되고 [기본값]·위치 자동지정부터 쓰인다. -->
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <controls:TitleBar/>
        <Border Grid.Row="1" Background="White" CornerRadius="12" Margin="20,12" Padding="16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="관경별 내부 치수" Style="{StaticResource SubHeadingTextBlockStyle}" Foreground="#4A6FA5"/>
                <TextBlock Grid.Row="1" Text="상수도시설 밸브실 표준도 표 4.1~4.6이 기본값입니다. 고친 표는 이 문서에만 저장됩니다. 길이 = 관 방향, 폭 = 직각, 단위 mm."
                           Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="유형" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding RoomKinds}" SelectedItem="{Binding SelectedRoomKind}"/>
                    <Button Grid.Column="3" Content="행 추가" Command="{Binding AddRowCommand}" Style="{StaticResource CancelButtonStyle}" Margin="0,0,8,0"/>
                    <Button Grid.Column="4" Content="행 삭제" Command="{Binding DeleteRowCommand}" Style="{StaticResource CancelButtonStyle}"/>
                </Grid>
                <DataGrid Grid.Row="3" Style="{StaticResource PrimaryDataGridStyle}" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow}"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="형식" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Variant, TargetNullValue=-}" VerticalAlignment="Center" Margin="4,0"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.VariantOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              IsEnabled="{Binding DataContext.HasVariants, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding Variant, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="구분" Binding="{Binding Group, UpdateSourceTrigger=LostFocus}" Width="60"/>
                        <DataGridTextColumn Header="관경 DN" Binding="{Binding DiameterMm, StringFormat={}{0:0.###}, UpdateSourceTrigger=LostFocus}" Width="90"/>
                        <DataGridTextColumn Header="길이 L" Binding="{Binding LengthMm, StringFormat={}{0:0.###}, UpdateSourceTrigger=LostFocus}" Width="90"/>
                        <DataGridTextColumn Header="폭 W" Binding="{Binding WidthMm, StringFormat={}{0:0.###}, UpdateSourceTrigger=LostFocus}" Width="90"/>
                        <DataGridTextColumn Header="높이 H" Binding="{Binding HeightMm, StringFormat={}{0:0.###}, UpdateSourceTrigger=LostFocus}" Width="90"/>
                        <DataGridTextColumn Header="계산단면(m)" Binding="{Binding Section, UpdateSourceTrigger=LostFocus}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="4" Margin="0,8,0,0" Text="{Binding ErrorMessage}" Foreground="#C0392B" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
            <Button Content="표준값 복원" Command="{Binding ResetCommand}" Style="{StaticResource CancelButtonStyle}" Margin="0,0,8,0" ToolTip="모든 유형을 표준도 값으로 되돌립니다(저장은 [확인] 시)."/>
            <Button Content="확인" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" ToolTip="문서에 저장하고 닫습니다."/>
            <Button Content="취소" Command="{Binding CancelCommand}" Style="{StaticResource CancelButtonStyle}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
