<Window x:Class="DHBIMWATER.UI.Views.Modeling.PipeSpecTableView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls" Title="관 · 곡관 설정 — 주철관·강관 핸드북" Width="1120" Height="680" WindowStartupLocation="CenterOwner" WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic" Background="#F4F7F9">
    <Window.Resources><ResourceDictionary><BooleanToVisibilityConverter x:Key="BoolToVisibility"/><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <controls:TitleBar/>
        <Border Grid.Row="1" Background="White" CornerRadius="15" Margin="20,12" Padding="14">
            <DockPanel>
            <!-- 관종 토글(docs/211 § N). 그 관종의 탭만 보인다. 저장은 두 관종 행을 모두 보존한다. -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="관종" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <RadioButton Content="주철관" GroupName="PipeMaterialSpec" Tag="6,0,0,6" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding IsDuctileIronSelected, Mode=TwoWay}"/>
                <RadioButton Content="강관" GroupName="PipeMaterialSpec" Tag="0,6,6,0" Margin="-1,0,0,0" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding IsSteelSelected, Mode=TwoWay}"/>
                <TextBlock Text="표시: 선택 관종 · 저장: 두 관종 모두" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#7F8C8D"/>
            </StackPanel>
            <TabControl Style="{StaticResource PrimaryTabControlStyle}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <TabItem Header="직관 제원 (주철관)" Visibility="{Binding IsDuctileIronSelected, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="행 추가" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddStraightCommand}"/>
                            <Button Content="행 삭제" Style="{StaticResource CancelButtonStyle}" Margin="8,0" Command="{Binding RemoveStraightCommand}"/>
                        </StackPanel>
                        <DataGrid Style="{StaticResource PrimaryDataGridStyle}" ItemsSource="{Binding StraightRows, Mode=OneWay}" SelectedItem="{Binding SelectedStraight, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DN(mm)" Binding="{Binding DiameterMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="OD(mm)" Binding="{Binding OuterDiameterMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="상수1종 e(mm)" Binding="{Binding Water1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="상수2종 e(mm)" Binding="{Binding Water2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="상수3종 e(mm)" Binding="{Binding Water3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="상수4종 e(mm)" Binding="{Binding Water4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="하수1종 e(mm)" Binding="{Binding Sewer1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="하수2종 e(mm)" Binding="{Binding Sewer2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="하수3종 e(mm)" Binding="{Binding Sewer3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="직관 제원 (강관)" Visibility="{Binding IsSteelSelected, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="KS D 3565 · DN≤300: STWW 290/370 · DN≥350: STWW 400 A/B · 0 = 미수록 · DH_무게 = kg/m × 연장" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="행 추가" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddSteelStraightCommand}"/>
                                <Button Content="행 삭제" Style="{StaticResource CancelButtonStyle}" Margin="8,0" Command="{Binding RemoveSteelStraightCommand}"/>
                            </StackPanel>
                        </StackPanel>
                        <DataGrid Style="{StaticResource PrimaryDataGridStyle}" ItemsSource="{Binding SteelStraightRows, Mode=OneWay}" SelectedItem="{Binding SelectedSteelStraight, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DN(mm)" Binding="{Binding DiameterMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="OD(mm)" Binding="{Binding OuterDiameterMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="STWW 290 두께(mm)" Binding="{Binding Thickness290, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="STWW 290 kg/m" Binding="{Binding Weight290, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="STWW 370 두께(mm)" Binding="{Binding Thickness370, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="STWW 370 kg/m" Binding="{Binding Weight370, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="STWW 400 A 두께(mm)" Binding="{Binding Thickness400A, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="STWW 400 A kg/m" Binding="{Binding Weight400A, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="STWW 400 B 두께(mm)" Binding="{Binding Thickness400B, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="STWW 400 B kg/m" Binding="{Binding Weight400B, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="직관 무게 (주철관)" Visibility="{Binding IsDuctileIronSelected, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="핸드북 · 행 편집: [직관 제원] 탭 · DH_무게 = kg/m × 연장 + 소켓 · DH_단위중량 = kg/m · 0 = 미기록" TextWrapping="Wrap"/>
                        </StackPanel>
                        <DataGrid Style="{StaticResource PrimaryDataGridStyle}" ItemsSource="{Binding StraightRows, Mode=OneWay}" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DN(mm)" Binding="{Binding DiameterMm, Mode=OneWay}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="상수1종 kg/m" Binding="{Binding WeightWater1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="상수2종 kg/m" Binding="{Binding WeightWater2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="상수3종 kg/m" Binding="{Binding WeightWater3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="상수4종 kg/m" Binding="{Binding WeightWater4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="하수1종 kg/m" Binding="{Binding WeightSewer1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="하수2종 kg/m" Binding="{Binding WeightSewer2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="하수3종 kg/m" Binding="{Binding WeightSewer3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="KP 소켓(kg)" Binding="{Binding SocketWeightKpKg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="타이튼 소켓(kg)" Binding="{Binding SocketWeightTytonKg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="곡관 치수">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <!-- 설명은 단어 나열로 축약(2026-09-22 사용자 지시). 근거: 주철관 핸드북 이형관 표, KS D 3578 부도 1~5, docs/211 § 0-1 A1. -->
                            <TextBlock Text="주철관(핸드북): 소켓 DN80~1200 × 11¼~90° · 플랜지 45·90° · s=200&#10;강관(KS D 3578): DN80~3000 × 11¼~90° (5⅝°: DN≥1000) · F12/15/20 = 두께·무게만 다름&#10;패밀리·접합·F 선택: 모델링 창 [모델 유형 선택]" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="행 추가" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddFittingCommand}"/>
                                <Button Content="행 삭제" Style="{StaticResource CancelButtonStyle}" Margin="8,0" Command="{Binding RemoveFittingCommand}"/>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsSteelSelected, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="강관 곡관 종류(F)" VerticalAlignment="Center" Margin="24,0,6,0"/>
                                    <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" Width="90" ItemsSource="{Binding SteelFittingClassOptions, Mode=OneWay}" SelectedItem="{Binding SelectedSteelFittingClass, Mode=TwoWay}" ToolTip="표시·행 추가 기준 종류"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <TabControl Style="{StaticResource PrimaryTabControlStyle}" SelectedIndex="{Binding SelectedFittingTabIndex, Mode=TwoWay}">
                            <TabItem Header="소켓곡관 (주철관)" Visibility="{Binding IsDuctileIronSelected, Converter={StaticResource BoolToVisibility}}">
                                <DataGrid Style="{StaticResource PrimaryDataGridStyle}" ItemsSource="{Binding SocketFittingRows, Mode=OneWay}" SelectedItem="{Binding SelectedSocketFitting, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="DN" Binding="{Binding DiameterMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="각도(°)" Binding="{Binding AngleDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="e(mm)" Binding="{Binding WallThicknessMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="t(mm)" Binding="{Binding LayingLengthMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="R(mm)" Binding="{Binding CenterlineRadiusMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="s(mm)" Binding="{Binding ExtraLegLengthMm, Mode=OneWay}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="T(mm)" Binding="{Binding TangentLengthMm, Mode=OneWay}" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="플랜지곡관 (주철관)" Visibility="{Binding IsDuctileIronSelected, Converter={StaticResource BoolToVisibility}}">
                                <DataGrid Style="{StaticResource PrimaryDataGridStyle}" ItemsSource="{Binding FlangedFittingRows, Mode=OneWay}" SelectedItem="{Binding SelectedFlangedFitting, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="DN" Binding="{Binding DiameterMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="각도(°)" Binding="{Binding AngleDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="e(mm)" Binding="{Binding WallThicknessMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="t(mm)" Binding="{Binding LayingLengthMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="R(mm)" Binding="{Binding CenterlineRadiusMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="s(mm)" Binding="{Binding ExtraLegLengthMm, Mode=OneWay}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="T(mm)" Binding="{Binding TangentLengthMm, Mode=OneWay}" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <!-- 강관 곡관(docs/211 § H-2). Socket = 용접. 종류(F)는 상단 콤보로 거른다. -->
                            <TabItem Header="강관 용접곡관" Visibility="{Binding IsSteelSelected, Converter={StaticResource BoolToVisibility}}">
                                <DataGrid Style="{StaticResource PrimaryDataGridStyle}" ItemsSource="{Binding SteelSocketFittingRowsView, Mode=OneWay}" SelectedItem="{Binding SelectedSteelSocketFitting, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="DN" Binding="{Binding DiameterMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="각도(°)" Binding="{Binding AngleDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="종류" Binding="{Binding FittingClass, Mode=OneWay}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="T 관두께(mm)" Binding="{Binding WallThicknessMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="L 절점~관끝(mm)" Binding="{Binding LayingLengthMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="R(mm)" Binding="{Binding CenterlineRadiusMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="무게(kg)" Binding="{Binding WeightKg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="접선(mm)" Binding="{Binding TangentLengthMm, Mode=OneWay}" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="강관 플랜지곡관" Visibility="{Binding IsSteelSelected, Converter={StaticResource BoolToVisibility}}">
                                <DataGrid Style="{StaticResource PrimaryDataGridStyle}" ItemsSource="{Binding SteelFlangedFittingRowsView, Mode=OneWay}" SelectedItem="{Binding SelectedSteelFlangedFitting, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="DN" Binding="{Binding DiameterMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="각도(°)" Binding="{Binding AngleDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="종류" Binding="{Binding FittingClass, Mode=OneWay}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="T 관두께(mm)" Binding="{Binding WallThicknessMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="L 절점~관끝(mm)" Binding="{Binding LayingLengthMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="R(mm)" Binding="{Binding CenterlineRadiusMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="무게(kg)" Binding="{Binding WeightKg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="접선(mm)" Binding="{Binding TangentLengthMm, Mode=OneWay}" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </TabItem>
                <TabItem Header="허용굴곡 (주철관)" DataContext="{Binding Joint}" Visibility="{Binding DataContext.IsDuctileIronSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="적용 Joint Type"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding JointTypes, Mode=OneWay}" SelectedItem="{Binding ActiveJointType, Mode=TwoWay}" Margin="0,3,0,10"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Margin="0,0,8,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding KpJointTypeName, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="행 추가" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddKpCommand}"/>
                                        <Button Content="행 삭제" Style="{StaticResource CancelButtonStyle}" Margin="8,0,0,0" Command="{Binding RemoveKpCommand}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid Style="{StaticResource PrimaryDataGridStyle}" Grid.Row="1" ItemsSource="{Binding KpRows, Mode=OneWay}" SelectedItem="{Binding SelectedKpRow, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="DN(mm)" Width="*" Binding="{Binding DiameterMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="허용굴곡 θ(°)" Width="2*" Binding="{Binding AllowableDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding TytonJointTypeName, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="행 추가" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddTytonCommand}"/>
                                        <Button Content="행 삭제" Style="{StaticResource CancelButtonStyle}" Margin="8,0,0,0" Command="{Binding RemoveTytonCommand}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid Style="{StaticResource PrimaryDataGridStyle}" Grid.Row="1" ItemsSource="{Binding TytonRows, Mode=OneWay}" SelectedItem="{Binding SelectedTytonRow, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="DN(mm)" Width="*" Binding="{Binding DiameterMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="허용굴곡 θ(°)" Width="2*" Binding="{Binding AllowableDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </TabItem>
            </TabControl>
            </DockPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
            <Button Content="기본값 복원" Style="{StaticResource CancelButtonStyle}" Command="{Binding RestoreCommand}" Margin="0,0,18,0"/>
            <Button Content="설정 불러오기" Style="{StaticResource CancelButtonStyle}" Command="{Binding ImportCommand}" Margin="0,0,8,0"/>
            <Button Content="설정 내보내기" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ExportCommand}" Margin="0,0,18,0"/>
            <Button Content="취소" Style="{StaticResource CancelButtonStyle}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
            <Button Content="확인" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
