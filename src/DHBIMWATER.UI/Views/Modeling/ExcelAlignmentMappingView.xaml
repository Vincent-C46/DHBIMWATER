<Window x:Class="DHBIMWATER.UI.Views.Modeling.ExcelAlignmentMappingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls" Title="엑셀 데이터 매핑" Width="660" SizeToContent="Height" WindowStartupLocation="CenterOwner" WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic" Background="#F4F7F9" Loaded="OnLoaded">
    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:TitleBar/>
        <Border Grid.Row="1" Background="White" CornerRadius="15" Margin="20,12" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource PrimaryBrush}" Text="파일 추가 · 엑셀 소스" FontWeight="Bold"/>
                    <TextBlock Style="{StaticResource SubHeadingTextBlockStyle}" Text="엑셀 데이터 매핑" Margin="0,2,0,2"/>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding FileName}" Margin="0,0,0,14"/>

                    <GroupBox Header="시트 선택 (시트별 관로 1개)" Style="{StaticResource PrimaryGroupBox}" Margin="0,0,0,14" IsEnabled="{Binding IsSheetSelectionEnabled, Mode=OneWay}">
                        <ItemsControl ItemsSource="{Binding Sheets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource PrimaryCheckBoxStyle}" Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,4,10,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <StackPanel Width="90" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="헤더 행"/>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding HeaderRow, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Width="110" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="데이터 시작 행"/>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding DataStartRow, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="미리보기 시트"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding CheckedSheets, Mode=OneWay}" SelectedItem="{Binding PreviewSheet, Mode=TwoWay}" DisplayMemberPath="Name" MinWidth="180"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="미리보기"/>
                    <DataGrid Style="{StaticResource QuantityDataGridStyle}" ItemsSource="{Binding PreviewView}" AutoGenerateColumns="True" Height="170" Margin="0,0,0,14"/>

                    <GroupBox Header="열 지정" Style="{StaticResource PrimaryGroupBox}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource RequiredLabelTextBlockStyle}" Text="X (E/W) *" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,0,0,8" ItemsSource="{Binding ColumnOptions}" SelectedItem="{Binding XColumn}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource RequiredLabelTextBlockStyle}" Text="Y (N/S) *" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,0,0,8" ItemsSource="{Binding ColumnOptions}" SelectedItem="{Binding YColumn}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource RequiredLabelTextBlockStyle}" Text="{Binding ZLabel}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,0,0,8" ItemsSource="{Binding ColumnOptions}" SelectedItem="{Binding ZColumn}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="Station" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,0,0,8" ItemsSource="{Binding OptionalColumnOptions}" SelectedItem="{Binding StationColumn}"/>

                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton Style="{StaticResource PrimaryRadioButtonStyle}" Content="Station 방식" IsChecked="{Binding IsStationMode, Mode=TwoWay}" GroupName="StationParseMode" Margin="0,0,14,0"/>
                                <RadioButton Style="{StaticResource PrimaryRadioButtonStyle}" Content="NumberChain 방식" IsChecked="{Binding IsNumberChainMode, Mode=TwoWay}" GroupName="StationParseMode"/>
                                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" Visibility="{Binding IsNumberChainMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="간격(m)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Width="70" Text="{Binding NumberChainIntervalM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="곡관 종류" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,0,0,8" ItemsSource="{Binding OptionalColumnOptions}" SelectedItem="{Binding BendKindColumn, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="직경(DN)" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="6" Grid.Column="1" Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding OptionalColumnOptions}" SelectedItem="{Binding VertexDiameterColumn, Mode=TwoWay}"/>

                            <!-- 밸브실 위치 자동지정에서만 보인다(docs/304). 선형 시트 1장에 밸브실 행을 끼우고 유형·원지반 열을 더한 표. -->
                            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource RequiredLabelTextBlockStyle}" Text="밸브실 유형 *" VerticalAlignment="Center" Margin="0,8,0,0"
                                       Visibility="{Binding IsValveRoomMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ComboBox Grid.Row="7" Grid.Column="1" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,8,0,0" ItemsSource="{Binding OptionalColumnOptions}" SelectedItem="{Binding ValveRoomTypeColumn, Mode=TwoWay}"
                                      Visibility="{Binding IsValveRoomMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource RequiredLabelTextBlockStyle}" Text="원지반 Z *" VerticalAlignment="Center" Margin="0,8,0,0"
                                       Visibility="{Binding IsValveRoomMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ComboBox Grid.Row="8" Grid.Column="1" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,8,0,0" ItemsSource="{Binding OptionalColumnOptions}" SelectedItem="{Binding GroundElColumn, Mode=TwoWay}"
                                      Visibility="{Binding IsValveRoomMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="9" Grid.Column="1" Margin="0,8,0,0" FontSize="11" Foreground="#7F8C8D" TextWrapping="Wrap"
                                       Text="※ 선형 시트 1개만 고르세요. 밸브실 유형 칸이 채워진 행이 밸브실 위치입니다. Z = 관저고(m), 원지반 Z(m). 측점·직경(DN) 필수."
                                       Visibility="{Binding IsValveRoomMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        </Grid>
                    </GroupBox>

                    <!-- 밸브실 모드 하단 목록(docs/304). 열 매핑에 따라 바로 갱신, 하나 골라 [확인]. -->
                    <GroupBox Header="밸브실 목록 — 하나 선택" Style="{StaticResource PrimaryGroupBox}" Margin="0,0,0,10"
                              Visibility="{Binding IsValveRoomMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ValveRoomListStatus}" FontSize="11" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <DataGrid Style="{StaticResource QuantityDataGridStyle}" ItemsSource="{Binding ValveRoomRows}" SelectedItem="{Binding SelectedValveRoomRow, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Height="160">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="행" Binding="{Binding RowNumber}" Width="50"/>
                                    <DataGridTextColumn Header="밸브실 유형" Binding="{Binding RoomType}" Width="*"/>
                                    <DataGridTextColumn Header="측점" Binding="{Binding StationText}" Width="*"/>
                                    <DataGridTextColumn Header="DN" Binding="{Binding DiameterMm, StringFormat=0}" Width="70"/>
                                    <DataGridTextColumn Header="관저고(m)" Binding="{Binding PipeInvertEl, StringFormat=0.000}" Width="90"/>
                                    <DataGridTextColumn Header="원지반(m)" Binding="{Binding GroundEl, StringFormat=0.000}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Content="취소" Style="{StaticResource CancelButtonStyle}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
            <Button Content="확인" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OkCommand}" IsEnabled="{Binding CanConfirm}"/>
        </StackPanel>
    </Grid>
</Window>
