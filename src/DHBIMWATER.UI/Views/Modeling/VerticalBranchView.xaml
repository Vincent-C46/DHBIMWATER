<Window x:Class="DHBIMWATER.UI.Views.Modeling.VerticalBranchView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls"
        xmlns:vm="clr-namespace:DHBIMWATER.UI.ViewModels.Modeling"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:VerticalBranchViewModel}"
        Title="DHBIMWATER - 수직분기 추가" Width="860" Height="620" WindowStartupLocation="CenterOwner"
        Background="#F4F7F9" WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic" ShowInTaskbar="False">
    <!-- docs/301 § D — 입면 미리보기. 시작 커넥터에서 +Z로 순서대로 쌓기. 모달 — 닫힌 뒤 ExternalEvent가 돈다. -->
    <Window.Resources><ResourceDictionary><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <controls:TitleBar/>
        <Grid Grid.Row="1" Margin="20,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <!-- 입면: 아래 = 시작 부속, 위로 쌓음. 단관은 길이 비례, 밸브는 기호 고정. -->
            <Border Background="White" CornerRadius="12" Padding="8" Margin="0,0,12,0">
                <Viewbox Stretch="Uniform" VerticalAlignment="Top">
                    <Canvas Width="240" Height="450">
                        <TextBlock Canvas.Left="4" Canvas.Top="0" Text="입면 (개략)" Foreground="#7F8C8D" FontSize="10"/>
                        <ItemsControl ItemsSource="{Binding PreviewItems, Mode=OneWay}" Canvas.Left="0" Canvas.Top="16" Width="240" Height="380">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding Top}"/></Style></ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate><DataTemplate><Canvas Width="240" Height="{Binding Height}">
                                <Rectangle Canvas.Left="88" Width="24" Height="{Binding Height}" Fill="#DCE6EE" Stroke="#7F8C8D" StrokeThickness="1"
                                           Visibility="{Binding IsPipe, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Path Canvas.Left="72" Data="M0,0 L56,0 L0,36 L56,36 Z" Fill="White" Stroke="#34495E" StrokeThickness="1.4">
                                    <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsPipe}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Path.Style>
                                </Path>
                                <Line X1="150" X2="150" Y1="0" Y2="{Binding Height}" Stroke="#C3CFD9"/>
                                <StackPanel Canvas.Left="156" Canvas.Top="{Binding LabelTopInItem}">
                                    <TextBlock Text="{Binding Label}" Foreground="#5D6D7E" FontSize="10" MaxWidth="80" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding LengthText}" Foreground="#22313F" FontSize="11" FontFamily="Consolas"/>
                                </StackPanel>
                            </Canvas></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- 시작 부속 -->
                        <Rectangle Canvas.Left="10" Canvas.Top="406" Width="220" Height="30" Fill="#F7F9FB" Stroke="#C3CFD9"/>
                        <Border Canvas.Left="66" Canvas.Top="396" Width="68" Height="44" Background="White" BorderBrush="#34495E" BorderThickness="1.5" CornerRadius="3">
                            <TextBlock Text="시작" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                        </Border>
                        <Ellipse Canvas.Left="97" Canvas.Top="393" Width="6" Height="6" Fill="#4A6FA5"/>
                    </Canvas>
                </Viewbox>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="시작 부속" Foreground="#5D6D7E" Margin="0,0,12,2"/>
                        <TextBlock Grid.Column="1" Text="{Binding StartText, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,12,0"><TextBlock Text="시작 커넥터" Foreground="#5D6D7E" VerticalAlignment="Center"/><ContentControl Style="{StaticResource HelpIconStyle}" Tag="+Z로 순서대로 쌓기 · 단관만 길이 입력 · 관경 = 시작 커넥터 (목록 위 = 아래쪽)"/></StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StartConnectorText, Mode=OneWay}" FontFamily="Consolas"/>
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="끝 쪽에 추가" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0"/>
                            <CheckBox DockPanel.Dock="Right" Content="전체 관경" IsChecked="{Binding ShowAllDiameters}" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="끄면 시작 관경과 DN이 같은 유형만 보입니다."/>
                            <ComboBox ItemsSource="{Binding AddOptions, Mode=OneWay}" SelectedItem="{Binding SelectedAddOption}" Style="{StaticResource PrimaryComboBoxStyle}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding SummaryText, Mode=OneWay}" Foreground="#34495E" FontSize="11"/>
                        <TextBlock Text="{Binding ErrorText, Mode=OneWay}" Foreground="#B03A2E" FontSize="11" TextWrapping="Wrap"
                                   Visibility="{Binding HasError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                    <ListBox Style="{StaticResource PrimaryListBoxStyle}" ItemsSource="{Binding PartsTopDown, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="3">
                            <Button DockPanel.Dock="Right" Content="삭제" Style="{StaticResource CancelButtonStyle}" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            <Button DockPanel.Dock="Right" Content="▼" ToolTip="아래로 (시작 쪽)" Style="{StaticResource CancelButtonStyle}" Margin="0,0,4,0" Command="{Binding DataContext.MoveTowardStartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            <Button DockPanel.Dock="Right" Content="▲" ToolTip="위로 (끝 쪽)" Style="{StaticResource CancelButtonStyle}" Margin="0,0,4,0" Command="{Binding DataContext.MoveTowardEndCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0" Visibility="{Binding IsPipe, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBox Width="80" Text="{Binding LengthMm, UpdateSourceTrigger=PropertyChanged, StringFormat=0.#}" Style="{StaticResource PrimaryTextBoxStyle}" TextAlignment="Right"/>
                                <TextBlock Text="mm" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
            <Button Content="Revit에 배치" Command="{Binding PlaceCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="취소" Command="{Binding CancelCommand}" Style="{StaticResource CancelButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
