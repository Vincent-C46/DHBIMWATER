<Window x:Class="DHBIMWATER.UI.Views.Modeling.ValveRoomView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls"
        xmlns:conv="clr-namespace:DHBIMWATER.UI.Converters"
        xmlns:vm="clr-namespace:DHBIMWATER.UI.ViewModels.Modeling"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ValveRoomViewModel, IsDesignTimeCreatable=False}"
        Title="DHBIMWATER - ValveRoom Builder"
        Width="1080" SizeToContent="Height" MaxHeight="900"
        WindowStartupLocation="CenterScreen" Background="#F4F7F9"
        WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:CornerToBoolConverter x:Key="CornerToBoolConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:TitleBar Grid.Row="0"/>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" CornerRadius="15" Margin="20,12" Padding="20">
            <Border.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#DDE4EB" Opacity="0.3"/></Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="밸브실 종류" FontWeight="Bold" Foreground="#4A6FA5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" Width="180"
                              ItemsSource="{Binding ValveRoomTypes}" SelectedItem="{Binding SelectedValveRoomType}"/>
                </StackPanel>
                <TabControl Style="{StaticResource PrimaryTabControlStyle}">
                    <TabItem Header="형상 · 배치" Style="{StaticResource PrimaryTabItemStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8">
                                <Border Background="#EEF2F7" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="X"/>
                                            <TextBlock Grid.Column="1" Text="실제 좌표 (동쪽)"/>
                                            <TextBox Grid.Column="2" Text="{Binding SharedCoordinateX, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="3" Text="m" Margin="8,0"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Y"/>
                                            <TextBlock Grid.Column="1" Text="실제 좌표 (북쪽)"/>
                                            <TextBox Grid.Column="2" Text="{Binding SharedCoordinateY, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="3" Text="m" Margin="8,0"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="EL"/>
                                            <TextBlock Grid.Column="1" Text="기초 상부 표고"/>
                                            <TextBox Grid.Column="2" Text="{Binding FoundationTopEl, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="3" Text="m" Margin="8,0"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="θ"/>
                                            <TextBlock Grid.Column="1" Text="도북각 (진북→도북, 시계방향)"/>
                                            <TextBox Grid.Column="2" Text="{Binding TrueNorthToProjectNorthClockwiseDegrees, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="3" Text="°" Margin="8,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="평면 · 높이 (내부 유효)" FontWeight="SemiBold" Foreground="#4A6FA5" Margin="0,0,0,8"/>
                                <Border Background="#EEF2F7" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="W"/>
                                            <TextBlock Grid.Column="1" Text="내부 폭 (X)"/>
                                            <TextBox Grid.Column="2" Text="{Binding InnerWidth, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="3" Text="mm" Margin="8,0"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="L"/>
                                            <TextBlock Grid.Column="1" Text="내부 길이 (Y)"/>
                                            <TextBox Grid.Column="2" Text="{Binding InnerLength, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="3" Text="mm" Margin="8,0"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0" Visibility="{Binding SingleHeightVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="H"/>
                                            <TextBlock Grid.Column="1" Text="내부 높이(슬래브 하부)"/>
                                            <TextBox Grid.Column="2" Text="{Binding InnerHeight, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="3" Text="mm" Margin="8,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Background="#EEF2F7" CornerRadius="8" Padding="14" Margin="0,0,0,12" Visibility="{Binding MudVisibility}">
                                    <StackPanel>
                                        <TextBlock Text="이토밸브실 내부 구성" FontWeight="SemiBold" Foreground="#4A6FA5" Margin="0,0,0,8"/>
                                        <CheckBox Content="중간벽체 적용" IsChecked="{Binding HasIntermediateWall}"/>
                                        <Grid Margin="0,8,0,0" Visibility="{Binding IntermediateWallVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="좌측 외벽 안쪽면→중간벽 좌측면"/>
                                            <TextBox Grid.Column="1" Text="{Binding IntermediateWallOffset, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="2" Text="mm" Margin="8,0"/>
                                        </Grid>
                                        <CheckBox Content="중간슬래브 적용" IsChecked="{Binding HasIntermediateSlab}" Margin="0,10,0,0"/>
                                        <StackPanel Visibility="{Binding IntermediateSlabVisibility}">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="35"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="1F 내부 높이"/>
                                                <TextBox Grid.Column="1" Text="{Binding Floor1InnerHeight, UpdateSourceTrigger=LostFocus}"/>
                                                <TextBlock Grid.Column="2" Text="mm" Margin="8,0"/>
                                            </Grid>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="35"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="2F 내부 높이"/>
                                                <TextBox Grid.Column="1" Text="{Binding Floor2InnerHeight, UpdateSourceTrigger=LostFocus}"/>
                                                <TextBlock Grid.Column="2" Text="mm" Margin="8,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="#EEF2F7" CornerRadius="8" Padding="14" Visibility="{Binding SluiceVisibility}">
                                    <StackPanel>
                                        <TextBlock Text="제수밸브실 보 · 기둥 배치" FontWeight="SemiBold" Foreground="#4A6FA5" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="X축 방향 보 개수"/>
                                            <TextBox Grid.Column="1" Text="{Binding BeamCountX, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="2" Text="개" Margin="8,0"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="X축: 외벽 내측→첫 보 중심 거리"/>
                                            <TextBox Grid.Column="1" Text="{Binding BeamOffsetX, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="2" Text="mm" Margin="8,0"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="X축 보 중심 간격"/>
                                            <TextBox Grid.Column="1" Text="{Binding BeamSpacingX, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="2" Text="mm" Margin="8,0"/>
                                        </Grid>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Y축 방향 보 개수"/>
                                            <TextBox Grid.Column="1" Text="{Binding BeamCountY, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="2" Text="개" Margin="8,0"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Y축: 외벽 내측→첫 보 중심 거리"/>
                                            <TextBox Grid.Column="1" Text="{Binding BeamOffsetY, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="2" Text="mm" Margin="8,0"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Y축 보 중심 간격"/>
                                            <TextBox Grid.Column="1" Text="{Binding BeamSpacingY, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="2" Text="mm" Margin="8,0"/>
                                        </Grid>
                                        <TextBlock Text="※ X·Y 방향 보가 직교하는 중심점마다 기둥을 자동 배치합니다." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#EEF2F7" CornerRadius="8" Padding="14" Margin="0,12,0,0" Visibility="{Binding DrainPitVisibility}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8"><TextBlock Text="드레인 피트" FontWeight="SemiBold" Foreground="#4A6FA5" DockPanel.Dock="Left"/><CheckBox Content="드레인 피트 생성" IsChecked="{Binding HasDrainPit, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
                                        <StackPanel IsEnabled="{Binding HasDrainPit}">
                                            <Border Padding="8" BorderBrush="#C7D3E0" BorderThickness="1" CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock Text="드레인 피트 코너 위치" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,4"/>
                                                    <Grid Width="160" Height="100">
                                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                        <Border Grid.RowSpan="2" Grid.ColumnSpan="2" BorderBrush="#4A6FA5" BorderThickness="2" Margin="10"/>
                                                        <CheckBox Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding DrainPit.Corner, Mode=TwoWay, Converter={StaticResource CornerToBoolConverter}, ConverterParameter=좌상단}"/>
                                                        <CheckBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" IsChecked="{Binding DrainPit.Corner, Mode=TwoWay, Converter={StaticResource CornerToBoolConverter}, ConverterParameter=우상단}"/>
                                                        <CheckBox Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsChecked="{Binding DrainPit.Corner, Mode=TwoWay, Converter={StaticResource CornerToBoolConverter}, ConverterParameter=좌하단}"/>
                                                        <CheckBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsChecked="{Binding DrainPit.Corner, Mode=TwoWay, Converter={StaticResource CornerToBoolConverter}, ConverterParameter=우하단}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="70"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="드레인 피트 Void 패밀리" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding DrainPitVoidFamilyNames}" SelectedItem="{Binding SelectedDrainPitVoidFamily, Mode=TwoWay}"/>
                                            </Grid>
                                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="70"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Length 매개변수" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding DrainPitVoidParameterNames}" SelectedItem="{Binding SelectedDrainPitLengthParam, Mode=TwoWay}"/>
                                                <TextBox Grid.Column="2" Margin="6,0,0,0" Text="{Binding DrainPit.LengthX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Column="3" Text="mm" Margin="8,0" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="70"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Width 매개변수" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding DrainPitVoidParameterNames}" SelectedItem="{Binding SelectedDrainPitWidthParam, Mode=TwoWay}"/>
                                                <TextBox Grid.Column="2" Margin="6,0,0,0" Text="{Binding DrainPit.WidthY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Column="3" Text="mm" Margin="8,0" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="70"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Depth 매개변수" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding DrainPitVoidParameterNames}" SelectedItem="{Binding SelectedDrainPitDepthParam, Mode=TwoWay}"/>
                                                <TextBox Grid.Column="2" Margin="6,0,0,0" Text="{Binding DrainPit.Depth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Column="3" Text="mm" Margin="8,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Text="드레인 피트는 밸브실당 1개입니다. 텍스트 상자 값이 mm 단위 실치수이며, Depth가 기초 상면 기준 굴착 깊이입니다. 콤보 상자는 그 값을 기록할 Void 패밀리의 인스턴스 매개변수로, 기본값은 자동 추정되고 직접 고르면 그 선택이 유지됩니다. Void는 기초 상단 EL에 자동 배치되며, Depth가 기초 두께를 넘으면 버림콘크리트까지 함께 절단합니다. 일반모델 Void 패밀리는 '로드할 때 보이드로 절단'이 켜져 있어야 합니다." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="부재 유형" Style="{StaticResource PrimaryTabItemStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8">
                                <Border Background="#EEF2F7" CornerRadius="8" Padding="14" Margin="0,0,0,12" Visibility="{Binding FrameVisibility}">
                                    <StackPanel>
                                        <TextBlock Text="구조 프레임 유형" FontWeight="SemiBold" Foreground="#4A6FA5" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="기둥 유형" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding ColumnTypeNames}" SelectedItem="{Binding SelectedColumnTypeName}"/>
                                        </Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="보 유형" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding BeamTypeNames}" SelectedItem="{Binding SelectedBeamTypeName}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Background="#EEF2F7" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="구조 두께" FontWeight="SemiBold" Foreground="#4A6FA5" Margin="0,0,0,8"/>
                                        <Grid Visibility="{Binding PlainConcreteVisibility}"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Tb"/><TextBlock Grid.Column="1" Text="버림 두께"/><TextBox Grid.Column="2" Text="{Binding PlainConcreteThickness, UpdateSourceTrigger=LostFocus}"/><TextBlock Grid.Column="3" Text="mm" Margin="8,0"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Tf"/><TextBlock Grid.Column="1" Text="기초 두께"/><TextBox Grid.Column="2" Text="{Binding FoundationThickness, UpdateSourceTrigger=LostFocus}"/><TextBlock Grid.Column="3" Text="mm" Margin="8,0"/>
                                        </Grid>
                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding AirValveVisibility}">
                                            <TextBlock Text="본관 관통 Void" FontWeight="SemiBold" Foreground="#4A6FA5" Margin="0,0,0,6"/>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="D"/><TextBlock Grid.Column="1" Text="본관 직경"/><TextBox Grid.Column="2" Text="{Binding MainPipeDiameter, UpdateSourceTrigger=LostFocus}"/><TextBlock Grid.Column="3" Text="mm" Margin="8,0"/>
                                            </Grid>
                                            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="H"/><TextBlock Grid.Column="1" Text="기초 상부~본관 중심 깊이"/><TextBox Grid.Column="2" Text="{Binding FoundationTopToPipeCenterDepth, UpdateSourceTrigger=LostFocus}"/><TextBlock Grid.Column="3" Text="mm" Margin="8,0"/>
                                            </Grid>
                                            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="축"/><TextBlock Grid.Column="1" Text="관통 방향"/><ComboBox Grid.Column="2" ItemsSource="{Binding VoidAxes}" SelectedItem="{Binding SelectedVoidAxis}"/>
                                            </Grid>
                                        </StackPanel>
                                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Lt"/><TextBlock Grid.Column="1" Text="기초 Toe 길이 (4변 공통)"/><TextBox Grid.Column="2" Text="{Binding FoundationToe, UpdateSourceTrigger=LostFocus}"/><TextBlock Grid.Column="3" Text="mm" Margin="8,0"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="To"/><TextBlock Grid.Column="1" Text="외벽 두께"/><TextBox Grid.Column="2" Text="{Binding OuterWallThickness, UpdateSourceTrigger=LostFocus}"/><TextBlock Grid.Column="3" Text="mm" Margin="8,0"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0" Visibility="{Binding IntermediateWallVisibility}"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Tw"/><TextBlock Grid.Column="1" Text="중간벽 두께"/><TextBox Grid.Column="2" Text="{Binding IntermediateWallThickness, UpdateSourceTrigger=LostFocus}"/><TextBlock Grid.Column="3" Text="mm" Margin="8,0"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Ts"/><TextBlock Grid.Column="1" Text="상부 슬래브 두께"/><TextBox Grid.Column="2" Text="{Binding UpperSlabThickness, UpdateSourceTrigger=LostFocus}"/><TextBlock Grid.Column="3" Text="mm" Margin="8,0"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0" Visibility="{Binding IntermediateSlabVisibility}"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Tm"/><TextBlock Grid.Column="1" Text="중간 슬래브 두께"/><TextBox Grid.Column="2" Text="{Binding IntermediateSlabThickness, UpdateSourceTrigger=LostFocus}"/><TextBlock Grid.Column="3" Text="mm" Margin="8,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <!-- 밸브실 종류별 참고도. 이미지 리소스가 없으면 빈 칸으로 표시된다. -->
        <Border Grid.Column="1" Background="White" CornerRadius="15" Margin="0,12,20,12" Padding="14">
            <Border.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#DDE4EB" Opacity="0.3"/></Border.Effect>
            <StackPanel>
                <TextBlock Text="평면도" FontWeight="SemiBold" Foreground="#4A6FA5" Margin="0,0,0,8"/>
                <Border Background="#EEF2F7" CornerRadius="8" Height="140" Margin="0,0,0,16">
                    <Image Source="{Binding PlanImagePath}" Stretch="Uniform" Margin="6"/>
                </Border>
                <TextBlock Text="단면도" FontWeight="SemiBold" Foreground="#4A6FA5" Margin="0,0,0,8"/>
                <Border Background="#EEF2F7" CornerRadius="8" Height="140">
                    <Image Source="{Binding SectionImagePath}" Stretch="Uniform" Margin="6"/>
                </Border>
            </StackPanel>
        </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="20,0,20,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="#EEF2F7" CornerRadius="8" Padding="10"><TextBlock Text="{Binding Summary}" Foreground="#2C3E50" TextWrapping="Wrap"/></Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="기본값" Command="{Binding ResetCommand}" Margin="0,0,8,0"/>
                <Button Content="모델 생성" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
