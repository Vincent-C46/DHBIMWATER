<Window x:Class="DHBIMWATER.UI.Views.Modeling.PipeLayoutTemplateTextView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls"
        mc:Ignorable="d"
        Title="DHBIMWATER - 프리셋 텍스트" Width="640" Height="620" WindowStartupLocation="CenterOwner"
        Background="#F4F7F9" WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic" ShowInTaskbar="False">
    <!-- 임시 도구(2026-09-18 요청). 밸브실 유형별 기본 배관 값을 지시서로 넘기기 위해
         캔버스 내용을 제출 양식 텍스트로 보여 주기만 한다. 읽기 전용이라 여기서 고쳐도 캔버스는 바뀌지 않는다.
         유형별 기본값이 ValveRoomPipingTemplateCatalog에 들어가면 이 창과 호출부를 함께 지운다. -->
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <controls:TitleBar/>
        <Border Grid.Row="1" Background="White" CornerRadius="12" Margin="20,12" Padding="12">
            <TextBox x:Name="TextArea" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Consolas, D2Coding, Malgun Gothic" FontSize="12"
                     BorderThickness="0" Background="Transparent"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>
        <Grid Grid.Row="2" Margin="20,0,20,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="CopyHint" Text="클립보드에 복사했습니다." Foreground="#1E8449" FontSize="11"
                       VerticalAlignment="Center" Visibility="Collapsed"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="복사" Click="OnCopyClick" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" ToolTip="본문 전체를 클립보드에 복사합니다."/>
                <Button Content="닫기" Click="OnCloseClick" Style="{StaticResource CancelButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
