<Window x:Class="DHBIMWATER.UI.Views.Modeling.PipeLayoutFamilySettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls"
        xmlns:vm="clr-namespace:DHBIMWATER.UI.ViewModels.Modeling"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PipeLayoutViewModel}"
        Title="DHBIMWATER - Pipe Layout 설정" Width="600" Height="720" WindowStartupLocation="CenterOwner"
        Background="#F4F7F9" WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic" ShowInTaskbar="False" Validation.Error="OnValidationError">
    <!-- docs/175 § E-5. DataContext는 PipeLayoutViewModel 그대로다 — 콤보가 같은 프로퍼티에 바인딩되므로 별도 편집 사본이 없다.
         [저장]은 프로젝트(DataStorage)에 기록하고 창을 닫는다 — 모달 창이 떠 있는 동안은 ExternalEvent가 실행되지 않으므로 닫아야 저장이 처리된다.
         [닫기]는 이번 세션의 선택만 남긴다. 결과 메시지는 본창 하단 상태줄에 표시된다. -->
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <controls:TitleBar/>
        <Border Grid.Row="1" Background="White" CornerRadius="12" Margin="20,12" Padding="16">
            <!-- 패밀리 매핑과 스냅·기준점을 한 창에 모았다(docs/185). 우측 패널에는 자주 쓰는 입력만 남긴다.
                 [저장]은 패밀리·파라미터 매핑만 프로젝트에 기록한다 — 스냅·기준점은 예전처럼 이번 세션에만 적용된다. -->
            <TabControl Style="{StaticResource PrimaryTabControlStyle}">
                <TabItem Header="패밀리" Style="{StaticResource PrimaryTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,10,0,0">
            <TextBlock Text="여기서 고른 패밀리·파라미터는 [저장]을 누르면 프로젝트에 남고, 다음에 창을 열 때 그대로 돌아옵니다. 저장값이 없는 칸만 이름으로 추정합니다." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><StackPanel>
                <TextBlock Text="관" FontWeight="Bold" Foreground="#4A6FA5" Margin="0,0,0,6"/>
                <TextBlock Text="관 패밀리 (배관 부속류)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding SegmentFamilyTypeNames, Mode=OneWay}" SelectedItem="{Binding SegmentFamilyTypeName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,8"/>
                <TextBlock Text="관 길이 파라미터" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding LengthParameterNames, Mode=OneWay}" SelectedItem="{Binding LengthParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,8"/>
                <TextBlock Text="직경 파라미터 (선택)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding LengthParameterNames, Mode=OneWay}" SelectedItem="{Binding DiameterParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,4"/>
                <TextBlock Text="숫자(무차원) 파라미터를 고르면 관경 값을 mm 숫자 그대로 씁니다. 길이형이면 단위를 자동 변환합니다. 곡관·이형관·밸브 직경은 길이형만 지원합니다." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="정척 길이" VerticalAlignment="Center"/><TextBox Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding StraightLengthMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Grid.Column="2" Text="mm" Margin="4,0"/></Grid>
            </StackPanel></Border>
            <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><StackPanel>
                <TextBlock Text="곡관" FontWeight="Bold" Foreground="#4A6FA5" Margin="0,0,0,6"/>
                <TextBlock Text="곡관 패밀리 (배관 부속류)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding SegmentFamilyTypeNames, Mode=OneWay}" SelectedItem="{Binding BendFamilyTypeName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,4"/>
                <TextBlock Text="곡관 직경 파라미터 (선택)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding BendParameterNames, Mode=OneWay}" SelectedItem="{Binding BendDiameterParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,4"/>
                <TextBlock Text="곡관 각도 파라미터 (선택)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding BendParameterNames, Mode=OneWay}" SelectedItem="{Binding BendAngleParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,4"/>
                <TextBlock Text="각도 구분 없이 모든 절점에 이 패밀리 하나를 씁니다. 배관망에 여러 꺾임각이 섞여 있으면 이 패밀리의 실제 형상과 다른 각도에서 커넥터가 어긋날 수 있습니다." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
            </StackPanel></Border>
            <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><StackPanel>
                <TextBlock Text="T형관" FontWeight="Bold" Foreground="#4A6FA5" Margin="0,0,0,6"/>
                <TextBlock Text="T형관 패밀리 (직교 분기, 배관 부속류)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding SegmentFamilyTypeNames, Mode=OneWay}" SelectedItem="{Binding TeeFamilyTypeName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,10"/>
                <TextBlock Text="T형관 주관 직경 파라미터 (선택)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding TeeParameterNames, Mode=OneWay}" SelectedItem="{Binding TeeDiameterParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,10"/>
                <TextBlock Text="T형관 분기 직경 파라미터 (선택)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding TeeBranchParameterNames, Mode=OneWay}" SelectedItem="{Binding TeeBranchDiameterParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,10"/>
            </StackPanel></Border>
            <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><StackPanel>
                <TextBlock Text="Y형관 (경사 분기)" FontWeight="Bold" Foreground="#4A6FA5" Margin="0,0,0,6"/>
                <TextBlock Text="Y형관 패밀리 (배관 부속류)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding SegmentFamilyTypeNames, Mode=OneWay}" SelectedItem="{Binding WyeFamilyTypeName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,10"/>
                <TextBlock Text="Y형관 주관 직경 파라미터 (선택)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding WyeParameterNames, Mode=OneWay}" SelectedItem="{Binding WyeDiameterParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,10"/>
                <TextBlock Text="Y형관 분기 직경 파라미터 (선택)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding WyeBranchParameterNames, Mode=OneWay}" SelectedItem="{Binding WyeBranchDiameterParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,10"/>
                <!-- docs/195 § A — 지금 쓰는 Y형관 패밀리는 분기각 45° 고정이라 고를 것이 없다. UI에서만 숨긴다.
                     값·구동은 그대로다(사용자 확정): 저장값이나 이름 추정으로 잡힌 파라미터명은 계속 배치 때 각도를 구동한다
                     (PipeLayoutViewModel.cs:2511-2525 · SetOptionalAngleParameter). 패밀리가 각도 가변으로 바뀌면 Visibility만 걷어낸다. -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Text="Y형관 분기각 파라미터 (선택)" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding WyeAngleParameterNames, Mode=OneWay}" SelectedItem="{Binding WyeBranchAngleParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,4"/>
                </StackPanel>
                <TextBlock Text="분기각 30~60°인 절점에 이 패밀리를 놓습니다. 90°는 T형관이 맡습니다." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
            </StackPanel></Border>
            <!-- 밸브부관 A·B 카드는 오른쪽 "5. 바이패스 세트" 섹션으로 옮겼다(docs/229 § B). -->
            <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><StackPanel>
                <TextBlock Text="십자관" FontWeight="Bold" Foreground="#4A6FA5" Margin="0,0,0,6"/>
                <TextBlock Text="십자관 패밀리 (배관 부속류)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding SegmentFamilyTypeNames, Mode=OneWay}" SelectedItem="{Binding CrossFamilyTypeName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,10"/>
                <TextBlock Text="십자관 주관 직경 파라미터 (선택)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding CrossParameterNames, Mode=OneWay}" SelectedItem="{Binding CrossDiameterParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,10"/>
                <TextBlock Text="십자관 분기 직경 파라미터 (선택)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding CrossBranchParameterNames, Mode=OneWay}" SelectedItem="{Binding CrossBranchDiameterParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,10"/>
            </StackPanel></Border>
            <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><StackPanel>
                <TextBlock Text="이경관" FontWeight="Bold" Foreground="#4A6FA5" Margin="0,0,0,6"/>
                <TextBlock Text="이경관 패밀리 (배관 부속류)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding SegmentFamilyTypeNames, Mode=OneWay}" SelectedItem="{Binding ReducerFamilyTypeName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,10"/>
                <TextBlock Text="이경관 큰 쪽 직경 파라미터 (선택)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding ReducerLargeParameterNames, Mode=OneWay}" SelectedItem="{Binding ReducerLargeDiameterParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,10"/>
                <TextBlock Text="이경관 작은 쪽 직경 파라미터 (선택)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding ReducerSmallParameterNames, Mode=OneWay}" SelectedItem="{Binding ReducerSmallDiameterParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,4"/>
                <TextBlock Text="동심·편심을 한 칸으로 통합했습니다. 쓰는 이경관 패밀리 하나를 고르세요." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock Text="이경관은 아직 자동 배치하지 않습니다. 매핑만 저장됩니다." Foreground="#B03A2E" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,0"/>
            </StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <!-- docs/195 § B — "밸브 · 이음관" 탭을 없앴다. 밸브 패밀리 콤보는 본창 §4와 완전 중복이었고,
                     남은 구경 파라미터 2칸은 후보 목록이 본창 §4의 선택값을 보고 갱신되므로 본창 §4로 옮겼다
                     (PipeLayoutView.xaml "4. 밸브 · 이음관 배치"). docs/188 § ③의 "별도 탭" 판단을 뒤집은 것이다. -->
                <TabItem Header="스냅 · 기준점" Style="{StaticResource PrimaryTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,10,0,0">
                        <!-- 격자 스냅은 커서 좌표를 먼저 이산화하는 1차 스냅. OSNAP(객체 스냅)보다 앞에 둔다. -->
                        <TextBlock Text="격자 스냅 단위 · 직접 입력 가능" FontWeight="SemiBold" Foreground="#34495E"/>
                        <!-- 입력칸을 키운다(2026-09-16 사용자 지시). EditableComboBoxStyle은 MinHeight 15라 너무 납작하다.
                             스타일은 공용이므로 건드리지 않고 이 인스턴스에서만 덮어쓴다. -->
                        <Grid Margin="0,6,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                            <ComboBox IsTextSearchEnabled="False" MinHeight="30" FontSize="13" MaxDropDownHeight="240" ItemsSource="{Binding GridSnapOptions, Mode=OneWay}" Text="{Binding GridSnapMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Style="{StaticResource EditableComboBoxStyle}"/>
                            <TextBlock Grid.Column="1" Text="mm" Margin="4,0" VerticalAlignment="Center"/>
                        </Grid>
                        <CheckBox Content="직교 + 45° 각도 스냅" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding UseAngleSnap, Mode=TwoWay}" Margin="0,0,0,8"/>
                        <TextBlock Text="OSNAP  ·  커서가 100mm 이내일 때 적용" FontWeight="SemiBold" Foreground="#34495E"/>
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox Content="+ 기준점" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding SnapReferencePoint, Mode=TwoWay}" Margin="0,0,10,5"/>
                            <CheckBox Content="□ 끝점" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding SnapEndpoint, Mode=TwoWay}" Margin="0,0,10,5"/>
                            <CheckBox Content="△ 중간점" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding SnapMidpoint, Mode=TwoWay}" Margin="0,0,10,5"/>
                            <CheckBox Content="◇ 사분점" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding SnapQuadrant, Mode=TwoWay}" Margin="0,0,10,5"/>
                            <CheckBox Content="× 교차점" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding SnapIntersection, Mode=TwoWay}" Margin="0,0,10,5"/>
                            <CheckBox Content="⊥ 직교점" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding SnapPerpendicular, Mode=TwoWay}" Margin="0,0,10,5"/>
                            <CheckBox Content="· 근처점" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding SnapNearest, Mode=TwoWay}" Margin="0,0,10,0"/>
                        </WrapPanel>
                        <CheckBox Content="외곽선에도 OSNAP 적용" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding SnapOutline, Mode=TwoWay}" Margin="0,6,0,12"/>
                        <TextBlock Text="기준점 좌표" FontWeight="SemiBold"/>
                        <Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="X" VerticalAlignment="Center"/><TextBox Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding ReferenceX, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Grid.Column="2" Text="mm" Margin="4,0"/></Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="Y" VerticalAlignment="Center"/><TextBox Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding ReferenceY, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Grid.Column="2" Text="mm" Margin="4,0"/></Grid>
                        <TextBlock Text="스냅·기준점은 이번 세션에만 적용됩니다. [저장]은 패밀리·파라미터 매핑만 프로젝트에 기록합니다." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel></ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
            <!-- docs/195 § D — [모델 생성]이 끝나면 같은 설정이 자동으로 저장되므로 이 버튼은 필수가 아니다.
                 모델을 만들지 않고 설정만 남기고 싶을 때 쓴다. -->
            <Button Content="지금 저장" Command="{Binding SaveFamilySettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" ToolTip="지금 바로 프로젝트에 저장하고 창을 닫습니다. 모델을 생성하면 어차피 같은 설정이 자동 저장되므로, 모델을 만들지 않고 설정만 남길 때 쓰면 됩니다. 결과는 본창 하단 상태줄에 표시됩니다."/>
            <Button Content="닫기" Click="OnCloseClick" Style="{StaticResource CancelButtonStyle}" ToolTip="이번 세션의 선택만 남기고 닫습니다."/>
        </StackPanel>
    </Grid>
</Window>
