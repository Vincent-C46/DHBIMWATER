<UserControl x:Class="DHBIMWATER.UI.Views.Modeling.DischargeBasinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:DHBIMWATER.UI.Converters"
             xmlns:vm="clr-namespace:DHBIMWATER.UI.ViewModels.Modeling"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DischargeBasinViewModel, IsDesignTimeCreatable=False}"
             FontFamily="Segoe UI, Malgun Gothic">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <conv:StringEqualsToBoolConverter x:Key="StringEqualsToBoolConverter"/>
            <conv:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibilityConverter"/>

            <!-- 세그먼트형 라디오. ValveRoomView의 유형 선택과 같은 모양을 쓴다. -->
            <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="100"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#7F8C8D"/>
                <Setter Property="Tag" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="#FFFFFF" BorderBrush="#95A5A6" BorderThickness="1"
                                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#2196F3"/>
                                    <Setter Property="Foreground" Value="#2196F3"/>
                                    <Setter Property="Panel.ZIndex" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2196F3"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#2196F3"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Panel.ZIndex" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 권고안 입력칸. 사용자가 덮어쓰면 주황색으로 구분한다. -->
            <Style x:Key="RecommendationTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource PrimaryTextBoxStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEdited}" Value="True">
                        <Setter Property="Foreground" Value="#E67E22"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="#E67E22"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 섹션 카드 -->
            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#EEF2F7"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="SectionHeadStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#4A6FA5"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- 권고안 한 줄: 코드 | 항목명 | 입력칸 | 단위 -->
            <DataTemplate x:Key="ValueRowTemplate" DataType="{x:Type vm:DischargeBasinValueRow}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                            Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding CodeLabel}" Style="{StaticResource LabelTextBlockStyle}"
                               Width="50" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource LabelTextBlockStyle}"
                               Width="150" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <!-- Value는 double? 다. null이면 빈 칸으로 보이고(펌프장 제원 미입력 시),
                         사용자가 직접 고치면 Value setter가 오버라이드로 기록한다. -->
                    <TextBox Style="{StaticResource RecommendationTextBoxStyle}"
                             Tag="{Binding Key}"
                             Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                             Width="100" Height="25" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Unit}" Style="{StaticResource LabelTextBlockStyle}"
                               Width="30" VerticalAlignment="Center"/>
                    <!-- 산식근거에 확인 필요(⚠)가 붙은 항목 표시 -->
                    <Border Background="#FDE8D5" CornerRadius="8" Padding="6,1" VerticalAlignment="Center"
                            Visibility="{Binding NeedsReview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="확인" FontSize="10" Foreground="#E67E22"/>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- 힌트 패널 -->
            <Style x:Key="HintCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#EEF2F7"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="15"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="MinWidth" Value="240"/>
            </Style>

            <!-- 힌트 내용. 항목에 포커스가 가면 기호·수식·산식근거를 띄운다. -->
            <DataTemplate x:Key="HintTemplate">
                <StackPanel Width="230">
                    <TextBlock FontSize="11" Foreground="#999" TextAlignment="Center" Margin="0,20,0,0"
                               Text="항목을 선택하면&#x0a;설명이 표시됩니다.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HintTitle}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HintTitle}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding HintTitle}" FontWeight="SemiBold" Foreground="#2C5F9E"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Separator Background="#C5D3E0" Height="1" Margin="0,0,0,8"/>
                        <Border Background="White" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HintFormula}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding HintFormula}" FontFamily="Consolas" FontSize="11"
                                       Foreground="#1B5E20" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Text="{Binding HintDescription}" FontSize="11" Foreground="#444"
                                   TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#DDE4EB" Opacity="0.3"/>
        </Border.Effect>

        <TabControl Style="{StaticResource PrimaryTabControlStyle}" Margin="20">

            <!--═══ 설계조건 ═══-->
            <TabItem Header="설계조건" Style="{StaticResource PrimaryTabItemStyle}">
                <Grid GotFocus="OnParameterFocused" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                        <StackPanel Width="410">

                            <!-- 유형 -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="토출조 유형" Style="{StaticResource SectionHeadStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="토출 위치" Style="{StaticResource LabelTextBlockStyle}"
                                                   Width="80" VerticalAlignment="Center"/>
                                        <RadioButton Content="좌우측 토출" GroupName="BasinPosition" Tag="6,0,0,6"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     IsChecked="{Binding SelectedPosition, Mode=TwoWay,
                                                                 Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=좌우측 토출}"/>
                                        <RadioButton Content="중앙부 토출" GroupName="BasinPosition" Tag="0,6,6,0" Margin="-1,0,0,0"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     IsChecked="{Binding SelectedPosition, Mode=TwoWay,
                                                                 Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=중앙부 토출}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="단차" Style="{StaticResource LabelTextBlockStyle}"
                                                   Width="80" VerticalAlignment="Center"/>
                                        <RadioButton Content="단차 미적용" GroupName="BasinStep" Tag="6,0,0,6"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     IsChecked="{Binding SelectedStep, Mode=TwoWay,
                                                                 Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=단차 미적용}"/>
                                        <RadioButton Content="단차 적용" GroupName="BasinStep" Tag="0,6,6,0" Margin="-1,0,0,0"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     IsChecked="{Binding SelectedStep, Mode=TwoWay,
                                                                 Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=단차 적용}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 토출관로 -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="토출관로" Style="{StaticResource SectionHeadStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="형식" Style="{StaticResource LabelTextBlockStyle}"
                                                   Width="80" VerticalAlignment="Center"/>
                                        <RadioButton Content="암거" GroupName="BasinConduit" Tag="6,0,0,6"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     IsChecked="{Binding SelectedConduit, Mode=TwoWay,
                                                                 Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=암거}"/>
                                        <RadioButton Content="PIPE" GroupName="BasinConduit" Tag="0,6,6,0" Margin="-1,0,0,0"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     IsChecked="{Binding SelectedConduit, Mode=TwoWay,
                                                                 Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=PIPE}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="ON:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Text="토출관로 련수" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Tag="ON" Text="{Binding ON}"
                                                 Width="100" Height="25" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="련" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                                Visibility="{Binding SelectedConduit, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=암거}">
                                        <TextBlock Text="OB:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Text="토출암거 폭" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Tag="OB" Text="{Binding OB}"
                                                 Width="100" Height="25" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                                Visibility="{Binding SelectedConduit, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=암거}">
                                        <TextBlock Text="OH:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Text="토출암거 높이" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Tag="OH" Text="{Binding OH}"
                                                 Width="100" Height="25" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding SelectedConduit, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=PIPE}">
                                        <TextBlock Text="OD:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Text="토출관 직경" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Tag="OD" Text="{Binding OD}"
                                                 Width="100" Height="25" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 토출조 조건 -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="토출조 조건" Style="{StaticResource SectionHeadStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="TA:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Text="H.W.L (EL)" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Tag="TA" Text="{Binding TA}"
                                                 Width="100" Height="25" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="m" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Text="펌프장과 이격거리" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Tag="Separation" Text="{Binding Separation}"
                                                 Width="100" Height="25" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="m" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                        <!-- 제원 수식에는 안 쓰이지만 배치 기준이다(확인필요사항 B-1 해소) -->
                                        <Border Background="#E3F0E8" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="배치 기준" FontSize="10" Foreground="#2E7D52"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 펌프장 연동 -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="펌프장 연동" Style="{StaticResource SectionHeadStyle}" Margin="0"/>
                                        <TextBlock Text=" — 펌프장 탭에서 자동 연동 · 읽기전용" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="D:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Text="펌프 직경" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Tag="RefD" IsReadOnly="True" Background="#EDF1F5" Foreground="#7F8C8D"
                                                 Text="{Binding RefD, Mode=OneWay}" Width="100" Height="25" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="N:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Text="펌프 대수" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Tag="RefN" IsReadOnly="True" Background="#EDF1F5" Foreground="#7F8C8D"
                                                 Text="{Binding RefN, Mode=OneWay}" Width="100" Height="25" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="대" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Text="펌프장 HWL (EL)" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Tag="RefPumpHwl" IsReadOnly="True" Background="#EDF1F5" Foreground="#7F8C8D"
                                                 Text="{Binding RefPumpHwl, Mode=OneWay}" Width="100" Height="25" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="m" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="H3:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Text="펌프장 H3" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Tag="RefH3" IsReadOnly="True" Background="#EDF1F5" Foreground="#7F8C8D"
                                                 Text="{Binding RefH3, Mode=OneWay}" Width="100" Height="25" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="H7:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Text="펌프장 H7 (최소 토피)" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Tag="RefH7" IsReadOnly="True" Background="#EDF1F5" Foreground="#7F8C8D"
                                                 Text="{Binding RefH7, Mode=OneWay}" Width="100" Height="25" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="B8+T5:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Text="펌프 중심 간격" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Tag="RefB8PlusT5" IsReadOnly="True" Background="#EDF1F5" Foreground="#7F8C8D"
                                                 Text="{Binding RefB8PlusT5, Mode=OneWay}" Width="100" Height="25" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 입력 경고 (펌프장 제원 미비 · 퇴화한 제원) -->
                            <Border Background="#FDE8D5" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasValidationMessage}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ValidationMessage}" Foreground="#E67E22" TextWrapping="Wrap" FontSize="12"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                        <Image Source="{Binding PlanImagePath}" MaxWidth="720" Stretch="Uniform" HorizontalAlignment="Stretch"/>
                        <Image Source="{Binding ProfileImagePath}" MaxWidth="720" Stretch="Uniform" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource HintCardStyle}" Margin="10,0,0,0">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HintTemplate}"/>
                    </Border>
                </Grid>
            </TabItem>

            <!--═══ 종단제원 ═══-->
            <TabItem Header="종단제원" Style="{StaticResource PrimaryTabItemStyle}">
                <Grid GotFocus="OnParameterFocused" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                        <Border Style="{StaticResource SectionCardStyle}" Width="410">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="권고안으로 되돌리기"
                                            Command="{Binding RevertProfileCommand}"
                                            Style="{StaticResource CancelButtonStyle}" Height="24" Padding="10,0" FontSize="11"/>
                                    <TextBlock Text="종단 권고안" Style="{StaticResource SectionHeadStyle}" Margin="0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding ProfileRows}" ItemTemplate="{StaticResource ValueRowTemplate}"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                        <Image Source="{Binding ProfileImagePath}" MaxWidth="720" Stretch="Uniform" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource HintCardStyle}" Margin="10,0,0,0">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HintTemplate}"/>
                    </Border>
                </Grid>
            </TabItem>

            <!--═══ 평면제원 ═══-->
            <TabItem Header="평면제원" Style="{StaticResource PrimaryTabItemStyle}">
                <Grid GotFocus="OnParameterFocused" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                        <StackPanel Width="410">
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="권고안으로 되돌리기"
                                                Command="{Binding RevertPlanCommand}"
                                                Style="{StaticResource CancelButtonStyle}" Height="24" Padding="10,0" FontSize="11"/>
                                        <TextBlock Text="평면 권고안" Style="{StaticResource SectionHeadStyle}" Margin="0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding PlanRows}" ItemTemplate="{StaticResource ValueRowTemplate}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="상부 개구부" Style="{StaticResource SectionHeadStyle}"/>
                                    <ItemsControl ItemsSource="{Binding OpeningRows}" ItemTemplate="{StaticResource ValueRowTemplate}"/>
                                    <TextBlock Text="※ 펌프 N대 중 1개소만 TOB1 × TOL2, 나머지는 TOB1 × TOL1"
                                               FontSize="11" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                        <Image Source="{Binding PlanImagePath}" MaxWidth="720" Stretch="Uniform" HorizontalAlignment="Stretch"/>
                        <Image Source="{Binding OpeningImagePath}" MaxWidth="720" Stretch="Uniform" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource HintCardStyle}" Margin="10,0,0,0">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HintTemplate}"/>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Border>
</UserControl>
