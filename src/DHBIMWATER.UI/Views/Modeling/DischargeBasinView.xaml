<UserControl x:Class="DHBIMWATER.UI.Views.Modeling.DischargeBasinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:DHBIMWATER.UI.Converters"
             xmlns:vm="clr-namespace:DHBIMWATER.UI.ViewModels.Modeling"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DischargeBasinViewModel, IsDesignTimeCreatable=False}"
             FontFamily="Segoe UI, Malgun Gothic">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <conv:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibilityConverter"/>

            <!-- 도해 매개변수 강조. 검은 글자 대비가 높은 형광 연두. -->
            <SolidColorBrush x:Key="DiagramHighlightBrush" Color="#C6FF00"/>

            <!-- 접으면 도해 열이 줄고 안내 영역이 왼쪽으로 붙는다. -->
            <Style x:Key="DiagramColumnStyle" TargetType="ColumnDefinition">
                <Setter Property="Width" Value="1*"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDiagramExpanded}" Value="False">
                        <Setter Property="Width" Value="Auto"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 도해 영역 전체를 좌우로 접는 Expander. -->
            <Style x:Key="DiagramExpanderStyle" TargetType="Expander">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Left" Width="22" Margin="0,0,8,0" Focusable="False" Cursor="Hand"
                                              ToolTip="도해 접기·펼치기"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Strip" Background="#EEF2F7" CornerRadius="6">
                                                <Path x:Name="Arrow" Data="M0,0 L6,6 L0,12" Stroke="#4A6FA5" StrokeThickness="2"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Data" Value="M6,0 L0,6 L6,12"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Strip" Property="Background" Value="#DCE5EF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
                            </DockPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 섹션 카드. 펌프장 설계조건 이미지 카드와 같은 값. -->
            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#EEF2F7"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="SectionHeadStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#4A6FA5"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- 권고안 한 줄: 코드 | 항목명 | 입력칸 | 단위 -->
            <DataTemplate x:Key="ValueRowTemplate" DataType="{x:Type vm:DischargeBasinValueRow}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15"
                            Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding CodeLabel}" Style="{StaticResource LabelTextBlockStyle}"
                               Width="50" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource LabelTextBlockStyle}"
                               Width="150" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <!-- Value는 double? 다. null이면 빈 칸으로 보이고(펌프장 제원 미입력 시),
                         사용자가 직접 고치면 Value setter가 오버라이드로 기록한다. -->
                    <TextBox Style="{StaticResource PrimaryTextBoxStyle}"
                             Tag="{Binding Key}"
                             Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                             Width="100" Height="25" Margin="10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Unit}" Style="{StaticResource LabelTextBlockStyle}"
                               Width="30" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>

            <!-- 힌트 패널 -->
            <Style x:Key="HintCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#EEF2F7"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="15"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="MinWidth" Value="260"/>
            </Style>

            <!-- 힌트 내용. 항목에 포커스가 가면 기호·수식·산식근거를 띄운다. -->
            <DataTemplate x:Key="HintTemplate">
                <StackPanel Width="240">
                    <TextBlock FontSize="11" Foreground="#999" TextAlignment="Center" Margin="0,20,0,0"
                               Text="항목을 선택하면&#x0a;설명이 표시됩니다.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HintTitle}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HintTitle}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding HintTitle}" FontWeight="SemiBold" Foreground="#2C5F9E"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Separator Background="#C5D3E0" Height="1" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding HintDescription}" FontSize="11" Foreground="#444"
                                   TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="15" Margin="10,0,0,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#DDE4EB" Opacity="0.3"/>
        </Border.Effect>

        <TabControl Style="{StaticResource PrimaryTabControlStyle}" Margin="20">

            <!--═══ 설계조건 ═══-->
            <TabItem Header="설계조건" Style="{StaticResource PrimaryTabItemStyle}">
                <Grid GotFocus="OnParameterFocused" LostFocus="OnParameterLostFocus" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Style="{StaticResource DiagramColumnStyle}"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                        <StackPanel>

                            <!-- 유형. 라벨 폭 200 = 코드 50 + 항목명 150, 아래 입력칸과 열 맞춤. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="토출 위치" Style="{StaticResource LabelTextBlockStyle}"
                                           Width="200" VerticalAlignment="Center"/>
                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}"
                                          Width="100" Margin="10,0"
                                          ItemsSource="{Binding Positions}"
                                          SelectedItem="{Binding SelectedPosition}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="단차" Style="{StaticResource LabelTextBlockStyle}"
                                           Width="200" VerticalAlignment="Center"/>
                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}"
                                          Width="100" Margin="10,0"
                                          ItemsSource="{Binding Steps}"
                                          SelectedItem="{Binding SelectedStep}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="토출관로 형식" Style="{StaticResource LabelTextBlockStyle}"
                                           Width="200" VerticalAlignment="Center"/>
                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}"
                                          Width="100" Margin="10,0,0,5"
                                          ItemsSource="{Binding Conduits}"
                                          SelectedItem="{Binding SelectedConduit}"/>
                            </StackPanel>
                            <Separator Margin="0,0,0,10"/>

                            <!-- 토출관로 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15"
                                        Visibility="{Binding SelectedConduit, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=암거}">
                                <TextBlock Text="OB:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                <TextBlock Text="토출암거 폭" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Tag="OB" Text="{Binding OB}"
                                         Width="100" Height="25" Margin="10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                <ContentControl Style="{StaticResource HelpIconStyle}" Tag="{Binding InputHintTexts[OB]}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15"
                                        Visibility="{Binding SelectedConduit, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=PIPE}">
                                <TextBlock Text="OD:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                <TextBlock Text="토출관 직경" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Tag="OD" Text="{Binding OD}"
                                         Width="100" Height="25" Margin="10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                <ContentControl Style="{StaticResource HelpIconStyle}" Tag="{Binding InputHintTexts[OD]}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15"
                                        Visibility="{Binding SelectedConduit, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=암거}">
                                <TextBlock Text="OH:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                <TextBlock Text="토출암거 높이" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Tag="OH" Text="{Binding OH}"
                                         Width="100" Height="25" Margin="10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                <ContentControl Style="{StaticResource HelpIconStyle}" Tag="{Binding InputHintTexts[OH]}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="ON:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                <TextBlock Text="토출관로 련수" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Tag="ON" Text="{Binding ON}"
                                         Width="100" Height="25" Margin="10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="련" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                <ContentControl Style="{StaticResource HelpIconStyle}" Tag="{Binding InputHintTexts[ON]}"/>
                            </StackPanel>

                            <!-- 토출조 조건 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="TA:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                <TextBlock Text="H.W.L (EL)" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Tag="TA" Text="{Binding TA}"
                                         Width="100" Height="25" Margin="10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="m" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                <ContentControl Style="{StaticResource HelpIconStyle}" Tag="{Binding InputHintTexts[TA]}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                <TextBlock Text="펌프장과 이격거리" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource ReservoirTextBoxStyle}" Tag="Separation" Text="{Binding Separation}"
                                         Width="100" Height="25" Margin="10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="m" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                <!-- 제원 수식에는 안 쓰이지만 배치 기준이다(확인필요사항 B-1 해소) -->
                                <Border Background="#E3F0E8" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="배치 기준" FontSize="10" Foreground="#2E7D52"/>
                                </Border>
                                <ContentControl Style="{StaticResource HelpIconStyle}" Tag="{Binding InputHintTexts[Separation]}"/>
                            </StackPanel>

                            <!-- 입력 경고 (펌프장 제원 미비 · 퇴화한 제원). 접힌 영역 밖 고정. -->
                            <Border Background="#FDE8D5" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasValidationMessage}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ValidationMessage}" Foreground="#E67E22" TextWrapping="Wrap" FontSize="12"/>
                            </Border>

                            <!-- 펌프장 연동. 읽기전용 자동값이라 상세 설정에 둠. -->
                            <Expander Style="{StaticResource PrimaryExpanderStyle}" ExpandDirection="Down">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="상세 설정"/>
                                    </StackPanel>
                                </Expander.Header>

                                <StackPanel>
                                    <TextBlock Text="펌프장 탭에서 자동 연동 · 읽기전용" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,10"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="B8+T5:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Text="펌프 중심 간격" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Tag="RefB8PlusT5" IsReadOnly="True" Background="#EDF1F5" Foreground="#7F8C8D"
                                                 Text="{Binding RefB8PlusT5, Mode=OneWay}" Width="100" Height="25" Margin="10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                        <ContentControl Style="{StaticResource HelpIconStyle}" Tag="{Binding InputHintTexts[RefB8PlusT5]}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="D:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Text="펌프 직경" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Tag="RefD" IsReadOnly="True" Background="#EDF1F5" Foreground="#7F8C8D"
                                                 Text="{Binding RefD, Mode=OneWay}" Width="100" Height="25" Margin="10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                        <ContentControl Style="{StaticResource HelpIconStyle}" Tag="{Binding InputHintTexts[RefD]}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="H3:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Text="펌프장 H3" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Tag="RefH3" IsReadOnly="True" Background="#EDF1F5" Foreground="#7F8C8D"
                                                 Text="{Binding RefH3, Mode=OneWay}" Width="100" Height="25" Margin="10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                        <ContentControl Style="{StaticResource HelpIconStyle}" Tag="{Binding InputHintTexts[RefH3]}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="H7:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Text="펌프장 H7 (최소 토피)" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Tag="RefH7" IsReadOnly="True" Background="#EDF1F5" Foreground="#7F8C8D"
                                                 Text="{Binding RefH7, Mode=OneWay}" Width="100" Height="25" Margin="10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="mm" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                        <ContentControl Style="{StaticResource HelpIconStyle}" Tag="{Binding InputHintTexts[RefH7]}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="N:" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Text="펌프 대수" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Tag="RefN" IsReadOnly="True" Background="#EDF1F5" Foreground="#7F8C8D"
                                                 Text="{Binding RefN, Mode=OneWay}" Width="100" Height="25" Margin="10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="대" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                        <ContentControl Style="{StaticResource HelpIconStyle}" Tag="{Binding InputHintTexts[RefN]}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="" Style="{StaticResource LabelTextBlockStyle}" Width="50" VerticalAlignment="Center"/>
                                        <TextBlock Text="펌프장 HWL (EL)" Style="{StaticResource LabelTextBlockStyle}" Width="150" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Tag="RefPumpHwl" IsReadOnly="True" Background="#EDF1F5" Foreground="#7F8C8D"
                                                 Text="{Binding RefPumpHwl, Mode=OneWay}" Width="100" Height="25" Margin="10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="m" Style="{StaticResource LabelTextBlockStyle}" Width="30" VerticalAlignment="Center"/>
                                        <ContentControl Style="{StaticResource HelpIconStyle}" Tag="{Binding InputHintTexts[RefPumpHwl]}"/>
                                    </StackPanel>

                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <Expander Grid.Column="1" Margin="20,0,0,0" Style="{StaticResource DiagramExpanderStyle}" IsExpanded="{Binding IsDiagramExpanded}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1000*"/>
                                <RowDefinition Height="1030*"/>
                            </Grid.RowDefinitions>
                            <Viewbox Grid.Row="0" MaxWidth="900" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality">
                                <Grid Width="1800" Background="White">
                                    <Path Data="{Binding PlanHighlightGeometry}" Fill="{StaticResource DiagramHighlightBrush}" IsHitTestVisible="False"/>
                                    <Image Source="{Binding PlanImagePath}" Stretch="Uniform" VerticalAlignment="Top"/>
                                </Grid>
                            </Viewbox>
                            <Viewbox Grid.Row="1" MaxWidth="900" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality">
                                <Grid Width="1800" Background="White">
                                    <Path Data="{Binding ProfileHighlightGeometry}" Fill="{StaticResource DiagramHighlightBrush}" IsHitTestVisible="False"/>
                                    <Image Source="{Binding ProfileImagePath}" Stretch="Uniform" VerticalAlignment="Top"/>
                                </Grid>
                            </Viewbox>
                        </Grid>
                    </Expander>
                </Grid>
            </TabItem>

            <!--═══ 종단제원 ═══-->
            <TabItem Header="종단제원" Style="{StaticResource PrimaryTabItemStyle}">
                <Grid GotFocus="OnParameterFocused" LostFocus="OnParameterLostFocus" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Style="{StaticResource DiagramColumnStyle}"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                        <StackPanel>
                            <!-- 되돌리기는 접힌 상태에서도 쓰게 Expander 밖에 둠. -->
                            <Button Content="권고안으로 되돌리기" HorizontalAlignment="Right" Margin="0,0,0,10"
                                    Command="{Binding RevertProfileCommand}"
                                    Style="{StaticResource CancelButtonStyle}" Height="24" Padding="10,0" FontSize="11"/>
                            <ItemsControl ItemsSource="{Binding PrimaryProfileRows}" ItemTemplate="{StaticResource ValueRowTemplate}"/>

                            <Expander Style="{StaticResource PrimaryExpanderStyle}" ExpandDirection="Down">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="상세 설정"/>
                                    </StackPanel>
                                </Expander.Header>

                                <ItemsControl ItemsSource="{Binding DetailProfileRows}" ItemTemplate="{StaticResource ValueRowTemplate}"/>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <Expander Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource DiagramExpanderStyle}" IsExpanded="{Binding IsDiagramExpanded}">
                        <Viewbox Grid.Row="0" MaxWidth="900" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality">
                            <Grid Width="1800" Background="White">
                                <Path Data="{Binding ProfileHighlightGeometry}" Fill="{StaticResource DiagramHighlightBrush}" IsHitTestVisible="False"/>
                                <Image Source="{Binding ProfileImagePath}" Stretch="Uniform" VerticalAlignment="Top"/>
                            </Grid>
                        </Viewbox>
                    </Expander>

                    <Border Grid.Column="2" Style="{StaticResource HintCardStyle}" Margin="10,0,0,0">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HintTemplate}"/>
                    </Border>
                </Grid>
            </TabItem>

            <!--═══ 평면제원 ═══-->
            <TabItem Header="평면제원" Style="{StaticResource PrimaryTabItemStyle}">
                <Grid GotFocus="OnParameterFocused" LostFocus="OnParameterLostFocus" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Style="{StaticResource DiagramColumnStyle}"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                        <StackPanel>
                            <!-- 되돌리기는 접힌 상태에서도 쓰게 Expander 밖에 둠. -->
                            <Button Content="권고안으로 되돌리기" HorizontalAlignment="Right" Margin="0,0,0,10"
                                    Command="{Binding RevertPlanCommand}"
                                    Style="{StaticResource CancelButtonStyle}" Height="24" Padding="10,0" FontSize="11"/>
                            <ItemsControl ItemsSource="{Binding PrimaryPlanRows}" ItemTemplate="{StaticResource ValueRowTemplate}"/>

                            <Expander Style="{StaticResource PrimaryExpanderStyle}" ExpandDirection="Down">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="상세 설정"/>
                                    </StackPanel>
                                </Expander.Header>

                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding DetailPlanRows}" ItemTemplate="{StaticResource ValueRowTemplate}"/>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="상부 개구부" Style="{StaticResource SectionHeadStyle}"/><ContentControl Style="{StaticResource HelpIconStyle}" VerticalAlignment="Top" Tag="펌프 N대 중 1개소만 TOB1 × TOL2, 나머지는 TOB1 × TOL1"/></StackPanel>
                                    <ItemsControl ItemsSource="{Binding OpeningRows}" ItemTemplate="{StaticResource ValueRowTemplate}"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <Expander Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource DiagramExpanderStyle}" IsExpanded="{Binding IsDiagramExpanded}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1000*"/>
                                <RowDefinition Height="560*"/>
                            </Grid.RowDefinitions>
                            <Viewbox Grid.Row="0" MaxWidth="900" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality">
                                <Grid Width="1800" Background="White">
                                    <Path Data="{Binding PlanHighlightGeometry}" Fill="{StaticResource DiagramHighlightBrush}" IsHitTestVisible="False"/>
                                    <Image Source="{Binding PlanImagePath}" Stretch="Uniform" VerticalAlignment="Top"/>
                                </Grid>
                            </Viewbox>
                            <Viewbox Grid.Row="1" MaxWidth="900" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality">
                                <Grid Width="1800" Background="White">
                                    <Path Data="{Binding OpeningHighlightGeometry}" Fill="{StaticResource DiagramHighlightBrush}" IsHitTestVisible="False"/>
                                    <Image Source="{Binding OpeningImagePath}" Stretch="Uniform" VerticalAlignment="Top"/>
                                </Grid>
                            </Viewbox>
                        </Grid>
                    </Expander>

                    <Border Grid.Column="2" Style="{StaticResource HintCardStyle}" Margin="10,0,0,0">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HintTemplate}"/>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Border>
</UserControl>
