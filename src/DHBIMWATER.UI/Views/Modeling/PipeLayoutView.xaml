<Window x:Class="DHBIMWATER.UI.Views.Modeling.PipeLayoutView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls"
        xmlns:converters="clr-namespace:DHBIMWATER.UI.Converters"
        xmlns:vm="clr-namespace:DHBIMWATER.UI.ViewModels.Modeling"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PipeLayoutViewModel}"
        Title="DHBIMWATER - Pipe Layout" Width="1180" Height="720" WindowStartupLocation="CenterScreen"
        Background="#F4F7F9" WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic" PreviewKeyDown="OnPreviewKeyDown" Validation.Error="OnValidationError">
    <Window.Resources><ResourceDictionary><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/><converters:FamilyTypeNameToTypeNameConverter x:Key="FamilyTypeNameToTypeNameConverter"/><SolidColorBrush x:Key="PipeErrorBrush" Color="#E74C3C"/><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <controls:TitleBar Grid.Row="0"/>
        <Grid Grid.Row="1" Margin="20,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="12" Padding="8" Margin="0,0,12,0"><Grid>
                <Canvas x:Name="LayoutCanvas" Background="#FCFDFE" Focusable="True" Cursor="None"
                        ClipToBounds="True"
                        MouseLeftButtonDown="OnCanvasMouseLeftButtonDown" MouseMove="OnCanvasMouseMove" MouseLeave="OnCanvasMouseLeave"
                        MouseWheel="OnCanvasMouseWheel" MouseDown="OnCanvasMouseDown" MouseUp="OnCanvasMouseUp"
                        SizeChanged="OnLayoutCanvasSizeChanged">
                    <Line X1="{Binding ReferenceScreenX}" Y1="0" X2="{Binding ReferenceScreenX}" Y2="{Binding ActualHeight, ElementName=LayoutCanvas}" Stroke="#9ACD32" StrokeThickness="1.5" StrokeDashArray="4,3" IsHitTestVisible="False"/>
                    <Line X1="0" Y1="{Binding ReferenceScreenY}" X2="{Binding ActualWidth, ElementName=LayoutCanvas}" Y2="{Binding ReferenceScreenY}" Stroke="#9ACD32" StrokeThickness="1.5" StrokeDashArray="4,3" IsHitTestVisible="False"/>
                    <!-- 외곽 레이아웃: 내측면(진한 실선)이 기준면, 외측면(연한 선)은 벽 두께 표현 -->
                    <ItemsControl ItemsSource="{Binding OutlineWalls}" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Canvas>
                        <Line X1="{Binding OuterX1}" Y1="{Binding OuterY1}" X2="{Binding OuterX2}" Y2="{Binding OuterY2}" Stroke="#C3CFD9" StrokeThickness="1"/>
                        <Line X1="{Binding InnerX1}" Y1="{Binding InnerY1}" X2="{Binding OuterX1}" Y2="{Binding OuterY1}" Stroke="#C3CFD9" StrokeThickness="1"/>
                        <Line X1="{Binding InnerX2}" Y1="{Binding InnerY2}" X2="{Binding OuterX2}" Y2="{Binding OuterY2}" Stroke="#C3CFD9" StrokeThickness="1"/>
                        <Line X1="{Binding InnerX1}" Y1="{Binding InnerY1}" X2="{Binding InnerX2}" Y2="{Binding InnerY2}" Stroke="#5D6D7E" StrokeThickness="2.5"/>
                    </Canvas></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <!-- 기둥(docs/184, docs/189): 간섭 확인용 참조물. 본체는 실선, 헌치 등 덧단면은 점선. 채움을 없애 겹쳐도 두 선이 모두 보인다 -->
                    <ItemsControl ItemsSource="{Binding OutlineColumns}" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                        <!-- StrokeThickness를 요소에 직접 주면 Style 트리거보다 우선해 덮인다 — 반드시 Setter로만 준다 -->
                        <Polygon Points="{Binding Points}" Fill="{x:Null}" Stroke="#5D6D7E">
                            <Polygon.Style>
                                <Style TargetType="Polygon">
                                    <Setter Property="StrokeThickness" Value="2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCore}" Value="False">
                                            <Setter Property="StrokeThickness" Value="1.2"/>
                                            <Setter Property="StrokeDashArray" Value="3,2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Polygon.Style>
                        </Polygon>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <!-- IN/OUT 화살표: 좌·우 내측면 고정, 상하 위치만 사용자 지정 -->
                    <ItemsControl ItemsSource="{Binding OutlineArrows}" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Canvas>
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{Binding Color}" StrokeThickness="2.5"/>
                        <Polygon Points="{Binding HeadPoints}" Fill="{Binding Color}"/>
                        <TextBlock Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}" Text="{Binding Label}" FontSize="11" FontWeight="Bold" Foreground="{Binding Color}"/>
                    </Canvas></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <!-- 임시치수: 커서에서 X·Y 각 방향으로 가장 가까운 외곽선까지 -->
                    <ItemsControl ItemsSource="{Binding TempDimensions, Mode=OneWay}" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Canvas>
                        <Line X1="{Binding X1, Mode=OneWay}" Y1="{Binding Y1, Mode=OneWay}" X2="{Binding X2, Mode=OneWay}" Y2="{Binding Y2, Mode=OneWay}" Stroke="{Binding Stroke, Mode=OneWay}" StrokeThickness="1" StrokeDashArray="3,2"/>
                        <TextBlock Canvas.Left="{Binding LabelX, Mode=OneWay}" Canvas.Top="{Binding LabelY, Mode=OneWay}" Text="{Binding Label, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Background="Transparent">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="2,-16,0,0"/>
                                    <Setter Property="Foreground" Value="#6C3483"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSubLine, Mode=OneWay}" Value="True">
                                            <Setter Property="Margin" Value="2,-30,0,0"/>
                                            <Setter Property="Foreground" Value="#A569BD"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Canvas></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <!-- 스냅 표식은 노드·엣지 위에서 잡히므로, 선언 순서(z-order)로는 뒤에 오는 Edges/InlineFittings/Nodes에 가려진다.
                         Canvas의 다른 자식은 모두 기본 ZIndex(0)이므로 여기만 올려서 항상 최상단에 그린다. -->
                    <Grid Panel.ZIndex="1000" Canvas.Left="{Binding SnapMarkerX}" Canvas.Top="{Binding SnapMarkerY}" Margin="-16,-16,0,0" Width="32" Height="32" IsHitTestVisible="False" Visibility="{Binding IsSnapMarkerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas.Style><Style TargetType="Canvas"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SnapMarkerSymbol}" Value="+"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Canvas.Style>
                            <Line X1="8" Y1="1" X2="8" Y2="15" Stroke="#00A651" StrokeThickness="2"/>
                            <Line X1="1" Y1="8" X2="15" Y2="8" Stroke="#00A651" StrokeThickness="2"/>
                        </Canvas>
                        <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas.Style><Style TargetType="Canvas"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SnapMarkerSymbol}" Value="×"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Canvas.Style>
                            <Line X1="2" Y1="2" X2="14" Y2="14" Stroke="#00A651" StrokeThickness="2"/>
                            <Line X1="14" Y1="2" X2="2" Y2="14" Stroke="#00A651" StrokeThickness="2"/>
                        </Canvas>
                        <Rectangle Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#00A651" StrokeThickness="2.5" Fill="Transparent">
                            <Rectangle.Style><Style TargetType="Rectangle"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SnapMarkerSymbol}" Value="□"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Rectangle.Style>
                        </Rectangle>
                        <Polygon Points="8,1 15,15 1,15" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#00A651" StrokeThickness="2" Fill="Transparent">
                            <Polygon.Style><Style TargetType="Polygon"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SnapMarkerSymbol}" Value="△"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Polygon.Style>
                        </Polygon>
                        <Polygon Points="8,0 16,8 8,16 0,8" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#00A651" StrokeThickness="2" Fill="Transparent">
                            <Polygon.Style><Style TargetType="Polygon"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SnapMarkerSymbol}" Value="◇"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Polygon.Style>
                        </Polygon>
                        <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas.Style><Style TargetType="Canvas"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SnapMarkerSymbol}" Value="⊥"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Canvas.Style>
                            <Line X1="2" Y1="13" X2="14" Y2="13" Stroke="#00A651" StrokeThickness="2"/>
                            <Line X1="8" Y1="1" X2="8" Y2="13" Stroke="#00A651" StrokeThickness="2"/>
                        </Canvas>
                        <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#00A651">
                            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SnapMarkerSymbol}" Value="·"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <TextBlock Panel.ZIndex="1000" Canvas.Left="{Binding SnapMarkerX, Mode=OneWay}" Canvas.Top="{Binding SnapMarkerY, Mode=OneWay}"
                               Margin="14,4,0,0" Text="{Binding SnapMarkerLabel, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"
                               Foreground="#00733B" Background="#F2FBF6" IsHitTestVisible="False"
                               Visibility="{Binding IsSnapMarkerVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- CAD식 십자선 커서: 시스템 커서(Cursor="None") 대신 직접 그린다.
                         스냅이 잡히면 CursorX/Y에 스냅 좌표가 들어오므로 십자선이 그 점에 달라붙는다(자석).
                         십자선 40px와 픽박스 12px는 화면 고정 크기이며 스냅 허용오차(모델 100mm)와는 무관하다. -->
                    <Grid Panel.ZIndex="900" Canvas.Left="{Binding CursorX, Mode=OneWay}" Canvas.Top="{Binding CursorY, Mode=OneWay}"
                          Margin="-20,-20,0,0" Width="40" Height="40" IsHitTestVisible="False"
                          Visibility="{Binding IsCursorVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Line X1="20" Y1="0" X2="20" Y2="40" Stroke="#7F8C8D" StrokeThickness="1"/>
                        <Line X1="0" Y1="20" X2="40" Y2="20" Stroke="#7F8C8D" StrokeThickness="1"/>
                        <Rectangle Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Stroke="#34495E" StrokeThickness="1" Fill="Transparent"
                                   Visibility="{Binding IsSelectionMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                    <!-- SubLine: 그리는 중에만, 중심선에서 관 반경(DiameterMm/2)만큼 떨어진 관 외곽선 -->
                    <Line X1="{Binding SubLineAX1, Mode=OneWay}" Y1="{Binding SubLineAY1, Mode=OneWay}" X2="{Binding SubLineAX2, Mode=OneWay}" Y2="{Binding SubLineAY2, Mode=OneWay}"
                          Stroke="#F5B041" StrokeThickness="1" StrokeDashArray="4,3" IsHitTestVisible="False"
                          Visibility="{Binding IsSubLineVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Line X1="{Binding SubLineBX1, Mode=OneWay}" Y1="{Binding SubLineBY1, Mode=OneWay}" X2="{Binding SubLineBX2, Mode=OneWay}" Y2="{Binding SubLineBY2, Mode=OneWay}"
                          Stroke="#F5B041" StrokeThickness="1" StrokeDashArray="4,3" IsHitTestVisible="False"
                          Visibility="{Binding IsSubLineVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- 정척 수직보조선(docs/245): 선 시작점부터 정척 길이마다 SubLine A–B를 잇는다. 참고용 — 부속 폭 미반영 -->
                    <Path Data="{Binding SubLineTicks, Mode=OneWay}" Stroke="#F5B041" StrokeThickness="1" IsHitTestVisible="False"
                          Visibility="{Binding IsSubLineVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Line X1="{Binding PreviewX1}" Y1="{Binding PreviewY1}" X2="{Binding PreviewX2}" Y2="{Binding PreviewY2}" Stroke="#E67E22" StrokeThickness="3" StrokeDashArray="6,3" IsHitTestVisible="False" Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- 분할 표식: [선 분할] 중 커서가 올라탄 지점에서 선에 수직하게 긋는 짧은 선분(docs/181 § A).
                         선·절점 위에 얹혀야 어디가 잘리는지 보이므로 ZIndex를 올린다(스냅 표식 1000보다는 아래). -->
                    <Line Panel.ZIndex="950" X1="{Binding SplitMarkerX1, Mode=OneWay}" Y1="{Binding SplitMarkerY1, Mode=OneWay}"
                          X2="{Binding SplitMarkerX2, Mode=OneWay}" Y2="{Binding SplitMarkerY2, Mode=OneWay}"
                          Stroke="#E74C3C" StrokeThickness="2.5" IsHitTestVisible="False"
                          Visibility="{Binding IsSplitMarkerVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Canvas.Left="{Binding PreviewLengthX}" Canvas.Top="{Binding PreviewLengthY}" Margin="4,-20,0,0" Text="{Binding PreviewLength}" FontSize="11" FontWeight="SemiBold" Foreground="#D35400" Background="#FFFCF8" IsHitTestVisible="False" Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Canvas.Left="{Binding PreviewLengthX, Mode=OneWay}" Canvas.Top="{Binding PreviewLengthY, Mode=OneWay}" Margin="4,-6,0,0"
                               Text="{Binding PreviewAngle, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#D35400" Background="#FFFCF8"
                               IsHitTestVisible="False" Visibility="{Binding IsPreviewVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- 부속 배치 미리보기: 리스트에서 패밀리를 고르면 커서가 붙는 선 위 지점에 도형 + 시작점부터의 임시치수를 보여준다 -->
                    <Line X1="{Binding FittingDimX1}" Y1="{Binding FittingDimY1}" X2="{Binding FittingDimX2}" Y2="{Binding FittingDimY2}" Stroke="#F39C12" StrokeThickness="1" StrokeDashArray="3,2" IsHitTestVisible="False" Visibility="{Binding IsFittingPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Canvas.Left="{Binding FittingPreviewX}" Canvas.Top="{Binding FittingPreviewY}" Margin="8,-18,0,0" Text="{Binding FittingDimLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#B9770E" Background="#FEF9E7" IsHitTestVisible="False" Visibility="{Binding IsFittingPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- docs/228 § B — 바이패스 세트 미리보기(개략). 실제 치수는 Revit이 패밀리를 재서 정한다. -->
                    <Path Data="{Binding BypassPreviewLine, Mode=OneWay}" Stroke="#283593" StrokeThickness="2.5" StrokeDashArray="5,3" Opacity="0.7" IsHitTestVisible="False" Visibility="{Binding IsBypassPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Path Data="{Binding BypassPreviewMarkers, Mode=OneWay}" Fill="#283593" Stroke="White" StrokeThickness="1" Opacity="0.7" IsHitTestVisible="False" Visibility="{Binding IsBypassPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Grid Canvas.Left="{Binding FittingPreviewX}" Canvas.Top="{Binding FittingPreviewY}" Width="18" Height="18" Margin="-9,-9,0,0" IsHitTestVisible="False" Visibility="{Binding IsFittingPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Polygon Points="9,1 17,9 9,17 1,9" Fill="#D81B60" Stroke="White" StrokeThickness="1.5"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Edges}" IsHitTestVisible="True"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Canvas>
                        <Line X1="{Binding SubAX1, Mode=OneWay}" Y1="{Binding SubAY1, Mode=OneWay}" X2="{Binding SubAX2, Mode=OneWay}" Y2="{Binding SubAY2, Mode=OneWay}" Stroke="#F5B041" StrokeThickness="1" Opacity="0.35" IsHitTestVisible="False"/>
                        <Line X1="{Binding SubBX1, Mode=OneWay}" Y1="{Binding SubBY1, Mode=OneWay}" X2="{Binding SubBX2, Mode=OneWay}" Y2="{Binding SubBY2, Mode=OneWay}" Stroke="#F5B041" StrokeThickness="1" Opacity="0.35" IsHitTestVisible="False"/>
                        <Path Data="{Binding StraightTicks, Mode=OneWay}" Stroke="#F5B041" StrokeThickness="1" Opacity="0.35" IsHitTestVisible="False"/>
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" MouseLeftButtonDown="OnEdgeMouseLeftButtonDown"><Line.Style><!-- Stroke/StrokeThickness를 로컬 속성으로 두면 아래 트리거가 먹지 않는다(XAML:47 주석 참조). --><Style TargetType="Line"><Setter Property="Stroke" Value="{Binding Stroke}"/><Setter Property="StrokeThickness" Value="4"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/><Condition Binding="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding IsSelected}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Stroke" Value="#5DADE2"/><Setter Property="StrokeThickness" Value="6"/></MultiDataTrigger></Style.Triggers></Style></Line.Style></Line>
                        <TextBlock Canvas.Left="{Binding LengthX}" Canvas.Top="{Binding LengthY}" Margin="4,-20,0,0" Text="{Binding LengthLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#1B4F72" Background="#F8FBFD" IsHitTestVisible="False"/>
                        <TextBlock Canvas.Left="{Binding LengthX}" Canvas.Top="{Binding LengthY}" Margin="4,-8,0,0" Text="{Binding DiameterLabel, Mode=OneWay}" FontSize="10" Foreground="#5D6D7E" Background="#F8FBFD" IsHitTestVisible="False"/>
                    </Canvas></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <!-- 배치된 배관 밸브류는 P&ID 관습적 다이아몬드로 표시한다. -->
                    <!-- ItemsControl은 각 항목을 ContentPresenter로 감싸므로 DataTemplate 루트의 Canvas.Left/Top은 무시된다
                         (전 항목이 (0,0)에 겹친다). 위 Edges 템플릿과 같이 루트를 Canvas로 감싸 절대 위치를 살린다. -->
                    <ItemsControl ItemsSource="{Binding InlineFittings}" IsHitTestVisible="{Binding IsSelectionMode}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Canvas>
                        <!-- docs/228 § B — 바이패스 세트 개략 그림(A 사각형 · B 원 · 바이패스 밸브 다이아몬드). 본관 밸브는 아래 기존 다이아몬드다. -->
                        <Path Data="{Binding BypassLine, Mode=OneWay}" Stroke="{Binding BypassStroke, Mode=OneWay}" StrokeThickness="2.5" MouseLeftButtonDown="OnFittingMouseLeftButtonDown"/>
                        <Path Data="{Binding BypassMarkers, Mode=OneWay}" Fill="{Binding BypassFill, Mode=OneWay}" Stroke="White" StrokeThickness="1" MouseLeftButtonDown="OnFittingMouseLeftButtonDown"/>
                        <StackPanel Canvas.Left="{Binding X, Mode=OneWay}" Canvas.Top="{Binding Y, Mode=OneWay}" Width="120" Margin="-60,-7,0,0">
                            <Grid Width="14" Height="14" HorizontalAlignment="Center" ToolTip="{Binding FamilyTypeName, Mode=OneWay}" MouseLeftButtonDown="OnFittingMouseLeftButtonDown">
                                <Polygon Points="7,0 14,7 7,14 0,7" Stroke="White" StrokeThickness="1"><Polygon.Style><Style TargetType="Polygon"><Setter Property="Fill" Value="{Binding Fill, Mode=OneWay}"/><Style.Triggers><!-- 부속 ItemsControl은 선택 모드에서만 hit test가 켜지므로 모드 조건이 따로 필요 없다. --><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True"/><Condition Binding="{Binding IsSelected, Mode=OneWay}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Fill" Value="#F8C471"/></MultiDataTrigger></Style.Triggers></Style></Polygon.Style></Polygon>
                            </Grid>
                            <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontSize="10" Foreground="#34495E" HorizontalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False"/>
                        </StackPanel>
                    </Canvas></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <ItemsControl ItemsSource="{Binding Nodes}" IsHitTestVisible="{Binding IsSelectionMode}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Canvas>
                        <!-- 폭을 라벨이 정하면 Stretch+고정 Width인 Ellipse가 가운데로 밀려(WPF 정렬 규칙) 절점에서 어긋난다.
                             고정 폭 120 + Margin -60으로 패널 중심선을 X에 고정하고, 자식은 모두 중앙정렬한다. -->
                        <!-- docs/225 § C — 밸브부관의 밸브 쪽 표시선. 원 아래에 깔려 절점 그립을 가리지 않는다. -->
                        <Line X1="{Binding X}" Y1="{Binding Y}" X2="{Binding ValveSideX2}" Y2="{Binding ValveSideY2}"
                              Stroke="#C0392B" StrokeThickness="3" StrokeEndLineCap="Triangle" IsHitTestVisible="False"
                              Visibility="{Binding HasValveSide, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <StackPanel Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Width="120" Margin="-60,-7,0,0">
                            <!-- 선택 모드에서만 hit test가 켜지므로 여기서 모드 조건을 다시 보지 않는다.
                                 절점 우클릭 밸브부관 A/B 전환 메뉴는 docs/234로 제거 — 밸브부관은 바이패스 세트로만 놓는다. -->
                            <Ellipse Width="14" Height="14" HorizontalAlignment="Center" Cursor="SizeAll"
                                     Fill="{Binding Color}" Stroke="White" StrokeThickness="2"
                                     MouseLeftButtonDown="OnNodeMouseLeftButtonDown"/>
                            <!-- 라벨까지 hit test를 받으면 절점 주변의 선을 클릭할 수 없다. 그립은 원만이다. -->
                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#34495E"
                                       HorizontalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False"/>
                        </StackPanel>
                    </Canvas></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Rectangle Panel.ZIndex="1100" Canvas.Left="{Binding SelectionBoxX, Mode=OneWay}" Canvas.Top="{Binding SelectionBoxY, Mode=OneWay}"
                               Width="{Binding SelectionBoxWidth, Mode=OneWay}" Height="{Binding SelectionBoxHeight, Mode=OneWay}"
                               IsHitTestVisible="False" Visibility="{Binding IsSelectionBoxVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Stroke" Value="#3498DB"/>
                                <Setter Property="Fill" Value="#303498DB"/>
                                <Setter Property="StrokeThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCrossingSelection, Mode=OneWay}" Value="True">
                                        <Setter Property="Stroke" Value="#27AE60"/>
                                        <Setter Property="Fill" Value="#3027AE60"/>
                                        <Setter Property="StrokeDashArray" Value="4,3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                </Canvas>
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#EAF2F8" CornerRadius="5" Padding="8"><TextBlock Text="노드: 회색 EndPoint(관 끝) · 파랑 Inline · 주황 Elbow · 보라 Tee · 빨강 Cross" FontSize="11"/></Border>
                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#FFF4D6" BorderBrush="#F0C36D" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,42,4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="현재: " FontWeight="SemiBold"/><TextBlock Text="{Binding InteractionModeText, Mode=OneWay}" FontWeight="Bold" Foreground="#9A5B00"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding NetworkSummary, Mode=OneWay}"/></StackPanel></Border>
            </Grid></Border>
        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16,16,20,16"><ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnPanelPreviewMouseWheel"><StackPanel x:Name="PanelSections">
            <!-- 우측 패널은 아코디언이다(docs/185). 섹션 하나만 펼쳐 한 번에 보이는 입력 수를 줄인다 —
                 동시에 여러 개를 펼치면 예전처럼 평면 나열이 되어 정리한 뜻이 사라진다. 단일 펼침은 OnSectionExpanded가 강제한다. -->
            <Expander x:Name="SectionRoom" Style="{StaticResource PrimaryExpanderStyle}" Header="1. 밸브실 · 기존 요소" IsExpanded="True" Expanded="OnSectionExpanded" Margin="0,0,0,6"><StackPanel Margin="0,8,0,4">
                <TextBlock Text="Revit에서 밸브실 외곽 벽체와 기둥을 선택하세요. 기둥은 간섭 확인용 표시입니다 (본체 실선 · 헌치 점선)." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
                <Button Content="기존 객체 가져오기" Command="{Binding PickOutlineCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="가져온 객체 지우기" Command="{Binding ClearOutlineCommand}" Style="{StaticResource CancelButtonStyle}" Margin="0,6,0,10"/>
                <TextBlock Text="기존 배관" FontWeight="Bold" Foreground="#4A6FA5" FontSize="16"/>
                <TextBlock Text="이미 모델링된 배관을 선택하면 캔버스에 다시 그립니다. 지금 그려 둔 배관은 대체되며, Ctrl+Z로 되돌릴 수 있습니다." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
                <Button Content="기존 배관 가져오기" Command="{Binding PickPipingCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,10"/>
                <!-- 밸브실 유형은 외곽 벽체의 DH_Zone에서 읽어 채우고, 배치하는 배관 부재의 DH_Zone에 그대로 기록한다(docs/161). -->
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="99"/></Grid.ColumnDefinitions><TextBlock Text="밸브실 유형" VerticalAlignment="Center" ToolTip="외곽 벽체의 DH_Zone에서 자동으로 읽습니다. 배치하는 관·곱관·T형·밸브의 DH_Zone에 기록하며, 비워 두면 기록하지 않습니다."/><ComboBox Grid.Column="1" ItemsSource="{Binding ValveRoomZones, Mode=OneWay}" SelectedItem="{Binding ValveRoomZone, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}"/></Grid>
                <!-- 격점번호는 배관 치수값이 아니라 밸브실 식별자다 — 밸브실 섹션으로 옮겼다(docs/185). -->
                <!-- 격점상세도 배관재료표용 식별자(docs/131 § B-1). 필수 입력이 아니다. -->
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="99"/></Grid.ColumnDefinitions><TextBlock Text="격점번호" VerticalAlignment="Center" ToolTip="배관재료표(DH_격점번호)에 기록합니다. 밸브실 유형을 고르면 GV-01 같은 기본값이 채워지며, 직접 고치면 유형을 바꿔도 유지됩니다. 비워 두어도 모델은 생성됩니다."/><TextBox Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding JunctionId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/></Grid>
            </StackPanel></Expander>
            <Expander x:Name="SectionPort" Style="{StaticResource PrimaryExpanderStyle}" Header="2. IN / OUT 포트" IsExpanded="False" Expanded="OnSectionExpanded" Margin="0,0,0,6"><StackPanel Margin="0,8,0,4">
                <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12" Visibility="{Binding HasOutline, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="IN / OUT 상하 위치" FontWeight="SemiBold" Foreground="#34495E"/>
                        <CheckBox Content="상단벽 기준 이격 (해제 시 하단벽 기준)" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding ArrowFromTop, Mode=TwoWay}" Margin="0,6,0,6"/>
                        <!-- 포트 목록(docs/172 § D-2). IN은 좌측 벽, OUT은 우측 벽. 기본 2개일 때는 종전 화면과 같아 보여야 한다(× 버튼은 CanRemove=false로 숨김). -->
                        <ItemsControl ItemsSource="{Binding Ports, Mode=OneWay}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="24"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label, Mode=OneWay}" VerticalAlignment="Center" Foreground="{Binding Color, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding OffsetMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                                    <TextBlock Grid.Column="2" Text="mm" Margin="4,0" VerticalAlignment="Center"/>
                                    <!-- 삭제 아이콘은 MahApps IconPacks(TitleBar와 같은 PackIconMaterial). 기본 IN·OUT은 CanRemove=false라 숨는다. -->
                                    <Button Style="{StaticResource IconButtonStyle}" Grid.Column="3" Padding="0" Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="포트 삭제 (기본 IN·OUT은 지울 수 없습니다)"
                                            Command="{Binding DataContext.RemovePortCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="13" Height="13" Foreground="#B03A2E" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Button Content="IN 추가" Command="{Binding AddInPortCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" Padding="10,3"/>
                            <Button Content="OUT 추가" Command="{Binding AddOutPortCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="10,3"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- 추천 배치: 유형별 기본 배관을 IN/OUT 접점에 맞춰 그린다(docs/172 § C-11). 1차는 직관만. 외곽이 없거나 유형에 프리셋이 없으면 비활성. -->
                <Button Content="추천 배치 적용" Command="{Binding ApplyTemplateCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding TemplateHint, Mode=OneWay}" Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <!-- [프리셋 텍스트] 버튼은 하단 툴바로 옮겼다(2026-09-21) — 이 섹션은 기본 접힘 + 아코디언이라 펼치기 전엔 보이지 않았다. -->
            </StackPanel></Expander>
            <Expander x:Name="SectionPipe" Style="{StaticResource PrimaryExpanderStyle}" Header="3. 배관 기준값" IsExpanded="False" Expanded="OnSectionExpanded" Margin="0,0,0,6"><StackPanel Margin="0,8,0,4">
                <!-- 관경은 관 전용 값이 아니다 — 곡관·이형관·밸브 직경까지 구동하고, 선택이 있으면 그 선의 관경 편집칸이 된다.
                     관 패밀리 Expander(기본 접힘) 안에 두면 창을 열자마자 보이지 않는다(docs/163 § E). -->
                <Grid Margin="0,4,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DiameterCaption, Mode=OneWay}" VerticalAlignment="Center"/><TextBox x:Name="DiameterTextBox" Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" KeyDown="OnDiameterTextBoxKeyDown" PreviewKeyDown="OnDiameterTextBoxPreviewKeyDown" LostKeyboardFocus="OnDiameterTextBoxLostKeyboardFocus" Text="{Binding DiameterMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Grid.Column="2" Text="mm" Margin="4,0"/></Grid>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="높이 지정 방식" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><RadioButton Content="상대값" GroupName="PipeLayoutElevationMode" Tag="6,0,0,6" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding IsRelativeElevation, Mode=TwoWay}"/><RadioButton Content="절대값" GroupName="PipeLayoutElevationMode" Tag="0,6,6,0" Margin="-1,0,0,0" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding IsAbsoluteElevation, Mode=TwoWay}"/></StackPanel></Grid>
                <StackPanel Visibility="{Binding IsRelativeElevation, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="기준 레벨" VerticalAlignment="Center" ToolTip="EL과 레벨 높이는 내부 원점 기준입니다. Revit 레벨 태그 값(프로젝트 기준점 기준)과 다를 수 있습니다."/><ComboBox Grid.Column="1" ItemsSource="{Binding Levels, Mode=OneWay}" SelectedItem="{Binding ElevationLevel, Mode=TwoWay}" DisplayMemberPath="DisplayLabel" Style="{StaticResource PrimaryComboBoxStyle}"/></Grid>
                    <TextBlock Text="{Binding ElevationLevelHint, Mode=OneWay}" Visibility="{Binding IsElevationLevelHintVisible, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="레벨로부터 Offset" VerticalAlignment="Center"/><TextBox Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding ElevationOffsetM, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True, StringFormat={}{0:0.###}}"/><TextBlock Grid.Column="2" Text="m" Margin="4,0"/></Grid>
                    <StackPanel Orientation="Horizontal" ToolTip="EL과 레벨 높이는 내부 원점 기준입니다. Revit 레벨 태그 값(프로젝트 기준점 기준)과 다를 수 있습니다."><TextBlock Text="관 중심 EL = " Foreground="#7F8C8D"/><TextBlock Text="{Binding ElevationM, Mode=OneWay, StringFormat={}{0:0.###} m}" Foreground="#7F8C8D"/></StackPanel>
                </StackPanel>
                <Grid Margin="0,0,0,8" Visibility="{Binding IsAbsoluteElevation, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="관 중심 높이(EL)" VerticalAlignment="Center" ToolTip="EL과 레벨 높이는 내부 원점 기준입니다. Revit 레벨 태그 값(프로젝트 기준점 기준)과 다를 수 있습니다."/><TextBox Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding ElevationM, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True, StringFormat={}{0:0.###}}"/><TextBlock Grid.Column="2" Text="m" Margin="4,0"/></Grid>
                <!-- 관종은 DH_관종과 직관·단관의 DH_비고(관 재료 코드)를 구동한다(docs/141 § B). -->
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="관종" VerticalAlignment="Center" ToolTip="DH_관종에 기록하고, 직관·단관의 DH_비고에 관 재료 코드(DCIP·SP·PE·PVC)를 자동으로 적습니다."/><StackPanel Grid.Column="1" Orientation="Horizontal"><RadioButton Content="주철관" GroupName="PipeLayoutMaterial" Tag="6,0,0,6" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding IsDuctileIronSelected, Mode=TwoWay}"/><RadioButton Content="강관" GroupName="PipeLayoutMaterial" Tag="0,6,6,0" Margin="-1,0,0,0" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding IsSteelSelected, Mode=TwoWay}"/></StackPanel></Grid>
                <!-- 관 등급 — 직관·단관 단위중량(DH_무게) 조회와 DH_관종등급(docs/260 § C). -->
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="99"/></Grid.ColumnDefinitions><TextBlock Text="관 등급" VerticalAlignment="Center" ToolTip="직관·단관 단위중량(DH_무게) 조회 등급이며 DH_관종등급에 기록됩니다. 강관 '자동'은 DN≤300 STWW 290, 그 밖 STWW 400 A입니다."/><ComboBox Grid.Column="1" ItemsSource="{Binding PipeKindLabels, Mode=OneWay}" SelectedItem="{Binding PipeKindLabel, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}"/></Grid>
                <!-- 강관 밸브부관 등급 — 바이패스 지관 규격표 조회에 쓴다(docs/256). 강관일 때만 보인다(docs/263 § C). -->
                <Grid Margin="0,0,0,8" Visibility="{Binding IsSteelFittingClassEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="99"/></Grid.ColumnDefinitions><TextBlock Text="강관 등급" VerticalAlignment="Center" ToolTip="강관 밸브부관 규격 등급(KS D 3578 F12/F15/F20). 등급별 규격 범위를 벗어난 주관의 바이패스 세트는 만들지 않습니다."/><ComboBox Grid.Column="1" ItemsSource="{Binding SteelFittingClassLabels, Mode=OneWay}" SelectedItem="{Binding SteelFittingClassLabel, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}"/></Grid>
                <!-- 접합 종류는 부재명 표기(2F·2S)와 접합 개소 매개변수를 구동한다(docs/170 § E). 부재가 자기 패밀리 파라미터로 접합을 밝히면 그쪽이 이긴다. -->
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="99"/></Grid.ColumnDefinitions><TextBlock Text="접합 종류" VerticalAlignment="Center" ToolTip="부재명 앞에 2F·2S 표기를 붙이고, 관종과 함께 접합 개소를 어느 매개변수에 적을지 정합니다(강관+소켓=용접합수, 주철관+소켓=KP접합수, 플랜지=플랜지접합수). 패밀리가 접합 형식을 자체 매개변수로 갖고 있으면 그 값이 우선합니다."/><ComboBox Grid.Column="1" ItemsSource="{Binding JointConnectionLabels, Mode=OneWay}" SelectedItem="{Binding JointConnectionLabel, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}"/></Grid>
            </StackPanel></Expander>
            <!-- docs/228 § B — 바이패스 세트. 본관 위를 클릭하면 A 2개 · B 2개 · 바이패스 밸브를 한 세트로 넣는다(본관 밸브는 세트가 아니다, docs/230).
                 밸브부관 A·B 패밀리·파라미터는 이 섹션에서 고른다(docs/229 § B). -->
            <Expander x:Name="SectionBypass" Style="{StaticResource PrimaryExpanderStyle}" Header="4. 바이패스 세트" IsExpanded="False" Expanded="OnSectionExpanded" Margin="0,0,0,10"><StackPanel Margin="0,8,0,4">
                <TextBlock Text="본관 위를 클릭하면 그 점을 중심으로 밸브부관 A 2개 · 밸브부관 B 2개 · 바이패스 밸브를 넣습니다. A–A 사이는 관으로 이어지며, 본관 밸브는 [5. 밸브 · 이음관 배치]로 그 자리에 놓으면 됩니다. 캔버스 그림은 개략이고, 실제 자리는 모델 생성 때 커넥터를 재서 맞춥니다." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
                <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><StackPanel>
                    <TextBlock Text="바이패스 밸브 (B–B 사이)" FontWeight="Bold" Foreground="#4A6FA5" Margin="0,0,0,6"/>
                    <!-- docs/255 § D-2 — 밸브 개수. 2개면 V1–단관–V2로 놓는다. 목록의 [밸브 적용]으로 기존 세트에도 넣는다. -->
                    <TextBlock Text="밸브 개수" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                        <RadioButton x:Name="BypassValveCountOne" GroupName="BypassValveCount" Content="1개" IsChecked="{Binding IsBypassSingleValve, Mode=TwoWay}" Margin="0,0,16,0"/>
                        <RadioButton x:Name="BypassValveCountTwo" GroupName="BypassValveCount" Content="2개 (사이 단관)" IsChecked="{Binding IsBypassTwoValves, Mode=TwoWay}"/>
                    </StackPanel>
                    <TextBlock Text="밸브 1 패밀리 (선 시작 쪽)" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding ValveFamilyNames, Mode=OneWay}" SelectedValue="{Binding BypassValveFamilyName, Mode=TwoWay}" SelectedValuePath="Name" DisplayMemberPath="Name" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,6"/>
                    <!-- docs/244 § D-1 — 유형 목록·유형 직경 확인·바이패스 관경 입력은 없앴다. 관경은 밸브부관 B가 본관 구경으로 정하고 유형은 같은 DN으로 고른다. -->
                    <!-- docs/232 § C — 바이패스 밸브 직경 파라미터. 패밀리 기준 자동 추정 + 패밀리별 기억(4번 섹션과 같은 사전). -->
                    <TextBlock Text="인스턴스 직경 파라미터" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding BypassValveParameterNames, Mode=OneWay}" SelectedItem="{Binding BypassValveDiameterParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,6"/>
                    <!-- docs/255 § D-2 — 밸브 2개일 때만 보인다. V2 직경 파라미터는 4번 섹션과 같은 패밀리별 사전을 쓴다(G-4). -->
                    <StackPanel Visibility="{Binding IsBypassTwoValves, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="밸브 2 패밀리 (선 끝 쪽)" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding ValveFamilyNames, Mode=OneWay}" SelectedValue="{Binding BypassSecondValveFamilyName, Mode=TwoWay}" SelectedValuePath="Name" DisplayMemberPath="Name" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,6"/>
                        <TextBlock Text="밸브 사이 단관 길이" FontWeight="SemiBold"/>
                        <Grid Margin="0,4,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBox x:Name="BypassSpoolLengthTextBox" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding BypassSpoolLengthMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Grid.Column="1" Text="mm" Margin="4,0" VerticalAlignment="Center"/></Grid>
                        <TextBlock Text="0 = 두 밸브 직결. 1~9mm는 넣을 수 없습니다(관 최소 10mm). 밸브 2 직경 파라미터는 5번 섹션 밸브 설정의 패밀리별 값을 씁니다." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    </StackPanel>
                    <TextBlock Text="바이패스 관경과 밸브 유형은 모델 생성 때 정합니다 — 밸브부관 B에 본관 구경을 넣어 부관 관경을 정하고, 같은 DN의 밸브 유형을 고릅니다." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel></Border>
                <!-- docs/229 § B — 밸브부관 A·B 패밀리·파라미터는 [설정…] 창이 아니라 여기서 고른다.
                     목록은 배관 부속류 전체, 기본값은 이름에 '밸브부관'이 든 것(역가져오기 판정 키워드와 같다). -->
                <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><StackPanel>
                    <TextBlock Text="밸브부관 A (본관 T자)" FontWeight="Bold" Foreground="#4A6FA5" Margin="0,0,0,6"/>
                    <TextBlock Text="패밀리 (배관 부속류, 커넥터 3~4개)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding SegmentFamilyTypeNames, Mode=OneWay}" SelectedItem="{Binding ValveTeeFamilyTypeName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,6"/>
                    <!-- docs/232 § B — 콤보마다 컬렉션을 따로 쓴다(공유하면 갱신 Clear 때 다른 칸이 비워진다). § A-4 — 수평·수직분기 콤보는 뺐다(자동 예/아니오). -->
                    <TextBlock Text="주관 직경 파라미터" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding ValveTeeMainParameterNames, Mode=OneWay}" SelectedItem="{Binding ValveTeeMainDiameterParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,6"/>
                    <TextBlock Text="분기 직경 파라미터" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding ValveTeeBranchParameterNames, Mode=OneWay}" SelectedItem="{Binding ValveTeeBranchDiameterParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,4"/>
                    <TextBlock Text="수평분기는 예, 수직분기는 아니오로 자동 설정합니다. 바꾸려면 배치 후 특성창에서 조정하세요." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel></Border>
                <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><StackPanel>
                    <TextBlock Text="밸브부관 B (바이패스 90°)" FontWeight="Bold" Foreground="#4A6FA5" Margin="0,0,0,6"/>
                    <TextBlock Text="패밀리 (배관 부속류, 커넥터 2개)" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding SegmentFamilyTypeNames, Mode=OneWay}" SelectedItem="{Binding ValveBendFamilyTypeName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,6"/>
                    <TextBlock Text="본관 구경 파라미터" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding ValveBendParameterNames, Mode=OneWay}" SelectedItem="{Binding ValveBendDiameterParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,4"/>
                    <TextBlock Text="첫 번째 커넥터가 밸브 쪽입니다. 본관 구경을 이 파라미터에 넣고, 부관 관경은 패밀리가 정합니다." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel></Border>
                <Button Content="밸브부관 설정 저장" Command="{Binding SaveFamilySettingsCommand}" Style="{StaticResource CancelButtonStyle}" Margin="0,0,0,10" ToolTip="밸브부관 A·B 패밀리·파라미터를 프로젝트에 저장합니다. [설정…] 창의 [저장]과 같은 저장입니다."/>
                <Button Content="{Binding BypassPlacementButtonText, Mode=OneWay}" Command="{Binding ToggleBypassPlacementCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,4"/>
                <TextBlock Text="커서가 있는 쪽으로 바이패스를 뺍니다." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="바이패스 세트 목록" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ListBox Style="{StaticResource PrimaryListBoxStyle}" ItemsSource="{Binding BypassSetItems, Mode=OneWay}" Height="110"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="3">
                    <Button Content="삭제" Style="{StaticResource CancelButtonStyle}" DockPanel.Dock="Right" Command="{Binding DataContext.RemoveFittingCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                    <Button Content="방향 뒤집기" Style="{StaticResource CancelButtonStyle}" DockPanel.Dock="Right" Margin="0,0,4,0" Command="{Binding DataContext.FlipBypassSetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                    <!-- docs/255 § D-4 — 밸브 2개 세트만 V1·V2를 맞바꾼다. -->
                    <Button Content="순서 바꾸기" Style="{StaticResource CancelButtonStyle}" DockPanel.Dock="Right" Margin="0,0,4,0" ToolTip="밸브 1(선 시작 쪽)과 밸브 2(선 끝 쪽)의 자리를 맞바꿉니다." Visibility="{Binding HasTwoBypassValves, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding DataContext.SwapBypassValvesCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                    <Button Content="밸브 적용" Style="{StaticResource CancelButtonStyle}" DockPanel.Dock="Right" Margin="0,0,4,0" ToolTip="위에서 고른 밸브 개수·패밀리·단관 길이를 이 세트에 넣습니다. 유형·관경은 모델 생성 때 정합니다." Command="{Binding DataContext.ApplyBypassValvesCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                    <TextBlock Text="{Binding BypassSummary, Mode=OneWay}" ToolTip="{Binding BypassSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
            </StackPanel></Expander>
            <Expander x:Name="SectionPlace" Style="{StaticResource PrimaryExpanderStyle}" Header="5. 밸브 · 이음관 배치" IsExpanded="False" Expanded="OnSectionExpanded" Margin="0,0,0,10"><StackPanel Margin="0,8,0,4">
                <!-- docs/195 § B — 설정창의 "밸브 · 이음관" 탭을 없애고 파라미터 2칸을 여기로 옮겼다.
                     밸브와 이음관을 상자로 갈라 둔다. 두 부속은 TypeKey만 다른 같은 인라인 부속이라 섞여 보이면 구분이 안 된다.
                     상자 스타일은 설정창 "패밀리" 탭과 같은 값을 쓴다(PipeLayoutFamilySettingsView.xaml:26).
                     이음관도 밸브와 같은 2단(패밀리 콤보 → 유형 리스트)으로 맞췄다(docs/200). -->
                <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><StackPanel>
                <TextBlock Text="밸브" FontWeight="Bold" Foreground="#4A6FA5" Margin="0,0,0,6"/>
                <TextBlock Text="밸브 패밀리 (배관 밸브류)" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding ValveFamilyNames, Mode=OneWay}" SelectedValue="{Binding SelectedValveFamilyName, Mode=TwoWay}" SelectedValuePath="Name" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, Mode=OneWay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDiameterMatched, Mode=OneWay}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#1E8449"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="관경과 같은 DN 패밀리는 굵게 표시됩니다." FontSize="11" Foreground="#566573" Margin="0,2,0,6"/>
                <TextBlock Text="배치할 유형 (선택 후 선 위 클릭)" FontWeight="SemiBold"/>
                <ListBox Style="{StaticResource PrimaryListBoxStyle}" ItemsSource="{Binding FamilyTypeNames, Mode=OneWay}" SelectedItem="{Binding SelectedFamilyTypeName, Mode=TwoWay}" IsEnabled="{Binding IsDrawMode}" Height="90" Margin="0,4,0,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource FamilyTypeNameToTypeNameConverter}, Mode=OneWay}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- 후보는 위에서 고른 유형을 따라 갱신된다(PipeLayoutViewModel.CurrentValveFamilyTypeName:2571 = SelectedFamilyTypeName).
                     비워 두면 패밀리 기본 구경 그대로 놓인다. 값 저장은 [설정…] 창의 [저장]이 맡는다. -->
                <TextBlock Text="인스턴스 직경 파라미터 (선택 · 패밀리별 저장)" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding ValveParameterNames, Mode=OneWay}" SelectedItem="{Binding ValveDiameterParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,6"/>
                <!-- docs/233 § B-3 — 유형 매개변수(Nominal pipe size 등)로 고정된 공칭지름 확인용. 값을 쓰지 않고 관경과 대조만 한다. 후보는 길이형 유형 매개변수. -->
                <TextBlock Text="유형 직경 매개변수 (확인용)" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding ValveTypeParameterNames, Mode=OneWay}" SelectedItem="{Binding ValveTypeDiameterParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,4"/>
                <TextBlock Text="{Binding ValveTypeDiameterText, Mode=OneWay}" FontSize="11" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#7F8C8D"/><Style.Triggers><DataTrigger Binding="{Binding IsValveTypeDiameterMismatch, Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="#B03A2E"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                </StackPanel></Border>
                <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><StackPanel>
                <TextBlock Text="이음관" FontWeight="Bold" Foreground="#4A6FA5" Margin="0,0,0,6"/>
                <!-- 이음관은 밸브처럼 선 위를 클릭해 놓는다(docs/175 § C-3). 밸브 근처(50mm)면 생성기가 밸브 커넥터에 밀착시킨다(§ D-2). -->
                <TextBlock Text="이음관 패밀리 (배관 이음쇠)" FontWeight="SemiBold"/>
                <TextBlock Text="이음관 패밀리를 찾지 못했습니다. 패밀리명에 '이음관'이 든 배관 이음쇠를 프로젝트에 불러오세요." Foreground="#B03A2E" FontSize="11" TextWrapping="Wrap" Visibility="{Binding HasNoJointFamily, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <ComboBox ItemsSource="{Binding JointFamilyNames, Mode=OneWay}" SelectedItem="{Binding SelectedJointFamilyName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,8"/>
                <TextBlock Text="배치할 유형 (선택 후 선 위 클릭)" FontWeight="SemiBold"/>
                <ListBox Style="{StaticResource PrimaryListBoxStyle}" ItemsSource="{Binding JointTypeNames, Mode=OneWay}" SelectedItem="{Binding SelectedJointFamilyTypeName, Mode=TwoWay}" IsEnabled="{Binding IsDrawMode}" Height="70" Margin="0,4,0,8">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource FamilyTypeNameToTypeNameConverter}, Mode=OneWay}"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <!-- 이음관 구경 파라미터는 밸브처럼 패밀리별로 두지 않고 전역 1개다(docs/167 § C).
                     후보는 실제 배치에 쓰인 이음관 패밀리에서 뽑는다(PipeLayoutViewModel.CurrentJointFamilyTypeName:2575). -->
                <TextBlock Text="이음관 구경 파라미터 (선택)" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding JointParameterNames, Mode=OneWay}" SelectedItem="{Binding JointDiameterParameterName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,4"/>
                <TextBlock Text="이음관 길이는 패밀리가 구경에서 자동 계산합니다. 밸브 옆 50mm 안에 찍으면 밸브 커넥터에 밀착됩니다." Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,0"/>
                </StackPanel></Border>
                <TextBlock Text="밸브·이음관 목록" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ListBox Style="{StaticResource PrimaryListBoxStyle}" ItemsSource="{Binding InlineFittings, Mode=OneWay}" Height="180"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="3"><Button Content="삭제" Style="{StaticResource CancelButtonStyle}" DockPanel.Dock="Right" Command="{Binding DataContext.RemoveFittingCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding DisplayOrder, Mode=OneWay}" Width="24"/><TextBlock DockPanel.Dock="Right" Text="{Binding KindBadge, Mode=OneWay}" Foreground="#16A085" FontSize="11" FontWeight="SemiBold" Margin="6,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{Binding DisplayName, Mode=OneWay}" ToolTip="{Binding TypeKey, Mode=OneWay}" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
            </StackPanel></Expander>
            <!-- docs/301 — 수직분기. 모델 부속 +Z 커넥터에서 부품을 위로 쌓음. 캔버스 망과 별도 요소. -->
            <Expander x:Name="SectionVertical" Style="{StaticResource PrimaryExpanderStyle}" Header="6. 수직분기" IsExpanded="False" Expanded="OnSectionExpanded" Margin="0,0,0,10"><StackPanel Margin="0,8,0,4">
                <TextBlock Text="+Z 커넥터 부속 선택 → 위로 쌓기 · 망과 별도" Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
                <Button Content="수직분기 추가…" Command="{Binding AddVerticalBranchCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding VerticalBranchLastResult, Mode=OneWay}" Foreground="#34495E" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel></Expander>
            <!-- 패밀리 매핑·스냅·기준점은 손대는 빈도가 낮아 별도 창으로 뺐다(docs/185). 창 안에서 탭으로 나뉜다. -->
            <Button Content="설정…  (패밀리 · 스냅 · 기준점)" Command="{Binding OpenFamilySettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,4"/>
        </StackPanel></ScrollViewer></Border>
        </Grid>
        <Grid Grid.Row="2" Margin="20,0,20,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><!-- 안내·검증 문구가 길어져도 행 높이가 늘지 않게 최대 높이 + 세로 스크롤로 가둔다. 복사할 수 있게 읽기 전용 TextBox로 둔다(2026-09-28 사용자 요청). -->
            <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center" Margin="0,0,12,0"><StackPanel>
                <TextBox Text="{Binding Status, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Foreground="#34495E" TextWrapping="Wrap"/>
                <TextBox Text="{Binding ValidationSummary, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Foreground="#B03A2E" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel></ScrollViewer>
            <!-- 버튼 높이가 안내 영역 높이를 따라 늘지 않게 아래에 붙인다. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBlock Text="Mode" VerticalAlignment="Center" Foreground="#566573" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0"/>
            <Button Content="선택" Command="{Binding SelectModeCommand}" Margin="0,0,4,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CancelButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelectionMode}" Value="True">
                                <Setter Property="Background" Value="#2878B8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="그리기" Command="{Binding DrawModeCommand}" Margin="0,0,12,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CancelButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDrawMode}" Value="True">
                                <Setter Property="Background" Value="#2878B8"/>
                                <Setter Property="Foreground"  Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Style="{StaticResource CancelButtonStyle}" Command="{Binding UndoCommand}" ToolTip="뒤로가기 (Ctrl+Z)" AutomationProperties.Name="뒤로가기"><TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button><Button Style="{StaticResource CancelButtonStyle}" Command="{Binding DeleteSelectedEdgeCommand}" ToolTip="선택한 배관 삭제 (Delete)" AutomationProperties.Name="선택한 배관 삭제" Margin="8,0"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button><Button Style="{StaticResource CancelButtonStyle}" Command="{Binding SplitEdgeCommand}" Margin="0,0,8,0" AutomationProperties.Name="선 분할" ToolTip="선 분할 — 선 하나를 고른 뒤 누르고, 나눌 지점을 클릭합니다. 나눈 두 조각은 관경과 부속을 나눠 갖습니다. 정척 이음매 위치가 바뀝니다. Esc로 취소."><iconPacks:PackIconMaterial Kind="ScissorsCutting" Width="16" Height="16" VerticalAlignment="Center"/></Button><Button Content="그리기 취소" Style="{StaticResource CancelButtonStyle}" Command="{Binding CancelDrawingCommand}" Margin="0,0,8,0"/><Button Content="초기화" Style="{StaticResource CancelButtonStyle}" Command="{Binding ClearCommand}" Margin="0,0,8,0"/><!-- 임시 도구(2026-09-18): 캔버스를 프리셋 제출 양식 텍스트로 뽑아 읽기 전용 창에 띄운다. 유형별 기본값을 카탈로그에 넣으면 이 버튼과 호출부를 함께 제거한다. --><Button Content="프리셋 텍스트" Command="{Binding ExportTemplateTextCommand}" Style="{StaticResource CancelButtonStyle}" Margin="0,0,8,0" ToolTip="지금 캔버스에 그려진 선·부속·연결단을 지시서 제출 양식 텍스트로 보여 줍니다. 읽기 전용이며 캔버스는 바뀌지 않습니다."/><TextBlock Text="생성 시 기존 부재 교체" Foreground="#7F8C8D" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding HasReplaceTarget, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="가져온 원본 또는 이 창에서 직전에 생성한 부재를 모두 지우고 캔버스 내용대로 다시 만듭니다(docs/235 § C). ElementId가 바뀌므로 기존 태그·치수 참조는 끊깁니다. Revit에서 Ctrl+Z 한 번으로 생성과 삭제가 함께 취소됩니다."/><Button Content="Revit에서 보기" Command="{Binding SelectInRevitCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" ToolTip="캔버스에서 고른 배관·부속을 Revit 모델에서 선택하고 해당 뷰로 이동합니다. 모델을 생성했거나 가져온 배관만 대상입니다."/><Button Content="모델 생성" Command="{Binding CreateModelCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/><Button Content="닫기" Style="{StaticResource CancelButtonStyle}" Command="{Binding CloseCommand}"/></StackPanel></Grid>
    </Grid>
</Window>
