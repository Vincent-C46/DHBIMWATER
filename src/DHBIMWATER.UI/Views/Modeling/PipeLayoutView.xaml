<Window x:Class="DHBIMWATER.UI.Views.Modeling.PipeLayoutView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls"
        xmlns:converters="clr-namespace:DHBIMWATER.UI.Converters"
        xmlns:vm="clr-namespace:DHBIMWATER.UI.ViewModels.Modeling"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PipeLayoutViewModel}"
        Title="DHBIMWATER - Pipe Layout" Width="1180" Height="720" WindowStartupLocation="CenterScreen"
        Background="#F4F7F9" WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic" PreviewKeyDown="OnPreviewKeyDown" Validation.Error="OnValidationError">
    <Window.Resources><ResourceDictionary><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/><converters:FamilyTypeNameToTypeNameConverter x:Key="FamilyTypeNameToTypeNameConverter"/><SolidColorBrush x:Key="PipeErrorBrush" Color="#E74C3C"/><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <controls:TitleBar Grid.Row="0"/>
        <Grid Grid.Row="1" Margin="20,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="12" Padding="8" Margin="0,0,12,0"><DockPanel>
                <!-- UI 개편 — 편집·배치 도구를 캔버스 상단 툴바로(종전 하단 버튼줄). [그리기 취소]는 없앰 → Esc(HandleEscape)가 같은 일. -->
                <Border DockPanel.Dock="Top" Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,0,6">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <TextBlock Text="편집" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" FontSize="11" FontWeight="SemiBold" Margin="2,0,6,0"/>
                            <Button Content="선택" Command="{Binding SelectModeCommand}" Margin="0,0,4,0" ToolTip="선택 모드 (Esc로 진행 중 작업 취소)">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CancelButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsSelectionMode}" Value="True"><Setter Property="Background" Value="#2878B8"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button Content="그리기" Command="{Binding DrawModeCommand}" Margin="0,0,4,0" ToolTip="선 그리기 모드">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CancelButtonStyle}"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsDrawMode}" Value="True"/><Condition Binding="{Binding IsPlacingFitting}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="#2878B8"/><Setter Property="Foreground" Value="White"/></MultiDataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button Style="{StaticResource CancelButtonStyle}" Command="{Binding SplitEdgeCommand}" Margin="0,0,4,0" AutomationProperties.Name="선 분할" ToolTip="선 분할 — 선 하나를 고른 뒤 누르고, 나눌 지점을 클릭합니다. 나눈 두 조각은 관경과 부속을 나눠 갖습니다. 정척 이음매 위치가 바뀝니다. Esc로 취소."><StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="ScissorsCutting" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text=" 분할"/></StackPanel></Button>
                            <Border Width="1" Background="#DCE6EE" Margin="6,2"/>
                            <TextBlock Text="배치" VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" FontSize="11" FontWeight="SemiBold" Margin="2,0,6,0"/>
                            <!-- 밸브·이음관 도구 = [부속] 탭 해당 칸 열기. 유형을 고르면 배치 모드(동작 변경 B) -->
                            <Button Style="{StaticResource CancelButtonStyle}" Click="OnValveToolClick" Margin="0,0,4,0" AutomationProperties.Name="밸브 도구" ToolTip="[부속] 탭 밸브 칸을 엽니다. 유형을 고르면 바로 배치 모드가 됩니다."><StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="Valve" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text=" 밸브" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource CancelButtonStyle}" Click="OnJointToolClick" Margin="0,0,4,0" AutomationProperties.Name="이음관 도구" ToolTip="[부속] 탭 이음관 칸을 엽니다. 유형을 고르면 바로 배치 모드가 됩니다."><StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="PipeDisconnected" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text=" 이음관" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Click="OnBypassToolClick" Margin="0,0,4,0" AutomationProperties.Name="바이패스 도구" ToolTip="바이패스 세트 배치 켜기 — 본관 위를 클릭합니다. 끄기는 Esc. 커서 쪽으로 바이패스를 뺍니다.">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CancelButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsPlacingBypassSet}" Value="True"><Setter Property="Background" Value="#2878B8"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="SourceBranch" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text=" 바이패스" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Border Width="1" Background="#DCE6EE" Margin="6,2"/>
                            <Button Style="{StaticResource CancelButtonStyle}" Command="{Binding UndoCommand}" ToolTip="뒤로가기 (Ctrl+Z)" AutomationProperties.Name="뒤로가기" Margin="0,0,4,0"><TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="14"/></Button>
                            <Button Style="{StaticResource CancelButtonStyle}" Command="{Binding DeleteSelectedEdgeCommand}" ToolTip="선택한 배관 삭제 (Delete)" AutomationProperties.Name="선택한 배관 삭제"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"/></Button>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <!-- 드물게·위험하게 쓰는 명령은 ⋯ 메뉴로. 프리셋 텍스트는 임시 도구(2026-09-18) — 유형별 기본값 확정 후 호출부와 함께 제거 -->
                            <Button Content="⋯" Style="{StaticResource CancelButtonStyle}" Click="OnOpenContextMenuClick" Margin="0,0,4,0" ToolTip="더 보기 (초기화 · 프리셋 텍스트)" AutomationProperties.Name="더 보기">
                                <Button.ContextMenu><ContextMenu>
                                    <MenuItem Header="초기화 (전체 지우기)" Command="{Binding ClearCommand}"/>
                                    <MenuItem Header="프리셋 텍스트…" Command="{Binding ExportTemplateTextCommand}" ToolTip="지금 캔버스에 그려진 선·부속·연결단을 지시서 제출 양식 텍스트로 보여 줍니다. 읽기 전용이며 캔버스는 바뀌지 않습니다."/>
                                </ContextMenu></Button.ContextMenu>
                            </Button>
                            <Button Style="{StaticResource CancelButtonStyle}" Command="{Binding OpenFamilySettingsCommand}" ToolTip="설정 (패밀리 · 밸브·부관 · 스냅 · 기준점)" AutomationProperties.Name="설정"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/></Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid>
                <Canvas x:Name="LayoutCanvas" Background="#FCFDFE" Focusable="True" Cursor="None"
                        ClipToBounds="True"
                        MouseLeftButtonDown="OnCanvasMouseLeftButtonDown" MouseMove="OnCanvasMouseMove" MouseLeave="OnCanvasMouseLeave"
                        MouseWheel="OnCanvasMouseWheel" MouseDown="OnCanvasMouseDown" MouseUp="OnCanvasMouseUp"
                        SizeChanged="OnLayoutCanvasSizeChanged">
                    <Line X1="{Binding ReferenceScreenX}" Y1="0" X2="{Binding ReferenceScreenX}" Y2="{Binding ActualHeight, ElementName=LayoutCanvas}" Stroke="#9ACD32" StrokeThickness="1.5" StrokeDashArray="4,3" IsHitTestVisible="False"/>
                    <Line X1="0" Y1="{Binding ReferenceScreenY}" X2="{Binding ActualWidth, ElementName=LayoutCanvas}" Y2="{Binding ReferenceScreenY}" Stroke="#9ACD32" StrokeThickness="1.5" StrokeDashArray="4,3" IsHitTestVisible="False"/>
                    <!-- 외곽 레이아웃: 내측면(진한 실선)이 기준면, 외측면(연한 선)은 벽 두께 표현 -->
                    <ItemsControl ItemsSource="{Binding OutlineWalls}" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Canvas>
                        <Line X1="{Binding OuterX1}" Y1="{Binding OuterY1}" X2="{Binding OuterX2}" Y2="{Binding OuterY2}" Stroke="#C3CFD9" StrokeThickness="1"/>
                        <Line X1="{Binding InnerX1}" Y1="{Binding InnerY1}" X2="{Binding OuterX1}" Y2="{Binding OuterY1}" Stroke="#C3CFD9" StrokeThickness="1"/>
                        <Line X1="{Binding InnerX2}" Y1="{Binding InnerY2}" X2="{Binding OuterX2}" Y2="{Binding OuterY2}" Stroke="#C3CFD9" StrokeThickness="1"/>
                        <Line X1="{Binding InnerX1}" Y1="{Binding InnerY1}" X2="{Binding InnerX2}" Y2="{Binding InnerY2}" Stroke="#5D6D7E" StrokeThickness="2.5"/>
                    </Canvas></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <!-- 기둥(docs/184, docs/189): 간섭 확인용 참조물. 본체는 실선, 헌치 등 덧단면은 점선. 채움을 없애 겹쳐도 두 선이 모두 보인다 -->
                    <ItemsControl ItemsSource="{Binding OutlineColumns}" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                        <!-- StrokeThickness를 요소에 직접 주면 Style 트리거보다 우선해 덮인다 — 반드시 Setter로만 준다 -->
                        <Polygon Points="{Binding Points}" Fill="{x:Null}" Stroke="#5D6D7E">
                            <Polygon.Style>
                                <Style TargetType="Polygon">
                                    <Setter Property="StrokeThickness" Value="2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCore}" Value="False">
                                            <Setter Property="StrokeThickness" Value="1.2"/>
                                            <Setter Property="StrokeDashArray" Value="3,2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Polygon.Style>
                        </Polygon>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <!-- IN/OUT 화살표: 좌·우 내측면 고정, 상하 위치만 사용자 지정 -->
                    <ItemsControl ItemsSource="{Binding OutlineArrows}" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Canvas>
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{Binding Color}" StrokeThickness="2.5"/>
                        <Polygon Points="{Binding HeadPoints}" Fill="{Binding Color}"/>
                        <TextBlock Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}" Text="{Binding Label}" FontSize="11" FontWeight="Bold" Foreground="{Binding Color}"/>
                    </Canvas></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <!-- 임시치수: 커서에서 X·Y 각 방향으로 가장 가까운 외곽선까지 -->
                    <ItemsControl ItemsSource="{Binding TempDimensions, Mode=OneWay}" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Canvas>
                        <Line X1="{Binding X1, Mode=OneWay}" Y1="{Binding Y1, Mode=OneWay}" X2="{Binding X2, Mode=OneWay}" Y2="{Binding Y2, Mode=OneWay}" Stroke="{Binding Stroke, Mode=OneWay}" StrokeThickness="1" StrokeDashArray="3,2"/>
                        <TextBlock Canvas.Left="{Binding LabelX, Mode=OneWay}" Canvas.Top="{Binding LabelY, Mode=OneWay}" Text="{Binding Label, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Background="Transparent">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="2,-16,0,0"/>
                                    <Setter Property="Foreground" Value="#6C3483"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSubLine, Mode=OneWay}" Value="True">
                                            <Setter Property="Margin" Value="2,-30,0,0"/>
                                            <Setter Property="Foreground" Value="#A569BD"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Canvas></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <!-- 스냅 표식은 노드·엣지 위에서 잡히므로, 선언 순서(z-order)로는 뒤에 오는 Edges/InlineFittings/Nodes에 가려진다.
                         Canvas의 다른 자식은 모두 기본 ZIndex(0)이므로 여기만 올려서 항상 최상단에 그린다. -->
                    <Grid Panel.ZIndex="1000" Canvas.Left="{Binding SnapMarkerX}" Canvas.Top="{Binding SnapMarkerY}" Margin="-16,-16,0,0" Width="32" Height="32" IsHitTestVisible="False" Visibility="{Binding IsSnapMarkerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas.Style><Style TargetType="Canvas"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SnapMarkerSymbol}" Value="+"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Canvas.Style>
                            <Line X1="8" Y1="1" X2="8" Y2="15" Stroke="#00A651" StrokeThickness="2"/>
                            <Line X1="1" Y1="8" X2="15" Y2="8" Stroke="#00A651" StrokeThickness="2"/>
                        </Canvas>
                        <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas.Style><Style TargetType="Canvas"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SnapMarkerSymbol}" Value="×"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Canvas.Style>
                            <Line X1="2" Y1="2" X2="14" Y2="14" Stroke="#00A651" StrokeThickness="2"/>
                            <Line X1="14" Y1="2" X2="2" Y2="14" Stroke="#00A651" StrokeThickness="2"/>
                        </Canvas>
                        <Rectangle Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#00A651" StrokeThickness="2.5" Fill="Transparent">
                            <Rectangle.Style><Style TargetType="Rectangle"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SnapMarkerSymbol}" Value="□"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Rectangle.Style>
                        </Rectangle>
                        <Polygon Points="8,1 15,15 1,15" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#00A651" StrokeThickness="2" Fill="Transparent">
                            <Polygon.Style><Style TargetType="Polygon"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SnapMarkerSymbol}" Value="△"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Polygon.Style>
                        </Polygon>
                        <Polygon Points="8,0 16,8 8,16 0,8" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#00A651" StrokeThickness="2" Fill="Transparent">
                            <Polygon.Style><Style TargetType="Polygon"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SnapMarkerSymbol}" Value="◇"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Polygon.Style>
                        </Polygon>
                        <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas.Style><Style TargetType="Canvas"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SnapMarkerSymbol}" Value="⊥"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Canvas.Style>
                            <Line X1="2" Y1="13" X2="14" Y2="13" Stroke="#00A651" StrokeThickness="2"/>
                            <Line X1="8" Y1="1" X2="8" Y2="13" Stroke="#00A651" StrokeThickness="2"/>
                        </Canvas>
                        <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#00A651">
                            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SnapMarkerSymbol}" Value="·"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <TextBlock Panel.ZIndex="1000" Canvas.Left="{Binding SnapMarkerX, Mode=OneWay}" Canvas.Top="{Binding SnapMarkerY, Mode=OneWay}"
                               Margin="14,4,0,0" Text="{Binding SnapMarkerLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                               Foreground="#00733B" Background="#F2FBF6" IsHitTestVisible="False"
                               Visibility="{Binding IsSnapMarkerVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- CAD식 십자선 커서: 시스템 커서(Cursor="None") 대신 직접 그린다.
                         스냅이 잡히면 CursorX/Y에 스냅 좌표가 들어오므로 십자선이 그 점에 달라붙는다(자석).
                         십자선 40px와 픽박스 12px는 화면 고정 크기이며 스냅 허용오차(모델 100mm)와는 무관하다. -->
                    <Grid Panel.ZIndex="900" Canvas.Left="{Binding CursorX, Mode=OneWay}" Canvas.Top="{Binding CursorY, Mode=OneWay}"
                          Margin="-20,-20,0,0" Width="40" Height="40" IsHitTestVisible="False"
                          Visibility="{Binding IsCursorVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Line X1="20" Y1="0" X2="20" Y2="40" Stroke="#7F8C8D" StrokeThickness="1"/>
                        <Line X1="0" Y1="20" X2="40" Y2="20" Stroke="#7F8C8D" StrokeThickness="1"/>
                        <Rectangle Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Stroke="#34495E" StrokeThickness="1" Fill="Transparent"
                                   Visibility="{Binding IsSelectionMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                    <!-- SubLine: 그리는 중에만, 중심선에서 관 반경(DiameterMm/2)만큼 떨어진 관 외곽선 -->
                    <Line X1="{Binding SubLineAX1, Mode=OneWay}" Y1="{Binding SubLineAY1, Mode=OneWay}" X2="{Binding SubLineAX2, Mode=OneWay}" Y2="{Binding SubLineAY2, Mode=OneWay}"
                          Stroke="#F5B041" StrokeThickness="1" StrokeDashArray="4,3" IsHitTestVisible="False"
                          Visibility="{Binding IsSubLineVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Line X1="{Binding SubLineBX1, Mode=OneWay}" Y1="{Binding SubLineBY1, Mode=OneWay}" X2="{Binding SubLineBX2, Mode=OneWay}" Y2="{Binding SubLineBY2, Mode=OneWay}"
                          Stroke="#F5B041" StrokeThickness="1" StrokeDashArray="4,3" IsHitTestVisible="False"
                          Visibility="{Binding IsSubLineVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- 정척 수직보조선(docs/245): 선 시작점부터 정척 길이마다 SubLine A–B를 잇는다. 참고용 — 부속 폭 미반영 -->
                    <Path Data="{Binding SubLineTicks, Mode=OneWay}" Stroke="#F5B041" StrokeThickness="1" IsHitTestVisible="False"
                          Visibility="{Binding IsSubLineVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Line X1="{Binding PreviewX1}" Y1="{Binding PreviewY1}" X2="{Binding PreviewX2}" Y2="{Binding PreviewY2}" Stroke="#E67E22" StrokeThickness="3" StrokeDashArray="6,3" IsHitTestVisible="False" Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- 분할 표식: [선 분할] 중 커서가 올라탄 지점에서 선에 수직하게 긋는 짧은 선분(docs/181 § A).
                         선·절점 위에 얹혀야 어디가 잘리는지 보이므로 ZIndex를 올린다(스냅 표식 1000보다는 아래). -->
                    <Line Panel.ZIndex="950" X1="{Binding SplitMarkerX1, Mode=OneWay}" Y1="{Binding SplitMarkerY1, Mode=OneWay}"
                          X2="{Binding SplitMarkerX2, Mode=OneWay}" Y2="{Binding SplitMarkerY2, Mode=OneWay}"
                          Stroke="#E74C3C" StrokeThickness="2.5" IsHitTestVisible="False"
                          Visibility="{Binding IsSplitMarkerVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Canvas.Left="{Binding PreviewLengthX}" Canvas.Top="{Binding PreviewLengthY}" Margin="4,-20,0,0" Text="{Binding PreviewLength}" FontSize="11" FontWeight="SemiBold" Foreground="#D35400" Background="#FFFCF8" IsHitTestVisible="False" Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Canvas.Left="{Binding PreviewLengthX, Mode=OneWay}" Canvas.Top="{Binding PreviewLengthY, Mode=OneWay}" Margin="4,-6,0,0"
                               Text="{Binding PreviewAngle, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#D35400" Background="#FFFCF8"
                               IsHitTestVisible="False" Visibility="{Binding IsPreviewVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- 부속 배치 미리보기: 리스트에서 패밀리를 고르면 커서가 붙는 선 위 지점에 도형 + 시작점부터의 임시치수를 보여준다 -->
                    <Line X1="{Binding FittingDimX1}" Y1="{Binding FittingDimY1}" X2="{Binding FittingDimX2}" Y2="{Binding FittingDimY2}" Stroke="#F39C12" StrokeThickness="1" StrokeDashArray="3,2" IsHitTestVisible="False" Visibility="{Binding IsFittingPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Canvas.Left="{Binding FittingPreviewX}" Canvas.Top="{Binding FittingPreviewY}" Margin="8,-18,0,0" Text="{Binding FittingDimLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#B9770E" Background="#FEF9E7" IsHitTestVisible="False" Visibility="{Binding IsFittingPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- docs/228 § B — 바이패스 세트 미리보기(개략). 실제 치수는 Revit이 패밀리를 재서 정한다. -->
                    <Path Data="{Binding BypassPreviewLine, Mode=OneWay}" Stroke="#283593" StrokeThickness="2.5" StrokeDashArray="5,3" Opacity="0.7" IsHitTestVisible="False" Visibility="{Binding IsBypassPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Path Data="{Binding BypassPreviewMarkers, Mode=OneWay}" Fill="#283593" Stroke="White" StrokeThickness="1" Opacity="0.7" IsHitTestVisible="False" Visibility="{Binding IsBypassPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Grid Canvas.Left="{Binding FittingPreviewX}" Canvas.Top="{Binding FittingPreviewY}" Width="18" Height="18" Margin="-9,-9,0,0" IsHitTestVisible="False" Visibility="{Binding IsFittingPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Polygon Points="9,1 17,9 9,17 1,9" Fill="#D81B60" Stroke="White" StrokeThickness="1.5"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Edges}" IsHitTestVisible="True"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Canvas>
                        <Line X1="{Binding SubAX1, Mode=OneWay}" Y1="{Binding SubAY1, Mode=OneWay}" X2="{Binding SubAX2, Mode=OneWay}" Y2="{Binding SubAY2, Mode=OneWay}" Stroke="#F5B041" StrokeThickness="1" Opacity="0.35" IsHitTestVisible="False"/>
                        <Line X1="{Binding SubBX1, Mode=OneWay}" Y1="{Binding SubBY1, Mode=OneWay}" X2="{Binding SubBX2, Mode=OneWay}" Y2="{Binding SubBY2, Mode=OneWay}" Stroke="#F5B041" StrokeThickness="1" Opacity="0.35" IsHitTestVisible="False"/>
                        <Path Data="{Binding StraightTicks, Mode=OneWay}" Stroke="#F5B041" StrokeThickness="1" Opacity="0.35" IsHitTestVisible="False"/>
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" MouseLeftButtonDown="OnEdgeMouseLeftButtonDown"><Line.Style><!-- Stroke/StrokeThickness를 로컬 속성으로 두면 아래 트리거가 먹지 않는다(XAML:47 주석 참조). --><Style TargetType="Line"><Setter Property="Stroke" Value="{Binding Stroke}"/><Setter Property="StrokeThickness" Value="4"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/><Condition Binding="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding IsSelected}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Stroke" Value="#5DADE2"/><Setter Property="StrokeThickness" Value="6"/></MultiDataTrigger></Style.Triggers></Style></Line.Style></Line>
                        <TextBlock Canvas.Left="{Binding LengthX}" Canvas.Top="{Binding LengthY}" Margin="4,-20,0,0" Text="{Binding LengthLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#1B4F72" Background="#F8FBFD" IsHitTestVisible="False"/>
                        <TextBlock Canvas.Left="{Binding LengthX}" Canvas.Top="{Binding LengthY}" Margin="4,-8,0,0" Text="{Binding DiameterLabel, Mode=OneWay}" FontSize="11" Foreground="#5D6D7E" Background="#F8FBFD" IsHitTestVisible="False"/>
                    </Canvas></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <!-- 배치된 배관 밸브류는 P&ID 관습적 다이아몬드로 표시한다. -->
                    <!-- ItemsControl은 각 항목을 ContentPresenter로 감싸므로 DataTemplate 루트의 Canvas.Left/Top은 무시된다
                         (전 항목이 (0,0)에 겹친다). 위 Edges 템플릿과 같이 루트를 Canvas로 감싸 절대 위치를 살린다. -->
                    <ItemsControl ItemsSource="{Binding InlineFittings}" IsHitTestVisible="{Binding IsSelectionMode}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Canvas>
                        <!-- docs/228 § B — 바이패스 세트 개략 그림(A 사각형 · B 원 · 바이패스 밸브 다이아몬드). 본관 밸브는 아래 기존 다이아몬드다. -->
                        <Path Data="{Binding BypassLine, Mode=OneWay}" Stroke="{Binding BypassStroke, Mode=OneWay}" StrokeThickness="2.5" MouseLeftButtonDown="OnFittingMouseLeftButtonDown"/>
                        <Path Data="{Binding BypassMarkers, Mode=OneWay}" Fill="{Binding BypassFill, Mode=OneWay}" Stroke="White" StrokeThickness="1" MouseLeftButtonDown="OnFittingMouseLeftButtonDown"/>
                        <StackPanel Canvas.Left="{Binding X, Mode=OneWay}" Canvas.Top="{Binding Y, Mode=OneWay}" Width="120" Margin="-60,-7,0,0">
                            <Grid Width="14" Height="14" HorizontalAlignment="Center" ToolTip="{Binding FamilyTypeName, Mode=OneWay}" MouseLeftButtonDown="OnFittingMouseLeftButtonDown">
                                <Polygon Points="7,0 14,7 7,14 0,7" Stroke="White" StrokeThickness="1"><Polygon.Style><Style TargetType="Polygon"><Setter Property="Fill" Value="{Binding Fill, Mode=OneWay}"/><Style.Triggers><!-- 부속 ItemsControl은 선택 모드에서만 hit test가 켜지므로 모드 조건이 따로 필요 없다. --><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True"/><Condition Binding="{Binding IsSelected, Mode=OneWay}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Fill" Value="#F8C471"/></MultiDataTrigger></Style.Triggers></Style></Polygon.Style></Polygon>
                            </Grid>
                            <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontSize="11" Foreground="#34495E" HorizontalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False"/>
                        </StackPanel>
                    </Canvas></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <ItemsControl ItemsSource="{Binding Nodes}" IsHitTestVisible="{Binding IsSelectionMode}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Canvas>
                        <!-- 폭을 라벨이 정하면 Stretch+고정 Width인 Ellipse가 가운데로 밀려(WPF 정렬 규칙) 절점에서 어긋난다.
                             고정 폭 120 + Margin -60으로 패널 중심선을 X에 고정하고, 자식은 모두 중앙정렬한다. -->
                        <!-- docs/225 § C — 밸브부관의 밸브 쪽 표시선. 원 아래에 깔려 절점 그립을 가리지 않는다. -->
                        <Line X1="{Binding X}" Y1="{Binding Y}" X2="{Binding ValveSideX2}" Y2="{Binding ValveSideY2}"
                              Stroke="#C0392B" StrokeThickness="3" StrokeEndLineCap="Triangle" IsHitTestVisible="False"
                              Visibility="{Binding HasValveSide, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <StackPanel Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Width="120" Margin="-60,-7,0,0">
                            <!-- 선택 모드에서만 hit test가 켜지므로 여기서 모드 조건을 다시 보지 않는다.
                                 절점 우클릭 밸브부관 A/B 전환 메뉴는 docs/234로 제거 — 밸브부관은 바이패스 세트로만 놓는다. -->
                            <Ellipse Width="14" Height="14" HorizontalAlignment="Center" Cursor="SizeAll"
                                     Fill="{Binding Color}" Stroke="White" StrokeThickness="2"
                                     MouseLeftButtonDown="OnNodeMouseLeftButtonDown"/>
                            <!-- 라벨까지 hit test를 받으면 절점 주변의 선을 클릭할 수 없다. 그립은 원만이다. -->
                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#34495E"
                                       HorizontalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False"/>
                        </StackPanel>
                    </Canvas></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Rectangle Panel.ZIndex="1100" Canvas.Left="{Binding SelectionBoxX, Mode=OneWay}" Canvas.Top="{Binding SelectionBoxY, Mode=OneWay}"
                               Width="{Binding SelectionBoxWidth, Mode=OneWay}" Height="{Binding SelectionBoxHeight, Mode=OneWay}"
                               IsHitTestVisible="False" Visibility="{Binding IsSelectionBoxVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Stroke" Value="#3498DB"/>
                                <Setter Property="Fill" Value="#303498DB"/>
                                <Setter Property="StrokeThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCrossingSelection, Mode=OneWay}" Value="True">
                                        <Setter Property="Stroke" Value="#27AE60"/>
                                        <Setter Property="Fill" Value="#3027AE60"/>
                                        <Setter Property="StrokeDashArray" Value="4,3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                </Canvas>
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#EAF2F8" CornerRadius="5" Padding="6,4"><StackPanel Orientation="Horizontal"><TextBlock Text="범례" FontSize="11" VerticalAlignment="Center"/><ContentControl Style="{StaticResource HelpIconStyle}" Tag="노드 색&#x0a;회색: EndPoint(관 끝)&#x0a;파랑: Inline&#x0a;주황: Elbow&#x0a;보라: Tee&#x0a;빨강: Cross"/></StackPanel></Border>
                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#FFF4D6" BorderBrush="#F0C36D" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,4,4,0" IsHitTestVisible="False"><StackPanel Orientation="Horizontal"><TextBlock Text="현재: " FontWeight="SemiBold"/><TextBlock Text="{Binding InteractionModeText, Mode=OneWay}" FontWeight="Bold" Foreground="#9A5B00"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding NetworkSummary, Mode=OneWay}"/></StackPanel></Border>
                <!-- UI 개편 — 선택 속성 카드. 선택 없으면 숨김. 관경 칸은 선택 관경 전용(동작 변경 A) — 기본 관경은 [배관] 탭.
                     DiameterTextBox 이름·핸들러는 종전 그대로(docs/233 § A, docs/239 § B 키 처리). -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="6" Background="White" BorderBrush="#AFC6D9" BorderThickness="1" CornerRadius="8" Padding="10,8"
                        Visibility="{Binding HasCanvasSelection, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectionSummaryText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource MainTextBrush}"/>
                        <Grid Margin="0,6,0,0" Visibility="{Binding HasSelectedEdges, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="75"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DiameterCaption, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="DiameterTextBox" Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" KeyDown="OnDiameterTextBoxKeyDown" PreviewKeyDown="OnDiameterTextBoxPreviewKeyDown" LostKeyboardFocus="OnDiameterTextBoxLostKeyboardFocus" Text="{Binding DiameterMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                            <TextBlock Grid.Column="2" Text="mm" Margin="4,0" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource CancelButtonStyle}" Command="{Binding SplitEdgeCommand}" Margin="0,0,6,0" ToolTip="선 하나를 골랐을 때 — 나눌 지점을 클릭합니다. Esc로 취소."><StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="ScissorsCutting" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text=" 분할"/></StackPanel></Button>
                            <Button Content="Revit에서 보기" Command="{Binding SelectInRevitCommand}" Style="{StaticResource CancelButtonStyle}" Margin="0,0,6,0" ToolTip="캔버스에서 고른 배관·부속을 Revit 모델에서 선택하고 해당 뷰로 이동합니다. 모델을 생성했거나 가져온 배관만 대상입니다."/>
                            <Button Content="삭제" Style="{StaticResource CancelButtonStyle}" Click="OnDeleteSelectionClick" ToolTip="선택 삭제 (Delete와 같음)"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid></DockPanel></Border>
        <!-- UI 개편 — 우측 아코디언 6섹션(docs/185) → 단계 탭 4개(준비·배관·부속·생성). 탭은 강제 순서 아님, 아무 탭이나 열림.
             파라미터 매핑(밸브 직경·이음관 구경·밸브부관 A/B)은 설정창 "밸브 · 부관" 탭으로 옮기고 여기엔 요약 1줄만. -->
        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="12,12,12,12"><TabControl x:Name="StepTabs" Style="{StaticResource PrimaryTabControlStyle}">
            <TabItem Header="1 준비" Style="{StaticResource PrimaryTabItemStyle}"><ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnPanelPreviewMouseWheel"><StackPanel Margin="0,10,6,4">
                <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><StackPanel>
                    <TextBlock Text="밸브실" Style="{StaticResource SectionHeaderTextBlockStyle}" Margin="0,0,0,6"/>
                    <DockPanel><ContentControl Style="{StaticResource HelpIconStyle}" DockPanel.Dock="Right" Tag="Revit에서 밸브실 외곽 벽체와 기둥을 선택하세요. 기둥은 간섭 확인용 표시입니다 (본체 실선 · 헌치 점선)."/><Button Content="기존 객체 가져오기" Command="{Binding PickOutlineCommand}" Style="{StaticResource PrimaryButtonStyle}"/></DockPanel>
                    <Button Content="가져온 객체 지우기" Command="{Binding ClearOutlineCommand}" Style="{StaticResource CancelButtonStyle}" Margin="0,6,0,10"/>
                    <!-- 밸브실 유형은 외곽 벽체의 DH_Zone에서 읽어 채우고, 배치하는 배관 부재의 DH_Zone에 그대로 기록한다(docs/161). -->
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBlock Text="밸브실 유형" VerticalAlignment="Center" ToolTip="외곽 벽체의 DH_Zone에서 자동으로 읽습니다. 배치하는 관·곱관·T형·밸브의 DH_Zone에 기록하며, 비워 두면 기록하지 않습니다."/><ComboBox Grid.Column="1" ItemsSource="{Binding ValveRoomZones, Mode=OneWay}" SelectedItem="{Binding ValveRoomZone, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}"/></Grid>
                    <!-- 격점상세도 배관재료표용 식별자(docs/131 § B-1). 필수 입력이 아니다. -->
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBlock Text="격점번호" VerticalAlignment="Center" ToolTip="배관재료표(DH_격점번호)에 기록합니다. 밸브실 유형을 고르면 GV-01 같은 기본값이 채워지며, 직접 고치면 유형을 바꿔도 유지됩니다. 비워 두어도 모델은 생성됩니다."/><TextBox Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding JunctionId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/></Grid>
                </StackPanel></Border>
                <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10" Visibility="{Binding HasOutline, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="IN / OUT 포트" Style="{StaticResource SectionHeaderTextBlockStyle}" Margin="0,0,0,4"/>
                        <CheckBox Content="상단벽 기준 이격 (해제 시 하단벽 기준)" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding ArrowFromTop, Mode=TwoWay}" Margin="0,2,0,6"/>
                        <!-- 포트 목록(docs/172 § D-2). IN은 좌측 벽, OUT은 우측 벽. 기본 IN·OUT은 CanRemove=false라 × 숨김. -->
                        <ItemsControl ItemsSource="{Binding Ports, Mode=OneWay}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="24"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label, Mode=OneWay}" VerticalAlignment="Center" Foreground="{Binding Color, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding OffsetMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                                    <TextBlock Grid.Column="2" Text="mm" Margin="4,0" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource IconButtonStyle}" Grid.Column="3" Padding="0" Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="포트 삭제 (기본 IN·OUT은 지울 수 없습니다)"
                                            Command="{Binding DataContext.RemovePortCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="13" Height="13" Foreground="{StaticResource ErrorTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Button Content="+ IN" Command="{Binding AddInPortCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" Padding="10,3"/>
                            <Button Content="+ OUT" Command="{Binding AddOutPortCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="10,3"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- 추천 배치·기존 배관 가져오기 = 둘 다 "캔버스 초기 내용 채우기" → 한 상자에 선택지로 -->
                <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><StackPanel>
                    <TextBlock Text="시작 배관" Style="{StaticResource SectionHeaderTextBlockStyle}" Margin="0,0,0,6"/>
                    <!-- 추천 배치(docs/172 § C-11). 외곽이 없거나 유형에 프리셋이 없으면 비활성. -->
                    <Button Content="추천 배치 적용" Command="{Binding ApplyTemplateCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding TemplateHint, Mode=OneWay}" Foreground="{StaticResource TextSubBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <DockPanel><ContentControl Style="{StaticResource HelpIconStyle}" DockPanel.Dock="Right" Tag="이미 모델링된 배관을 선택하면 캔버스에 다시 그립니다. 지금 그려 둔 배관은 대체되며, Ctrl+Z로 되돌릴 수 있습니다."/><Button Content="기존 배관 가져오기…" Command="{Binding PickPipingCommand}" Style="{StaticResource PrimaryButtonStyle}"/></DockPanel>
                    <TextBlock Text="둘 중 하나로 시작하거나, 툴바 [그리기]로 직접 그립니다." Foreground="{StaticResource TextSubBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel></Border>
            </StackPanel></ScrollViewer></TabItem>

            <TabItem Header="2 배관" Style="{StaticResource PrimaryTabItemStyle}"><ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnPanelPreviewMouseWheel"><StackPanel Margin="0,10,6,4">
                <TextBlock Text="여기 값은 새로 그릴 관과 모델 생성 기본값입니다. 이미 그린 관의 관경은 캔버스에서 골라 속성 카드에서 고칩니다." Foreground="{StaticResource TextSubBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><StackPanel>
                    <TextBlock Text="관경 · 관종" Style="{StaticResource SectionHeaderTextBlockStyle}" Margin="0,0,0,6"/>
                    <!-- 동작 변경 A — 기본 관경 전용 칸(DefaultDiameterMm). 선택 관경은 캔버스 속성 카드. 곡관·이형관·밸브 직경까지 구동. -->
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="기본 관경" VerticalAlignment="Center"/><TextBox Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding DefaultDiameterMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Grid.Column="2" Text="mm" Margin="4,0" VerticalAlignment="Center"/></Grid>
                    <!-- 관종은 DH_관종과 직관·단관의 DH_비고(관 재료 코드)를 구동한다(docs/141 § B). -->
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="관종" VerticalAlignment="Center" ToolTip="DH_관종에 기록하고, 직관·단관의 DH_비고에 관 재료 코드(DCIP·SP·PE·PVC)를 자동으로 적습니다."/><StackPanel Grid.Column="1" Orientation="Horizontal"><RadioButton Content="주철관" GroupName="PipeLayoutMaterial" Tag="6,0,0,6" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding IsDuctileIronSelected, Mode=TwoWay}"/><RadioButton Content="강관" GroupName="PipeLayoutMaterial" Tag="0,6,6,0" Margin="-1,0,0,0" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding IsSteelSelected, Mode=TwoWay}"/></StackPanel></Grid>
                    <!-- 관 등급 — 직관·단관 단위중량(DH_무게) 조회와 DH_관종등급(docs/260 § C). -->
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBlock Text="관 등급" VerticalAlignment="Center" ToolTip="직관·단관 단위중량(DH_무게) 조회 등급이며 DH_관종등급에 기록됩니다. 강관 '자동'은 DN≤300 STWW 290, 그 밖 STWW 400 A입니다."/><ComboBox Grid.Column="1" ItemsSource="{Binding PipeKindLabels, Mode=OneWay}" SelectedItem="{Binding PipeKindLabel, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}"/></Grid>
                    <!-- 강관 밸브부관 등급(docs/256). 강관일 때만 보인다(docs/263 § C). -->
                    <Grid Margin="0,0,0,8" Visibility="{Binding IsSteelFittingClassEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBlock Text="강관 등급" VerticalAlignment="Center" ToolTip="강관 밸브부관 규격 등급(KS D 3578 F12/F15/F20). 등급별 규격 범위를 벗어난 주관의 바이패스 세트는 만들지 않습니다."/><ComboBox Grid.Column="1" ItemsSource="{Binding SteelFittingClassLabels, Mode=OneWay}" SelectedItem="{Binding SteelFittingClassLabel, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}"/></Grid>
                    <!-- 접합 종류 → 부재명 표기(2F·2S)·접합 개소 매개변수(docs/170 § E). 패밀리 자체 파라미터가 우선. -->
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBlock Text="접합 종류" VerticalAlignment="Center" ToolTip="부재명 앞에 2F·2S 표기를 붙이고, 관종과 함께 접합 개소를 어느 매개변수에 적을지 정합니다(강관+소켓=용접합수, 주철관+소켓=KP접합수, 플랜지=플랜지접합수). 패밀리가 접합 형식을 자체 매개변수로 갖고 있으면 그 값이 우선합니다."/><ComboBox Grid.Column="1" ItemsSource="{Binding JointConnectionLabels, Mode=OneWay}" SelectedItem="{Binding JointConnectionLabel, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}"/></Grid>
                </StackPanel></Border>
                <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><StackPanel>
                    <TextBlock Text="높이" Style="{StaticResource SectionHeaderTextBlockStyle}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="지정 방식" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><RadioButton Content="상대값" GroupName="PipeLayoutElevationMode" Tag="6,0,0,6" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding IsRelativeElevation, Mode=TwoWay}"/><RadioButton Content="절대값" GroupName="PipeLayoutElevationMode" Tag="0,6,6,0" Margin="-1,0,0,0" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding IsAbsoluteElevation, Mode=TwoWay}"/></StackPanel></Grid>
                    <StackPanel Visibility="{Binding IsRelativeElevation, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="기준 레벨" VerticalAlignment="Center" ToolTip="EL과 레벨 높이는 내부 원점 기준입니다. Revit 레벨 태그 값(프로젝트 기준점 기준)과 다를 수 있습니다."/><ComboBox Grid.Column="1" ItemsSource="{Binding Levels, Mode=OneWay}" SelectedItem="{Binding ElevationLevel, Mode=TwoWay}" DisplayMemberPath="DisplayLabel" Style="{StaticResource PrimaryComboBoxStyle}"/></Grid>
                        <TextBlock Text="{Binding ElevationLevelHint, Mode=OneWay}" Visibility="{Binding IsElevationLevelHintVisible, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="11" Foreground="{StaticResource TextSubBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="레벨로부터 Offset" VerticalAlignment="Center"/><TextBox Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding ElevationOffsetMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True, StringFormat={}{0:0.#}}"/><TextBlock Grid.Column="2" Text="mm" Margin="4,0" VerticalAlignment="Center"/></Grid>
                        <StackPanel Orientation="Horizontal" ToolTip="EL과 레벨 높이는 내부 원점 기준입니다. Revit 레벨 태그 값(프로젝트 기준점 기준)과 다를 수 있습니다."><TextBlock Text="관 중심 EL = " Foreground="{StaticResource TextSubBrush}"/><TextBlock Text="{Binding ElevationM, Mode=OneWay, StringFormat={}{0:0.###} m}" Foreground="{StaticResource TextSubBrush}"/></StackPanel>
                    </StackPanel>
                    <Grid Visibility="{Binding IsAbsoluteElevation, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="관 중심 높이(EL)" VerticalAlignment="Center" ToolTip="EL과 레벨 높이는 내부 원점 기준입니다. Revit 레벨 태그 값(프로젝트 기준점 기준)과 다를 수 있습니다."/><TextBox Grid.Column="1" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding ElevationM, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True, StringFormat={}{0:0.###}}"/><TextBlock Grid.Column="2" Text="m" Margin="4,0" VerticalAlignment="Center"/></Grid>
                </StackPanel></Border>
                <Button Command="{Binding DrawModeCommand}" Style="{StaticResource PrimaryButtonStyle}"><StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="VectorPolyline" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text=" 그리기 시작" VerticalAlignment="Center"/></StackPanel></Button>
            </StackPanel></ScrollViewer></TabItem>

            <TabItem Header="3 부속" Style="{StaticResource PrimaryTabItemStyle}"><ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnPanelPreviewMouseWheel"><StackPanel Margin="0,10,6,4">
                <!-- 밸브·이음관·바이패스 = 모두 "선 위 클릭해 놓기" → 한 탭, 칸 전환. 칸 선택은 화면 상태만(VM 무관). -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton x:Name="FittingToolValve" GroupName="PipeLayoutFittingTool" Tag="6,0,0,6" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="True"><StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="Valve" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text=" 밸브" VerticalAlignment="Center"/></StackPanel></RadioButton>
                    <RadioButton x:Name="FittingToolJoint" GroupName="PipeLayoutFittingTool" Tag="0,0,0,0" Margin="-1,0,0,0" Style="{StaticResource SegmentRadioButtonStyle}"><StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="PipeDisconnected" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text=" 이음관" VerticalAlignment="Center"/></StackPanel></RadioButton>
                    <RadioButton x:Name="FittingToolBypass" GroupName="PipeLayoutFittingTool" Tag="0,6,6,0" Margin="-1,0,0,0" Style="{StaticResource SegmentRadioButtonStyle}"><StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="SourceBranch" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text=" 바이패스" VerticalAlignment="Center"/></StackPanel></RadioButton>
                </StackPanel>
                <!-- 밸브 -->
                <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10" Visibility="{Binding IsChecked, ElementName=FittingToolValve, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
                    <TextBlock Text="밸브 패밀리 (배관 밸브류)" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding ValveFamilyNames, Mode=OneWay}" SelectedValue="{Binding SelectedValveFamilyName, Mode=TwoWay}" SelectedValuePath="Name" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,0">
                        <ComboBox.ItemTemplate><DataTemplate>
                            <TextBlock Text="{Binding Name, Mode=OneWay}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsDiameterMatched, Mode=OneWay}" Value="True"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#1E8449"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="관경과 같은 DN 패밀리는 굵게 표시됩니다." FontSize="11" Foreground="{StaticResource TextSubBrush}" Margin="0,2,0,6"/>
                    <!-- 동작 변경 B — IsEnabled=IsDrawMode 제거. 유형 고르면 VM이 그리기 모드로 바꿔 바로 배치. -->
                    <TextBlock Text="유형 — 고르면 바로 배치 모드 (선 위 클릭)" FontWeight="SemiBold"/>
                    <ListBox Style="{StaticResource PrimaryListBoxStyle}" ItemsSource="{Binding FamilyTypeNames, Mode=OneWay}" SelectedItem="{Binding SelectedFamilyTypeName, Mode=TwoWay}" Height="90" Margin="0,4,0,6">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource FamilyTypeNameToTypeNameConverter}, Mode=OneWay}"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding ValveTypeDiameterText, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#7F8C8D"/><Style.Triggers><DataTrigger Binding="{Binding IsValveTypeDiameterMismatch, Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="#B03A2E"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <!-- 매핑값 요약 — 편집은 설정창 "밸브 · 부관" 탭 -->
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSubBrush}" TextWrapping="Wrap">
                        <Run Text="직경 파라미터: "/><Run Text="{Binding ValveDiameterParameterName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  유형 확인: "/><Run Text="{Binding ValveTypeDiameterParameterName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  "/><Hyperlink Click="OnOpenFittingSettingsClick">설정에서 변경</Hyperlink>
                    </TextBlock>
                </StackPanel></Border>
                <!-- 이음관 — 밸브처럼 선 위 클릭(docs/175 § C-3). 밸브 근처(50mm)면 생성기가 밸브 커넥터에 밀착(§ D-2). -->
                <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10" Visibility="{Binding IsChecked, ElementName=FittingToolJoint, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
                    <TextBlock Text="이음관 패밀리 (배관 이음쇠)" FontWeight="SemiBold"/>
                    <TextBlock Text="이음관 패밀리를 찾지 못했습니다. 패밀리명에 '이음관'이 든 배관 이음쇠를 프로젝트에 불러오세요." Foreground="{StaticResource ErrorTextBrush}" FontSize="11" TextWrapping="Wrap" Visibility="{Binding HasNoJointFamily, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ComboBox ItemsSource="{Binding JointFamilyNames, Mode=OneWay}" SelectedItem="{Binding SelectedJointFamilyName, Mode=TwoWay}" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,8"/>
                    <TextBlock Text="유형 — 고르면 바로 배치 모드 (선 위 클릭)" FontWeight="SemiBold"/>
                    <ListBox Style="{StaticResource PrimaryListBoxStyle}" ItemsSource="{Binding JointTypeNames, Mode=OneWay}" SelectedItem="{Binding SelectedJointFamilyTypeName, Mode=TwoWay}" Height="70" Margin="0,4,0,6">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource FamilyTypeNameToTypeNameConverter}, Mode=OneWay}"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="밸브 옆 50mm 안에 찍으면 밸브 커넥터에 밀착됩니다." FontSize="11" Foreground="{StaticResource TextSubBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSubBrush}" TextWrapping="Wrap">
                        <Run Text="구경 파라미터: "/><Run Text="{Binding JointDiameterParameterName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  "/><Hyperlink Click="OnOpenFittingSettingsClick">설정에서 변경</Hyperlink>
                    </TextBlock>
                </StackPanel></Border>
                <!-- 바이패스 세트(docs/228 § B) — 본관 위 클릭 → A 2 · B 2 · 바이패스 밸브 한 세트. 본관 밸브는 세트 아님(docs/230). -->
                <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10" Visibility="{Binding IsChecked, ElementName=FittingToolBypass, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
                    <!-- docs/255 § D-2 — 밸브 개수. 2개면 V1–단관–V2. 목록 ⋯ [위 밸브 설정 적용]으로 기존 세트에도 넣음. -->
                    <TextBlock Text="밸브 개수" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                        <RadioButton x:Name="BypassValveCountOne" GroupName="BypassValveCount" Content="1개" IsChecked="{Binding IsBypassSingleValve, Mode=TwoWay}" Margin="0,0,16,0"/>
                        <RadioButton x:Name="BypassValveCountTwo" GroupName="BypassValveCount" Content="2개 (사이 단관)" IsChecked="{Binding IsBypassTwoValves, Mode=TwoWay}"/>
                    </StackPanel>
                    <TextBlock Text="밸브 1 패밀리 (선 시작 쪽)" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding ValveFamilyNames, Mode=OneWay}" SelectedValue="{Binding BypassValveFamilyName, Mode=TwoWay}" SelectedValuePath="Name" DisplayMemberPath="Name" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,6"/>
                    <StackPanel Visibility="{Binding IsBypassTwoValves, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="밸브 2 패밀리 (선 끝 쪽)" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding ValveFamilyNames, Mode=OneWay}" SelectedValue="{Binding BypassSecondValveFamilyName, Mode=TwoWay}" SelectedValuePath="Name" DisplayMemberPath="Name" Style="{StaticResource PrimaryComboBoxStyle}" Margin="0,4,0,6"/>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="밸브 사이 단관 길이" FontWeight="SemiBold"/><ContentControl Style="{StaticResource HelpIconStyle}" Tag="0 = 두 밸브 직결. 1~9mm는 넣을 수 없습니다(관 최소 10mm). 밸브 2 직경 파라미터는 설정창 밸브 칸의 패밀리별 값을 씁니다."/></StackPanel>
                        <Grid Margin="0,4,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBox x:Name="BypassSpoolLengthTextBox" Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding BypassSpoolLengthMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Grid.Column="1" Text="mm" Margin="4,0" VerticalAlignment="Center"/></Grid>
                    </StackPanel>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSubBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                        <Run Text="밸브 직경: "/><Run Text="{Binding BypassValveDiameterParameterName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  부관 A: "/><Run Text="{Binding ValveTeeFamilyTypeName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  부관 B: "/><Run Text="{Binding ValveBendFamilyTypeName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  "/><Hyperlink Click="OnOpenFittingSettingsClick">설정에서 변경</Hyperlink>
                    </TextBlock>
                    <DockPanel><ContentControl Style="{StaticResource HelpIconStyle}" DockPanel.Dock="Right" Tag="본관 위를 클릭하면 그 점을 중심으로 밸브부관 A 2개 · 밸브부관 B 2개 · 바이패스 밸브를 넣습니다. A–A 사이는 관으로 이어지며, 본관 밸브는 [밸브]로 그 자리에 놓으면 됩니다. 캔버스 그림은 개략이고, 실제 자리는 모델 생성 때 커넥터를 재서 맞춥니다.&#x0a;&#x0a;커서가 있는 쪽으로 바이패스를 뺍니다. 바이패스 관경·밸브 유형은 모델 생성 때 정합니다."/><Button Content="{Binding BypassPlacementButtonText, Mode=OneWay}" Command="{Binding ToggleBypassPlacementCommand}" Style="{StaticResource PrimaryButtonStyle}"/></DockPanel>
                </StackPanel></Border>
                <!-- 종전 목록 2개(바이패스 세트 / 밸브·이음관) → 하나. InlineFittings에 세트도 들어 있음(RefreshFittings). 필터는 code-behind 별도 뷰 — 캔버스 ItemsControl엔 영향 없음.
                     행 동작(삭제·뒤집기·순서·적용)은 ⋯ 메뉴로 — 버튼 4개로 이름 잘리던 문제. -->
                <TextBlock Text="배치된 부속" Style="{StaticResource SectionHeaderTextBlockStyle}" Margin="0,0,0,6"/>
                <WrapPanel Margin="0,0,0,6">
                    <RadioButton x:Name="FittingFilterAll" GroupName="PipeLayoutFittingFilter" Content="전체" Tag="6,0,0,6" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="True" Checked="OnFittingFilterChecked"/>
                    <RadioButton x:Name="FittingFilterValve" GroupName="PipeLayoutFittingFilter" Content="밸브" Tag="0,0,0,0" Margin="-1,0,0,0" Style="{StaticResource SegmentRadioButtonStyle}" Checked="OnFittingFilterChecked"/>
                    <RadioButton x:Name="FittingFilterJoint" GroupName="PipeLayoutFittingFilter" Content="이음관" Tag="0,0,0,0" Margin="-1,0,0,0" Style="{StaticResource SegmentRadioButtonStyle}" Checked="OnFittingFilterChecked"/>
                    <RadioButton x:Name="FittingFilterBypass" GroupName="PipeLayoutFittingFilter" Content="바이패스" Tag="0,6,6,0" Margin="-1,0,0,0" Style="{StaticResource SegmentRadioButtonStyle}" Checked="OnFittingFilterChecked"/>
                </WrapPanel>
                <ListBox x:Name="FittingList" Style="{StaticResource PrimaryListBoxStyle}" Height="180"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="3">
                    <Button Content="⋯" Style="{StaticResource CancelButtonStyle}" DockPanel.Dock="Right" Padding="8,0" Click="OnOpenContextMenuClick" ToolTip="이 부속 작업">
                        <Button.ContextMenu><ContextMenu>
                            <MenuItem Header="방향 뒤집기" Click="OnFlipBypassClick" Visibility="{Binding IsBypassSet, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <!-- docs/255 § D-4 — 밸브 2개 세트만 V1·V2를 맞바꾼다. -->
                            <MenuItem Header="V1·V2 순서 바꾸기" Click="OnSwapBypassValvesClick" ToolTip="밸브 1(선 시작 쪽)과 밸브 2(선 끝 쪽)의 자리를 맞바꿉니다." Visibility="{Binding HasTwoBypassValves, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <MenuItem Header="위 밸브 설정 적용" Click="OnApplyBypassValvesClick" ToolTip="바이패스 칸에서 고른 밸브 개수·패밀리·단관 길이를 이 세트에 넣습니다. 유형·관경은 모델 생성 때 정합니다." Visibility="{Binding IsBypassSet, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <MenuItem Header="삭제" Click="OnRemoveFittingClick"/>
                        </ContextMenu></Button.ContextMenu>
                    </Button>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding KindBadge, Mode=OneWay}" Foreground="#16A085" FontSize="11" FontWeight="SemiBold" Margin="6,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayOrder, Mode=OneWay}" Width="24" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayName, Mode=OneWay}" ToolTip="{Binding DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
            </StackPanel></ScrollViewer></TabItem>

            <TabItem Header="4 생성" Style="{StaticResource PrimaryTabItemStyle}"><ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnPanelPreviewMouseWheel"><StackPanel Margin="0,10,6,4">
                <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><StackPanel>
                    <TextBlock Text="생성 전 점검" Style="{StaticResource SectionHeaderTextBlockStyle}" Margin="0,0,0,6"/>
                    <!-- 오류(생성 차단) + "경고:" 접두 경고. 비면 통과 표시. 내용은 하단 상태줄과 같은 ValidationSummary -->
                    <TextBlock Foreground="#1E8449" FontWeight="SemiBold">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ValidationSummary, Mode=OneWay}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        <InlineUIContainer BaselineAlignment="Center"><iconPacks:PackIconMaterial Kind="CheckCircle" Width="13" Height="13" Foreground="#1E8449"/></InlineUIContainer><Run Text=" 오류 · 경고 없음"/>
                    </TextBlock>
                    <TextBox Text="{Binding ValidationSummary, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Foreground="{StaticResource ErrorTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel></Border>
                <!-- 종전 하단 작은 글씨 + 툴팁에만 있던 ElementId 끊김 경고(docs/235 § C)를 상자로 -->
                <Border Background="#FFF4D6" BorderBrush="#F0C36D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10" Visibility="{Binding HasReplaceTarget, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
                    <TextBlock Text="⚠ 기존 부재 교체" FontWeight="SemiBold" Foreground="#9A5B00" Margin="0,0,0,4"/>
                    <TextBlock Text="가져온 원본 또는 이 창에서 직전에 생성한 부재를 모두 지우고 캔버스 내용대로 다시 만듭니다. ElementId가 바뀌므로 기존 태그·치수 참조는 끊깁니다. Revit에서 Ctrl+Z 한 번으로 생성과 삭제가 함께 취소됩니다." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MainTextBrush}"/>
                </StackPanel></Border>
                <Button Content="모델 생성" Command="{Binding CreateModelCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,12"/>
                <!-- docs/301 — 수직분기. Revit 모델 부속 +Z 커넥터 기준 작업이라 캔버스 그리기 단계가 아님 → 생성 후 작업 -->
                <Border Background="#F7F9FB" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"><StackPanel>
                    <TextBlock Text="생성 후 작업" Style="{StaticResource SectionHeaderTextBlockStyle}" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,6"><ContentControl Style="{StaticResource HelpIconStyle}" DockPanel.Dock="Right" Tag="+Z 커넥터가 있는 부속을 선택해 위로 쌓습니다. 캔버스 배관망과는 별도 요소입니다."/><Button Content="수직분기 추가…" Command="{Binding AddVerticalBranchCommand}" Style="{StaticResource PrimaryButtonStyle}"/></DockPanel>
                    <TextBlock Text="{Binding VerticalBranchLastResult, Mode=OneWay}" Foreground="{StaticResource MainTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel></Border>
            </StackPanel></ScrollViewer></TabItem>
        </TabControl></Border>
        </Grid>
        <Grid Grid.Row="2" Margin="20,0,20,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><!-- 안내·검증 문구가 길어져도 행 높이가 늘지 않게 최대 높이 + 세로 스크롤로 가둔다. 복사할 수 있게 읽기 전용 TextBox로 둔다(2026-09-28 사용자 요청). -->
            <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center" Margin="0,0,12,0"><StackPanel>
                <TextBox Text="{Binding Status, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Foreground="{StaticResource MainTextBrush}" TextWrapping="Wrap"/>
                <TextBox Text="{Binding ValidationSummary, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Foreground="{StaticResource ErrorTextBrush}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel></ScrollViewer>
            <!-- UI 개편 — 편집 도구는 캔버스 툴바, Revit에서 보기는 선택 카드, 교체 경고는 [생성] 탭으로 옮김. 여기엔 생성·닫기만. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="모델 생성" Command="{Binding CreateModelCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="닫기" Style="{StaticResource CancelButtonStyle}" Command="{Binding CloseCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
