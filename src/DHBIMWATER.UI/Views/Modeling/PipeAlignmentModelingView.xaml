<Window x:Class="DHBIMWATER.UI.Views.Modeling.PipeAlignmentModelingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls" xmlns:converters="clr-namespace:DHBIMWATER.UI.Converters" xmlns:vm="clr-namespace:DHBIMWATER.UI.ViewModels.Modeling" Title="관로 모델링" Width="960" Height="700" MinHeight="640" WindowStartupLocation="CenterScreen" WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic" Background="#F4F7F9">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibility"/>
            <converters:ZDatumDisplayNameConverter x:Key="ZDatumDisplayName"/>
            <converters:EnumEqualsToBrushConverter x:Key="EnumEqualsToBrush"/>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:TitleBar/>
        <Border Grid.Row="1" Background="White" CornerRadius="15" Margin="20,12" Padding="18">
            <TabControl x:Name="PipeAlignmentTabs" Style="{StaticResource PrimaryTabControlStyle}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" IsEnabled="{Binding IsInputEnabled, Mode=OneWay}">
                <TabItem Header="입력·기준점" Tag="Input">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AddKindDropdownButton" Content="파일 추가 ▾" Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="SHP · DWG · DXF · 엑셀 · CSV" Click="AddKindDropdownButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="SHP (관로망)" Command="{Binding AddCommand}" CommandParameter="Shp"/>
                                        <MenuItem Header="DWG · DXF (도면)" Command="{Binding AddCommand}" CommandParameter="Dwg"/>
                                        <MenuItem Header="엑셀 · CSV (측점 좌표)" Command="{Binding AddCommand}" CommandParameter="Excel"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Content="제거" Style="{StaticResource CancelButtonStyle}" Margin="8,0" Command="{Binding RemoveCommand}"/>
                            <TextBlock Margin="18,5,0,0" Foreground="#B26B00" Text="{Binding DiameterUnresolvedCount, StringFormat=⚠ 확정 안 한 표기 {0}건}" ToolTip="확정 안 하면 자동추정값으로 배치" Visibility="{Binding HasDiameterUnresolved, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Margin="18,5,0,0" Foreground="#B26B00" TextWrapping="Wrap"
                                       Text="{Binding SpecUnmatchedCount, StringFormat=⚠ 규격 미매칭 {0}건}"
                                       ToolTip="제원표에 (등급, DN) 행 없음. [규격 매핑]에서 지정하거나 규격표에 행 추가"
                                       Visibility="{Binding HasSpecUnmatched, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" Margin="0,10" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                            <Border Background="White" BorderBrush="#D7E0E7" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10" Visibility="{Binding HasShpFiles, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                            <TextBlock Text="SHP (관로망)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DataGrid x:Name="ShpGrid" ItemsSource="{Binding ShpFiles}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="120" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="파일 (SHP)" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding WarningsDisplay}"/>
                                                        <Setter Property="Foreground" Value="OrangeRed"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="직경 필드(DBF)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding DiameterField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="관종 필드(DBF)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding KindField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" IsReadOnly="True" TextWrapping="Wrap" Height="80" Margin="0,8,0,0"
                                     Text="{Binding SelectedItem.Details, ElementName=ShpGrid, Mode=OneWay}"/>
                            <TextBlock Foreground="#B26B00" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="직경 필드를 &lt;수동&gt;으로 두면 [규격 매핑] 탭에 &quot;(값 없음)&quot; 행이 생깁니다. 거기서 확정 DN을 지정하세요."
                                       Visibility="{Binding SelectedItem.IsManualDiameterEnabled, ElementName=ShpGrid, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelectedItem.ProjectionDetails, ElementName=ShpGrid, Mode=OneWay}"
                                       ToolTip="{Binding SelectedItem.ProjectionToolTip, ElementName=ShpGrid, Mode=OneWay}"/>
                            </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#D7E0E7" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10" Visibility="{Binding HasDwgFiles, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                            <TextBlock Text="DWG · DXF (도면)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DataGrid x:Name="DwgGrid" ItemsSource="{Binding DwgFiles}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="120" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="파일 (DWG·DXF)" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding WarningsDisplay}"/>
                                                        <Setter Property="Foreground" Value="OrangeRed"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="직경 필드(XDATA)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding DiameterField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="관종 필드(XDATA)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding KindField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" IsReadOnly="True" TextWrapping="Wrap" Height="80" Margin="0,8,0,0"
                                     Text="{Binding SelectedItem.Details, ElementName=DwgGrid, Mode=OneWay}"/>
                            <TextBlock Foreground="#B26B00" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="직경 필드를 &lt;수동&gt;으로 두면 [규격 매핑] 탭에 &quot;(값 없음)&quot; 행이 생깁니다. 거기서 확정 DN을 지정하세요."
                                       Visibility="{Binding SelectedItem.IsManualDiameterEnabled, ElementName=DwgGrid, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Margin="0,8,0,3" Text="사용할 폴리선 레이어 (복수 선택 가능)"/>
                            <ListBox ItemsSource="{Binding SelectedItem.LayerOptions, ElementName=DwgGrid, Mode=OneWay}" MaxHeight="100" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource PrimaryCheckBoxStyle}" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#D7E0E7" BorderThickness="1" CornerRadius="6" Padding="10" Visibility="{Binding HasExcelFiles, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                            <TextBlock Text="엑셀 · CSV (측점 좌표)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DataGrid x:Name="ExcelGrid" ItemsSource="{Binding ExcelFiles}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeColumns="False" CanUserSortColumns="False" MinHeight="120" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="파일 (Excel, 시트별)" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*" MinWidth="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding WarningsDisplay}"/>
                                                        <Setter Property="Foreground" Value="OrangeRed"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="매핑 요약" Binding="{Binding ExcelMappingSummary, Mode=OneWay}" IsReadOnly="True" Width="2*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Width="90" MinWidth="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="매핑 편집" Style="{StaticResource PrimaryButtonStyle}"
                                                        Command="{Binding DataContext.EditExcelMappingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock Margin="0,8,0,3" TextWrapping="Wrap" Text="평면 기준점 X·Y (m) — 첫 파일 첫 정점에서 자동 산출"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Width="170" Text="{Binding ReferenceX, StringFormat={}{0:0.00000}}"/>
                                <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Width="170" Margin="8,0" Text="{Binding ReferenceY, StringFormat={}{0:0.00000}}"/>
                            </StackPanel>
                            <CheckBox Content="프로젝트 공유좌표에 기준점 적용" ToolTip="해제 시 문서의 기존 공유좌표, 없으면 원본 좌표" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding ApplySharedCoordinates}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="모델 유형 선택" Tag="OutputMode">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="DirectShape (LOD 100)" IsChecked="{Binding IsDirectShape}" GroupName="Output"/>
                            <RadioButton Content="가변 패밀리 (LOD 300)" Margin="18,0" IsChecked="{Binding IsAdaptive}" GroupName="Output"/>
                            <!-- TODO: 파이프(MEP) 미구현 상태라 임시로 숨김. 구현 완료 시 Visibility="Collapsed" 제거하면 됨. -->
                            <RadioButton Content="파이프 (MEP)" Margin="18,0" IsChecked="{Binding IsPiping}" GroupName="Output" Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock Margin="0,16,0,5" Text="모델 생성 전 Line DirectShape 선형을 먼저 만들고 확인합니다. 미리보기는 유지됩니다."/>
                        <StackPanel Visibility="{Binding UsesStraightAndBendSettings, Converter={StaticResource BoolToVisibility}}">
                            <Border Background="#EEF2F7" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                            <TextBlock Text="관 배치 기준높이" FontWeight="SemiBold" Foreground="#4A6FA5" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" Width="210" VerticalAlignment="Center" ItemsSource="{Binding ZDatums, Mode=OneWay}" SelectedItem="{Binding ZDatum, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ZDatumDisplayName}, Mode=OneWay}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Canvas Width="150" Height="110" Margin="18,0,0,0" IsHitTestVisible="False">
                                    <Ellipse Canvas.Left="5" Canvas.Top="15" Width="80" Height="80" Stroke="#52606A" StrokeThickness="2" Fill="#F7FAFC"/>
                                    <Ellipse Canvas.Left="20" Canvas.Top="30" Width="50" Height="50" Stroke="#7B8790" StrokeThickness="2" Fill="White"/>
                                    <Line X1="5" Y1="55" X2="85" Y2="55" Stroke="#7B8790" StrokeDashArray="3,2"/>
                                    <Line X1="45" Y1="15" X2="45" Y2="95" Stroke="#7B8790" StrokeDashArray="3,2"/>
                                    <Ellipse Canvas.Left="41" Canvas.Top="11" Width="8" Height="8" Fill="{Binding ZDatum, Mode=OneWay, Converter={StaticResource EnumEqualsToBrush}, ConverterParameter=OutsideTop}"/>
                                    <Ellipse Canvas.Left="41" Canvas.Top="26" Width="8" Height="8" Fill="{Binding ZDatum, Mode=OneWay, Converter={StaticResource EnumEqualsToBrush}, ConverterParameter=Crown}"/>
                                    <Ellipse Canvas.Left="41" Canvas.Top="51" Width="8" Height="8" Fill="{Binding ZDatum, Mode=OneWay, Converter={StaticResource EnumEqualsToBrush}, ConverterParameter=Centerline}"/>
                                    <Ellipse Canvas.Left="41" Canvas.Top="76" Width="8" Height="8" Fill="{Binding ZDatum, Mode=OneWay, Converter={StaticResource EnumEqualsToBrush}, ConverterParameter=Invert}"/>
                                    <Ellipse Canvas.Left="41" Canvas.Top="91" Width="8" Height="8" Fill="{Binding ZDatum, Mode=OneWay, Converter={StaticResource EnumEqualsToBrush}, ConverterParameter=OutsideBottom}"/>
                                    <TextBlock Canvas.Left="92" Canvas.Top="7" FontSize="10" Text="외부 맨 위"/>
                                    <TextBlock Canvas.Left="92" Canvas.Top="23" FontSize="10" Text="크라운"/>
                                    <TextBlock Canvas.Left="92" Canvas.Top="48" FontSize="10" Text="중심선"/>
                                    <TextBlock Canvas.Left="92" Canvas.Top="73" FontSize="10" Text="관저고"/>
                                    <TextBlock Canvas.Left="92" Canvas.Top="89" FontSize="10" Text="외부 맨 아래"/>
                                </Canvas>
                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                    <Button Content="관·곡관 설정 열기…" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenPipeSpecsCommand}"
                                            Height="40" Margin="20, 0, 0 ,0"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="배치 간격 (m)" Margin="0,8,0,3"/>
                            <TextBox Text="{Binding IntervalM}" Width="150" HorizontalAlignment="Left" ToolTip="직관 분절 간격. 곡관 자리는 제외">
                                <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource PrimaryTextBoxStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsIntervalHighlighted}" Value="True"><Setter Property="BorderBrush" Value="#E67E22"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
                            </TextBox>
                            <TextBlock Text="이경관 길이(mm)" Margin="0,8,0,3"/>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding ReducerBodyLengthMm}" Width="150" HorizontalAlignment="Left"
                                     ToolTip="DN이 바뀌는 지점에 넣을 이경관 몸통 길이. 실제 제원표 확정 전 임시 입력값입니다."/>
                            </StackPanel>
                            </Border>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#EEF2F7" CornerRadius="8" Padding="14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDirectShape}" Value="True">
                                                <Setter Property="Grid.ColumnSpan" Value="3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            <StackPanel>
                            <TextBlock Text="곡관 설정" FontWeight="SemiBold" Foreground="#4A6FA5" Margin="0,0,0,8" Visibility="{Binding IsAdaptive, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="곡관 접합 판정" FontWeight="SemiBold" Foreground="#4A6FA5" Margin="0,0,0,8" Visibility="{Binding IsDirectShape, Converter={StaticResource BoolToVisibility}}"/>
                            <StackPanel Visibility="{Binding IsAdaptive, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="곡관 패밀리 : 유형 (5점 가변)"/>
                                    <ComboBox x:Name="BendFamilyCombo" ItemsSource="{Binding AdaptiveComponentTypeNames, Mode=OneWay}" SelectedItem="{Binding BendFamilyTypeName, Mode=TwoWay}">
                                        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource PrimaryComboBoxStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsBendFamilyHighlighted}" Value="True"><Setter Property="BorderBrush" Value="#E67E22"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                                    </ComboBox>
                                    <TextBlock Foreground="#B26B00" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding BendPointCountNotice}" Visibility="{Binding HasBendPointCountNotice, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="곡관 파라미터 매핑" FontWeight="SemiBold"/>
                                    <TextBlock Text="호칭지름 DN" Margin="0,8,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding BendParameterOptions, Mode=OneWay}" SelectedItem="{Binding BendDiameterParameterName, Mode=TwoWay}"/>
                                    <TextBlock Text="관 두께 e" Margin="0,8,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding BendParameterOptions, Mode=OneWay}" SelectedItem="{Binding BendWallThicknessParameterName, Mode=TwoWay}"/>
                                    <TextBlock Text="외경 OD" Margin="0,8,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding BendParameterOptions, Mode=OneWay}" SelectedItem="{Binding BendOuterDiameterParameterName, Mode=TwoWay}"/>
                            </StackPanel>
                            <TextBlock Foreground="#B26B00" Text="{Binding SettingsNotice}" TextWrapping="Wrap" Visibility="{Binding IsAdaptive, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="곡관 접합 종류" Margin="0,14,0,3"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}"
                                      ItemsSource="{Binding BendConnectionOptions, Mode=OneWay}"
                                      SelectedItem="{Binding BendConnectionOption, Mode=TwoWay}"
                                      ToolTip="플랜지곡관은 45°·90°만 있고 조인트 허용굴곡이 0°이므로 미해결이 크게 늘 수 있음"/>
                            <TextBlock Text="곡관 형식" Margin="0,10,0,3"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}"
                                      ItemsSource="{Binding BendFormOptions, Mode=OneWay}"
                                      SelectedItem="{Binding BendFormOption, Mode=TwoWay}"
                                      ToolTip="A형은 양쪽 소켓(s=0, 양쪽 Joint θ₁+θ₂), B형은 한쪽 소켓(s=200, 한쪽 Joint). 소켓·플랜지 공통"/>
                            </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#EEF2F7" CornerRadius="8" Padding="14" Visibility="{Binding IsAdaptive, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                            <TextBlock Text="직관 설정" FontWeight="SemiBold" Foreground="#4A6FA5" Margin="0,0,0,8"/>
                            <TextBlock Text="직관 패밀리 : 유형 (2점 가변)"/>
                            <ComboBox x:Name="StraightFamilyCombo" ItemsSource="{Binding AdaptiveComponentTypeNames, Mode=OneWay}" SelectedItem="{Binding StraightFamilyTypeName, Mode=TwoWay}">
                                <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource PrimaryComboBoxStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsStraightFamilyHighlighted}" Value="True"><Setter Property="BorderBrush" Value="#E67E22"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                            </ComboBox>
                            <TextBlock Foreground="#B26B00" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding StraightPointCountNotice}" Visibility="{Binding HasStraightPointCountNotice, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="직관 파라미터 매핑" FontWeight="SemiBold" Margin="0,12,0,0"/>
                            <TextBlock Text="호칭지름 DN" Margin="0,8,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding StraightParameterOptions, Mode=OneWay}" SelectedItem="{Binding StraightDiameterParameterName, Mode=TwoWay}"/>
                            <TextBlock Text="관 두께 e" Margin="0,8,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding StraightParameterOptions, Mode=OneWay}" SelectedItem="{Binding StraightThicknessParameterName, Mode=TwoWay}"/>
                            <TextBlock Text="외경 OD" Margin="0,8,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding StraightParameterOptions, Mode=OneWay}" SelectedItem="{Binding StraightOuterDiameterParameterName, Mode=TwoWay}"/>
                            </StackPanel>
                            </Border>
                            </Grid>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsPiping, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="파이프 시스템"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding PipingSystemTypeNames}" SelectedItem="{Binding PipingSystemTypeName}"/>
                            <TextBlock Margin="0,8,0,0" Text="PipeType"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding PipeTypeNames}" SelectedItem="{Binding PipeTypeName}"/>
                            <TextBlock Text="레벨" Margin="0,12,0,3"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding LevelNames}" SelectedItem="{Binding LevelName}"/>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="규격 매핑" Tag="SpecMapping">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <CheckBox Style="{StaticResource PrimaryCheckBoxStyle}" DockPanel.Dock="Right" Content="해결된 표기도 보기" IsChecked="{Binding ShowResolvedDiameterMappings, Mode=TwoWay}"/>
                            <TextBlock TextWrapping="Wrap" Text="직경 표기 × 관종 표기 → DN·등급 연결. OD·두께는 규격표에서 자동"/>
                        </DockPanel>
                        <Grid Grid.Row="1">
                        <DataGrid x:Name="MappingGrid" ItemsSource="{Binding DiameterMappingsView, Mode=OneWay}" SelectionMode="Extended" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                            <Setter Property="Background" Value="#FFF3CD"/>
                                            <Setter Property="BorderBrush" Value="#E67E22"/>
                                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="원본값" Binding="{Binding RawValue, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="관종 원본값" Binding="{Binding KindRawValue, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="파일" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="건수" Binding="{Binding Count, Mode=OneWay}" IsReadOnly="True" Width="65"/>
                                <DataGridTextColumn Header="자동추정" Binding="{Binding AutoDiameterDisplay, Mode=OneWay}" IsReadOnly="True" Width="80"/>
                                <DataGridTemplateColumn Header="확정 DN" Width="120">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding DataContext.DiameterOptions, Mode=OneWay, RelativeSource={RelativeSource AncestorType=DataGrid}}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedDiameterOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="등급" Width="130">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding DataContext.MappingPipeKinds, Mode=OneWay, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding PipeKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="OD/thk" Binding="{Binding SpecificationDisplay, Mode=OneWay}" IsReadOnly="True" Width="90"/>
                                <DataGridTextColumn Header="상태" Binding="{Binding Status, Mode=OneWay}" IsReadOnly="True" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2E7D32" FontWeight="SemiBold" Text="✔ 모든 직경 표기 해석 완료" Visibility="{Binding HasNoVisibleDiameterMappings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" Width="150" ItemsSource="{Binding MappingPipeKinds, Mode=OneWay}" SelectedItem="{Binding BulkMappingPipeKind, Mode=TwoWay}"/>
                            <Button Grid.Column="1" Content="전체 일괄 적용" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Command="{Binding ApplyBulkMappingCommand}" ToolTip="전 행 적용 — DN은 자동추정값, 등급은 왼쪽 선택값"/>
                            <!-- 관·곡관 규격표 진입점은 [관 · 곡관 설정] 탭 하나로 통일했다(2026-08-20, 중복 진입점 정리). -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Foreground="#B26B00" Text="{Binding DiameterUnresolvedCount, StringFormat=⚠ 확정 안 한 표기 {0}건}" ToolTip="확정 안 하면 자동추정값으로 배치"/>
                                <TextBlock Foreground="#B26B00" Margin="12,0,0,0" Text="{Binding SpecUnmatchedCount, StringFormat=⚠ 규격 미매칭 {0}건}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="선형 방향" Tag="Direction" Visibility="{Binding IsAlignmentDirectionVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Text="[반전] = 정점 순서 뒤집기(좌표 불변). Ctrl·Shift 다중 선택 후 한 행 클릭하면 일괄 적용"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding DirectionRows, Mode=OneWay}" SelectionMode="Extended" AutoGenerateColumns="False" CanUserAddRows="False"
                                  MaxHeight="400" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseLeftButtonDown="DirectionGrid_OnPreviewMouseLeftButtonDown">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="파일" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="레코드" Binding="{Binding RecordNumber, Mode=OneWay}" IsReadOnly="True" Width="80"/>
                                <DataGridTextColumn Header="시작 (X, Y, Z)" Binding="{Binding StartDisplay, Mode=OneWay}" IsReadOnly="True" Width="190"/>
                                <DataGridTextColumn Header="끝 (X, Y, Z)" Binding="{Binding EndDisplay, Mode=OneWay}" IsReadOnly="True" Width="190"/>
                                <DataGridTextColumn Header="정점" Binding="{Binding VertexDisplay, Mode=OneWay}" IsReadOnly="True" Width="60"/>
                                <DataGridTextColumn Header="길이(m)" Binding="{Binding LengthDisplay, Mode=OneWay}" IsReadOnly="True" Width="80"/>
                                <DataGridTemplateColumn Header="반전" Width="60">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <CheckBox Style="{StaticResource PrimaryCheckBoxStyle}" HorizontalAlignment="Center" IsChecked="{Binding IsReversed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#3A6EA5" Text="{Binding ReversedCount, StringFormat=방향 반전 {0}건}"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="진단" Tag="Diagnosis">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="스냅 허용오차(mm)" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Width="70" Margin="8,0" Text="{Binding SnapToleranceMm}"/>
                            <Button Content="진단 실행" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0" Command="{Binding RunCommand}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Margin="0,12,0,6" Text="{Binding Summary}" TextWrapping="Wrap"/>
                        <ScrollViewer Grid.Row="2" MaxHeight="90" Margin="0,0,0,6" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasDiagnosisWarnings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding DiagnosisWarnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Mode=OneWay}" Foreground="#B26B00" TextWrapping="Wrap" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <DataGrid Grid.Row="3" ItemsSource="{Binding Attention}" IsReadOnly="True" AutoGenerateColumns="False"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="절점" Binding="{Binding NodeId}"/>
                                <DataGridTextColumn Header="종류" Binding="{Binding Kind}"/>
                                <DataGridTextColumn Header="곡관판정" Binding="{Binding BendResolution}"/>
                                <DataGridTextColumn Header="X(m)" Binding="{Binding X, StringFormat=0.###}"/>
                                <DataGridTextColumn Header="Y(m)" Binding="{Binding Y, StringFormat=0.###}"/>
                                <DataGridTextColumn Header="Z(m)" Binding="{Binding Z, StringFormat=0.###}"/>
                                <DataGridTextColumn Header="편각(°)" Binding="{Binding DeflectionDeg, StringFormat=0.##}"/>
                                <DataGridTextColumn Header="직경(mm)" Binding="{Binding MaxDiameterMm, StringFormat=0.#}"/>
                                <DataGridTextColumn Header="관종" Binding="{Binding PipeKind}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
        <Grid Grid.Row="2" Margin="20,0,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
                <StackPanel Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="{Binding PhaseText, Mode=OneWay}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ProgressDetail, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#52606A"/>
                    </Grid>
                    <ProgressBar Style="{StaticResource PrimaryProgressBarStyle}" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"/>
                </StackPanel>
                <Border Margin="0,8,0,0" Padding="10" Background="#E8F1FF" CornerRadius="6"
                        Visibility="{Binding IsAwaitingPreviewConfirm, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding PreviewConfirmMessage, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="미리보기 유지·중단" Style="{StaticResource CancelButtonStyle}"
                                    Command="{Binding CancelPreviewCommand}" Margin="0,0,8,0"/>
                            <Button Content="계속 생성" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ConfirmPreviewCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Margin="0,8,0,0" Padding="10" Background="#FFF8E8" CornerRadius="6"
                        Visibility="{Binding HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ResultSummary, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <ScrollViewer MaxHeight="110" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ResultWarnings, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Mode=OneWay}" Foreground="#B26B00" TextWrapping="Wrap" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <Border Margin="0,8,0,0" Padding="10" Background="#FFF8E8" CornerRadius="6"
                        Visibility="{Binding HasPreflightIssues, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="모델 생성 전 확인"/>
                        <ItemsControl ItemsSource="{Binding PreflightIssues, Mode=OneWay}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2,0,0">
                                        <Hyperlink Foreground="#B26B00" TextDecorations="Underline" Command="{Binding DataContext.NavigatePreflightIssueCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                            <Run Text="{Binding Message, Mode=OneWay}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="닫기" Style="{StaticResource CancelButtonStyle}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                <Button Content="모델 생성" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateCommand}"
                        IsEnabled="{Binding CanCreateModel, Mode=OneWay}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
