<Window x:Class="DHBIMWATER.UI.Views.Modeling.PipeAlignmentModelingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:converters="clr-namespace:DHBIMWATER.UI.Converters" xmlns:vm="clr-namespace:DHBIMWATER.UI.ViewModels.Modeling" Title="관로 모델링" Width="960" Height="920" MinHeight="760" WindowStartupLocation="CenterScreen" WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic" Background="#F4F7F9">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibility"/>
            <converters:ZDatumDisplayNameConverter x:Key="ZDatumDisplayName"/>
            <converters:EnumEqualsToBrushConverter x:Key="EnumEqualsToBrush"/>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:TitleBar/>
        <Border Grid.Row="1" Background="White" CornerRadius="15" Margin="20,12" Padding="18">
            <TabControl x:Name="PipeAlignmentTabs" Style="{StaticResource PrimaryTabControlStyle}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" IsEnabled="{Binding IsInputEnabled, Mode=OneWay}">
                <TabItem Header="입력·기준점" Tag="Input">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <!-- SHP·DWG 입력 보류(docs/226 § A, 2026-09-28). 재개 시 아래 ContextMenu와 code-behind AddKindDropdownButton_Click을 복원
                                 (버튼: x:Name="AddKindDropdownButton" Content="파일 추가 ▾" Click="AddKindDropdownButton_Click").
                                 AddKindDropdownButton_Click은 ContextMenu.DataContext = button.DataContext, PlacementTarget = button, Placement = Bottom, IsOpen = true.
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="SHP (관로망)" Command="{Binding AddCommand}" CommandParameter="Shp"/>
                                        <MenuItem Header="DWG · DXF (도면)" Command="{Binding AddCommand}" CommandParameter="Dwg"/>
                                        <MenuItem Header="엑셀 · CSV (측점 좌표)" Command="{Binding AddCommand}" CommandParameter="Excel"/>
                                    </ContextMenu>
                                </Button.ContextMenu> -->
                            <Button Content="파일 추가" Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="엑셀 · CSV (측점 좌표)" Command="{Binding AddCommand}" CommandParameter="Excel"/>
                            <Button Content="제거" Style="{StaticResource CancelButtonStyle}" Margin="8,0" Command="{Binding RemoveCommand}"/>
                            <TextBlock Margin="18,5,0,0" Foreground="#B26B00" Text="{Binding DiameterUnresolvedCount, StringFormat=⚠ 확정 안 한 표기 {0}건}" ToolTip="확정 안 하면 자동추정값으로 배치" Visibility="{Binding HasDiameterUnresolved, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Margin="18,5,0,0" Foreground="#B26B00" TextWrapping="Wrap"
                                       Text="{Binding SpecUnmatchedCount, StringFormat=⚠ 규격 미매칭 {0}건}"
                                       ToolTip="제원표에 (등급, DN) 없음 → [규격 매핑] 지정 또는 규격표 행 추가"
                                       Visibility="{Binding HasSpecUnmatched, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" Margin="0,10" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                            <Border Background="White" BorderBrush="#D7E0E7" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10" Visibility="{Binding HasShpFiles, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                            <TextBlock Text="SHP (관로망)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DataGrid Style="{StaticResource PrimaryDataGridStyle}" x:Name="ShpGrid" ItemsSource="{Binding ShpFiles}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="120" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="파일 (SHP)" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding WarningsDisplay}"/>
                                                        <Setter Property="Foreground" Value="OrangeRed"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="직경 필드(DBF)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding DiameterField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="관종 필드(DBF)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding KindField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" IsReadOnly="True" TextWrapping="Wrap" Height="80" Margin="0,8,0,0"
                                     Text="{Binding SelectedItem.Details, ElementName=ShpGrid, Mode=OneWay}"/>
                            <TextBlock Foreground="#B26B00" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="직경 필드 &lt;수동&gt; → [규격 매핑] &quot;(값 없음)&quot; 행에서 DN 지정"
                                       Visibility="{Binding SelectedItem.IsManualDiameterEnabled, ElementName=ShpGrid, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelectedItem.ProjectionDetails, ElementName=ShpGrid, Mode=OneWay}"
                                       ToolTip="{Binding SelectedItem.ProjectionToolTip, ElementName=ShpGrid, Mode=OneWay}"/>
                            </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#D7E0E7" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10" Visibility="{Binding HasDwgFiles, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                            <TextBlock Text="DWG · DXF (도면)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DataGrid Style="{StaticResource PrimaryDataGridStyle}" x:Name="DwgGrid" ItemsSource="{Binding DwgFiles}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="120" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="파일 (DWG·DXF)" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding WarningsDisplay}"/>
                                                        <Setter Property="Foreground" Value="OrangeRed"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="직경 필드(XDATA)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding DiameterField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="관종 필드(XDATA)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding KindField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" IsReadOnly="True" TextWrapping="Wrap" Height="80" Margin="0,8,0,0"
                                     Text="{Binding SelectedItem.Details, ElementName=DwgGrid, Mode=OneWay}"/>
                            <TextBlock Foreground="#B26B00" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="직경 필드 &lt;수동&gt; → [규격 매핑] &quot;(값 없음)&quot; 행에서 DN 지정"
                                       Visibility="{Binding SelectedItem.IsManualDiameterEnabled, ElementName=DwgGrid, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Margin="0,8,0,3" Text="사용할 폴리선 레이어 (복수 선택 가능)"/>
                            <ListBox Style="{StaticResource PrimaryListBoxStyle}" ItemsSource="{Binding SelectedItem.LayerOptions, ElementName=DwgGrid, Mode=OneWay}" MaxHeight="100" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource PrimaryCheckBoxStyle}" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#D7E0E7" BorderThickness="1" CornerRadius="6" Padding="10" Visibility="{Binding HasExcelFiles, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                            <TextBlock Text="엑셀 · CSV (측점 좌표)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DataGrid Style="{StaticResource PrimaryDataGridStyle}" x:Name="ExcelGrid" ItemsSource="{Binding ExcelFiles}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeColumns="False" CanUserSortColumns="False" MinHeight="120" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="파일 (Excel, 시트별)" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*" MinWidth="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding WarningsDisplay}"/>
                                                        <Setter Property="Foreground" Value="OrangeRed"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="매핑 요약" Binding="{Binding ExcelMappingSummary, Mode=OneWay}" IsReadOnly="True" Width="2*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- 행 높이 35·셀 여백 12,8 안에 PrimaryButtonStyle(여백 15,8)이 안 들어가 잘리던 문제(2026-09-22): 열 폭·셀 여백·버튼 여백을 줄여 맞춘다. -->
                                    <DataGridTemplateColumn Width="110" MinWidth="110">
                                        <DataGridTemplateColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                <Setter Property="Padding" Value="6,2"/>
                                            </Style>
                                        </DataGridTemplateColumn.CellStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="매핑 편집" Style="{StaticResource PrimaryButtonStyle}" Padding="10,3"
                                                        Command="{Binding DataContext.EditExcelMappingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock Margin="0,8,0,3" TextWrapping="Wrap" Text="평면 기준점 X·Y (m) · 첫 정점 자동"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Width="170" Text="{Binding ReferenceX, StringFormat={}{0:0.00000}}"/>
                                <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Width="170" Margin="8,0" Text="{Binding ReferenceY, StringFormat={}{0:0.00000}}"/>
                            </StackPanel>
                            <CheckBox Content="프로젝트 공유좌표에 기준점 적용" ToolTip="해제 시 문서의 기존 공유좌표, 없으면 원본 좌표" Style="{StaticResource PrimaryCheckBoxStyle}" IsChecked="{Binding ApplySharedCoordinates}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="모델 유형 선택" Tag="OutputMode">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource PrimaryRadioButtonStyle}" Content="DirectShape (LOD 100)" IsChecked="{Binding IsDirectShape}" GroupName="Output"/>
                            <RadioButton Style="{StaticResource PrimaryRadioButtonStyle}" Content="가변 패밀리 (LOD 300)" Margin="18,0" IsChecked="{Binding IsAdaptive}" GroupName="Output"/>
                            <!-- TODO: 파이프(MEP) 미구현 상태라 임시로 숨김. 구현 완료 시 Visibility="Collapsed" 제거하면 됨. -->
                            <RadioButton Style="{StaticResource PrimaryRadioButtonStyle}" Content="파이프 (MEP)" Margin="18,0" IsChecked="{Binding IsPiping}" GroupName="Output" Visibility="Collapsed"/>
                        </StackPanel>
                        <!-- 관종 토글(docs/211 § N). 창에 하나뿐인 관종 선택이다(2026-09-22: 곡관 설정·규격 매핑 탭의 중복 토글을 여기로 통일).
                             등급 해석·규격 매핑 콤보·곡관 판정·DirectShape 재질이 모두 이 값을 따른다. -->
                        <TextBlock Text="관종" Margin="0,12,0,3"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="주철관" GroupName="PipeMaterial" Tag="6,0,0,6" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding IsDuctileIronSelected, Mode=TwoWay}"/>
                            <RadioButton Content="강관" GroupName="PipeMaterial" Tag="0,6,6,0" Margin="-1,0,0,0" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding IsSteelSelected, Mode=TwoWay}"/>
                        </StackPanel>
                        <TextBlock Margin="0,16,0,5" Text="생성 전 선형(Line) 미리보기 확인 · 미리보기 유지"/>
                        <StackPanel Visibility="{Binding UsesStraightAndBendSettings, Converter={StaticResource BoolToVisibility}}">
                            <Border Background="#EEF2F7" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                            <TextBlock Text="관 배치 기준높이" FontWeight="SemiBold" Foreground="#4A6FA5" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" Width="210" VerticalAlignment="Center" ItemsSource="{Binding ZDatums, Mode=OneWay}" SelectedItem="{Binding ZDatum, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ZDatumDisplayName}, Mode=OneWay}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Canvas Width="150" Height="110" Margin="18,0,0,0" IsHitTestVisible="False">
                                    <Ellipse Canvas.Left="5" Canvas.Top="15" Width="80" Height="80" Stroke="#52606A" StrokeThickness="2" Fill="#F7FAFC"/>
                                    <Ellipse Canvas.Left="20" Canvas.Top="30" Width="50" Height="50" Stroke="#7B8790" StrokeThickness="2" Fill="White"/>
                                    <Line X1="5" Y1="55" X2="85" Y2="55" Stroke="#7B8790" StrokeDashArray="3,2"/>
                                    <Line X1="45" Y1="15" X2="45" Y2="95" Stroke="#7B8790" StrokeDashArray="3,2"/>
                                    <Ellipse Canvas.Left="41" Canvas.Top="11" Width="8" Height="8" Fill="{Binding ZDatum, Mode=OneWay, Converter={StaticResource EnumEqualsToBrush}, ConverterParameter=OutsideTop}"/>
                                    <Ellipse Canvas.Left="41" Canvas.Top="26" Width="8" Height="8" Fill="{Binding ZDatum, Mode=OneWay, Converter={StaticResource EnumEqualsToBrush}, ConverterParameter=Crown}"/>
                                    <Ellipse Canvas.Left="41" Canvas.Top="51" Width="8" Height="8" Fill="{Binding ZDatum, Mode=OneWay, Converter={StaticResource EnumEqualsToBrush}, ConverterParameter=Centerline}"/>
                                    <Ellipse Canvas.Left="41" Canvas.Top="76" Width="8" Height="8" Fill="{Binding ZDatum, Mode=OneWay, Converter={StaticResource EnumEqualsToBrush}, ConverterParameter=Invert}"/>
                                    <Ellipse Canvas.Left="41" Canvas.Top="91" Width="8" Height="8" Fill="{Binding ZDatum, Mode=OneWay, Converter={StaticResource EnumEqualsToBrush}, ConverterParameter=OutsideBottom}"/>
                                    <TextBlock Canvas.Left="92" Canvas.Top="7" FontSize="10" Text="외부 맨 위"/>
                                    <TextBlock Canvas.Left="92" Canvas.Top="23" FontSize="10" Text="크라운"/>
                                    <TextBlock Canvas.Left="92" Canvas.Top="48" FontSize="10" Text="중심선"/>
                                    <TextBlock Canvas.Left="92" Canvas.Top="73" FontSize="10" Text="관저고"/>
                                    <TextBlock Canvas.Left="92" Canvas.Top="89" FontSize="10" Text="외부 맨 아래"/>
                                </Canvas>
                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                    <Button Content="관·곡관 설정 열기…" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenPipeSpecsCommand}"
                                            Height="40" Margin="20, 0, 0 ,0"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="배치 간격 (m)" Margin="0,8,0,3"/>
                            <TextBox Text="{Binding IntervalM}" Width="150" HorizontalAlignment="Left" ToolTip="직관 분절 간격. 곡관 자리는 제외">
                                <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource PrimaryTextBoxStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsIntervalHighlighted}" Value="True"><Setter Property="BorderBrush" Value="#E67E22"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
                            </TextBox>
                            <TextBlock Text="이경관 길이(mm)" Margin="0,8,0,3"/>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding ReducerBodyLengthMm}" Width="150" HorizontalAlignment="Left"
                                     ToolTip="DN 변경 지점 이경관 몸통 길이 (임시값)"/>
                            </StackPanel>
                            </Border>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#EEF2F7" CornerRadius="8" Padding="14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDirectShape}" Value="True">
                                                <Setter Property="Grid.ColumnSpan" Value="3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            <StackPanel>
                            <TextBlock Text="곡관 설정" FontWeight="SemiBold" Foreground="#4A6FA5" Margin="0,0,0,8" Visibility="{Binding IsAdaptive, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="곡관 접합 판정" FontWeight="SemiBold" Foreground="#4A6FA5" Margin="0,0,0,8" Visibility="{Binding IsDirectShape, Converter={StaticResource BoolToVisibility}}"/>
                            <StackPanel Visibility="{Binding IsAdaptive, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="곡관 패밀리 : 유형 (5점 가변)" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="BendFamilyCombo" ItemsSource="{Binding AdaptiveComponentTypeNames, Mode=OneWay}" SelectedItem="{Binding BendFamilyTypeName, Mode=TwoWay}">
                                        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource PrimaryComboBoxStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsBendFamilyHighlighted}" Value="True"><Setter Property="BorderBrush" Value="#E67E22"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                                    </ComboBox>
                                    <TextBlock Foreground="#B26B00" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding BendPointCountNotice}" Visibility="{Binding HasBendPointCountNotice, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="곡관 파라미터 매핑" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                    <TextBlock Text="호칭지름 DN" Margin="0,8,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding BendParameterOptions, Mode=OneWay}" SelectedItem="{Binding BendDiameterParameterName, Mode=TwoWay}"/>
                                    <TextBlock Text="관 두께 e" Margin="0,8,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding BendParameterOptions, Mode=OneWay}" SelectedItem="{Binding BendWallThicknessParameterName, Mode=TwoWay}"/>
                                    <TextBlock Text="외경 OD" Margin="0,8,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding BendParameterOptions, Mode=OneWay}" SelectedItem="{Binding BendOuterDiameterParameterName, Mode=TwoWay}"/>
                            </StackPanel>
                            <TextBlock Foreground="#B26B00" Text="{Binding SettingsNotice}" TextWrapping="Wrap" Visibility="{Binding IsAdaptive, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="곡관 접합 종류" Margin="0,14,0,3"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}"
                                      ItemsSource="{Binding BendConnectionOptions, Mode=OneWay}"
                                      SelectedItem="{Binding BendConnectionOption, Mode=TwoWay}"
                                      ToolTip="{Binding BendConnectionToolTip}"/>
                            <!-- 강관 곡관·이형관 종류(docs/211 § G-3). 관종이 강관일 때만 보인다. -->
                            <StackPanel Visibility="{Binding IsSteelSelected, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="강관 곡관 종류(F)" Margin="0,10,0,3"/>
                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}"
                                          ItemsSource="{Binding SteelFittingClassOptions, Mode=OneWay}"
                                          SelectedItem="{Binding SteelFittingClassOption, Mode=TwoWay}"
                                          ToolTip="KS D 3578 이형관 종류 · 곡관 두께·무게 결정 (직관 STWW와 무관)"/>
                                <TextBlock Text="접합 적용" Margin="0,10,0,3"/>
                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}"
                                          ItemsSource="{Binding SteelApplicationModeOptions, Mode=OneWay}"
                                          SelectedItem="{Binding SteelApplicationModeOption, Mode=TwoWay}"
                                          ToolTip="강관 곡관의 접합 개소(슬롯 수)와 접합구성(1S/2S). 허용굴곡 판정에는 영향이 없다."/>
                            </StackPanel>
                            <!-- 주철관 소켓 전용 항목. 관종이 강관이면 접는다(docs/211 § G-4·§ N). -->
                            <StackPanel Visibility="{Binding IsDuctileIronSelected, Converter={StaticResource BoolToVisibility}}">
                            <!-- 이탈방지압륜 체크박스는 사용자 지시로 UI에서 제거(2026-09-22). 설정값 UseRestraintGland는 저장 파일·기록 경로에 그대로 남는다. -->
                            <TextBlock Text="곡관 형식" Margin="0,10,0,3"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}"
                                      ItemsSource="{Binding BendFormOptions, Mode=OneWay}"
                                      SelectedItem="{Binding BendFormOption, Mode=TwoWay}"
                                      ToolTip="A형: 양쪽 소켓(s=0, θ₁+θ₂) · B형: 한쪽 소켓(s=200) · 강관 미적용"/>
                            </StackPanel>
                            </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#EEF2F7" CornerRadius="8" Padding="14" Visibility="{Binding IsAdaptive, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                            <TextBlock Text="직관 설정" FontWeight="SemiBold" Foreground="#4A6FA5" Margin="0,0,0,8"/>
                            <!-- docs/236 § D — 창을 연 뒤 로드한 패밀리를 목록에 반영한다(곡관·파이프 시스템·레벨 목록도 함께). -->
                            <DockPanel Margin="0,0,0,3">
                                <Button DockPanel.Dock="Right" Content="새로고침" Style="{StaticResource CancelButtonStyle}" Padding="8,1" FontSize="11"
                                        Command="{Binding RefreshFamilyListsCommand}" ToolTip="패밀리·시스템·레벨 목록 다시 읽기"/>
                                <TextBlock Text="직관 패밀리 : 유형 (2점 가변)" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ComboBox x:Name="StraightFamilyCombo" ItemsSource="{Binding AdaptiveComponentTypeNames, Mode=OneWay}" SelectedItem="{Binding StraightFamilyTypeName, Mode=TwoWay}">
                                <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource PrimaryComboBoxStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsStraightFamilyHighlighted}" Value="True"><Setter Property="BorderBrush" Value="#E67E22"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                            </ComboBox>
                            <TextBlock Foreground="#B26B00" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding StraightPointCountNotice}" Visibility="{Binding HasStraightPointCountNotice, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="직관 파라미터 매핑" FontWeight="SemiBold" Margin="0,12,0,0"/>
                            <TextBlock Text="호칭지름 DN" Margin="0,8,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding StraightParameterOptions, Mode=OneWay}" SelectedItem="{Binding StraightDiameterParameterName, Mode=TwoWay}"/>
                            <TextBlock Text="관 두께 e" Margin="0,8,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding StraightParameterOptions, Mode=OneWay}" SelectedItem="{Binding StraightThicknessParameterName, Mode=TwoWay}"/>
                            <TextBlock Text="외경 OD" Margin="0,8,0,3"/><ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding StraightParameterOptions, Mode=OneWay}" SelectedItem="{Binding StraightOuterDiameterParameterName, Mode=TwoWay}"/>
                            </StackPanel>
                            </Border>
                            </Grid>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsPiping, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="파이프 시스템"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding PipingSystemTypeNames}" SelectedItem="{Binding PipingSystemTypeName}"/>
                            <TextBlock Margin="0,8,0,0" Text="PipeType"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding PipeTypeNames}" SelectedItem="{Binding PipeTypeName}"/>
                            <TextBlock Text="레벨" Margin="0,12,0,3"/>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding LevelNames}" SelectedItem="{Binding LevelName}"/>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="규격 매핑" Tag="SpecMapping">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <CheckBox Style="{StaticResource PrimaryCheckBoxStyle}" DockPanel.Dock="Right" Content="해결된 표기도 보기" IsChecked="{Binding ShowResolvedDiameterMappings, Mode=TwoWay}"/>
                            <!-- 관종 토글은 [모델 유형 선택] 탭 한 곳으로 통일(2026-09-22 사용자 지시). 등급 콤보는 그 관종의 등급만 보이고, 바꾸면 다른 관종 등급 행은 기본 등급으로 다시 잡힌다(docs/211 § N). -->
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="직경·관종 표기 → DN·등급 · 관종: [모델 유형 선택] 탭 · OD·두께: 규격표 자동"/>
                        </DockPanel>
                        <Grid Grid.Row="1">
                        <DataGrid Style="{StaticResource PrimaryDataGridStyle}" x:Name="MappingGrid" ItemsSource="{Binding DiameterMappingsView, Mode=OneWay}" SelectionMode="Extended" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                            <Setter Property="Background" Value="#FFF3CD"/>
                                            <Setter Property="BorderBrush" Value="#E67E22"/>
                                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="직경" Binding="{Binding RawValue, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="관종" Binding="{Binding KindRawValue, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="파일" Binding="{Binding FileName, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="건수" Binding="{Binding Count, Mode=OneWay}" IsReadOnly="True" Width="60"/>
                                <DataGridTextColumn Header="자동추정" Binding="{Binding AutoDiameterDisplay, Mode=OneWay}" IsReadOnly="True" Width="80"/>
                                <DataGridTemplateColumn Header="확정 DN" Width="120">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding DiameterOptions, Mode=OneWay}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedDiameterOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="등급" Width="120">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" ItemsSource="{Binding DataContext.MappingPipeKinds, Mode=OneWay, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding PipeKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="OD/thk" Binding="{Binding SpecificationDisplay, Mode=OneWay}" IsReadOnly="True" Width="90"/>
                                <DataGridTextColumn Header="상태" Binding="{Binding Status, Mode=OneWay}" IsReadOnly="True" Width="170">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding Status, Mode=OneWay}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2E7D32" FontWeight="SemiBold" Text="✔ 모든 직경 표기 해석 완료" Visibility="{Binding HasNoVisibleDiameterMappings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" Width="150" ItemsSource="{Binding MappingPipeKinds, Mode=OneWay}" SelectedItem="{Binding BulkMappingPipeKind, Mode=TwoWay}"/>
                            <Button Grid.Column="1" Content="전체 일괄 적용" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Command="{Binding ApplyBulkMappingCommand}" ToolTip="전 행 적용 — DN은 자동추정값, 등급은 왼쪽 선택값"/>
                            <!-- 관·곡관 규격표 진입점은 [관 · 곡관 설정] 탭 하나로 통일했다(2026-08-20, 중복 진입점 정리). -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Foreground="#B26B00" Text="{Binding DiameterUnresolvedCount, StringFormat=⚠ 확정 안 한 표기 {0}건}" ToolTip="확정 안 하면 자동추정값으로 배치"/>
                                <TextBlock Foreground="#B26B00" Margin="12,0,0,0" Text="{Binding SpecUnmatchedCount, StringFormat=⚠ 규격 미매칭 {0}건}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
                <!-- docs/220 — [선형 방향] + [배치 제외 구간] 병합. 좌: 선형 목록(반전), 우: 선형 전체 개요도(휠 줌·드래그 이동), 하단: 선택 선형의 제외 구간 표.
                     제외 구간은 Loader가 대상 레코드를 경계에서 잘라 넘기므로 시작 Sta.에서 관이 끝나고 끝 Sta.부터 다시 분절한다(docs/219). -->
                <TabItem Header="{Binding Exclusions.HeaderText, Mode=OneWay}" Tag="Exclusion">
                    <!-- docs/226 § C — 탭 높이가 콘텐츠 최소(개요도 180 + 범례 + 표·버튼 230)보다 작으면 아래를 잘라 버튼이 사라졌다.
                         루트 Grid 높이를 뷰포트에 맞추되 MinHeight 아래로는 줄이지 않아, 모자랄 때만 스크롤바가 생긴다.
                         Height 바인딩을 빼면 * 행이 Auto처럼 늘어나 표 자체 스크롤이 사라진다. 행 MinHeight를 바꾸면 MinHeight(440 = 180 + 범례 약 30 + 230)도 같이 맞춘다.
                         여백은 ScrollViewer에 둔다 — Grid에 두면 높이(=뷰포트)+여백이 늘 뷰포트를 넘어 스크롤바가 항상 뜬다. -->
                    <ScrollViewer Margin="12,10,12,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <Grid MinHeight="440"
                          Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <Grid.RowDefinitions>
                            <!-- docs/222 § B — 공간이 모자라면 개요도(180~360)가 먼저 줄고, 제외 구간 제목·표·버튼 묶음은 최소 230을 지킨다. -->
                            <RowDefinition Height="*" MinHeight="180" MaxHeight="360"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="230"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 선형 목록 -->
                            <Border BorderBrush="#D7E0E7" BorderThickness="1" CornerRadius="8" Background="White">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="36"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="#F8FAFC" BorderBrush="#D7E0E7" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="10,0">
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock Text="선형" FontWeight="SemiBold" Foreground="#4A6FA5"/>
                                            <TextBlock Text="클릭 선택 · Ctrl·Shift 다중" FontSize="11" Foreground="#52606A" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </Border>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding DirectionRows, Mode=OneWay}" SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="bd" Background="Transparent" BorderBrush="#EDF1F5" BorderThickness="0,0,0,1" Padding="10,6">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F6F9FC"/></Trigger>
                                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="#E8F1FF"/></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:AlignmentDirectionRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1F2A33" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title, Mode=OneWay}"/>
                                                        <TextBlock Text="{Binding MetaDisplay, Mode=OneWay}" FontSize="11" Foreground="#52606A" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <ToggleButton Grid.Column="1" IsChecked="{Binding IsReversed, Mode=TwoWay}" VerticalAlignment="Center" Cursor="Hand"
                                                                  ToolTip="정점 순서 뒤집기(좌표 불변) — 6m 분절이 반대편 끝부터 시작. 선택된 행이면 선택 전체에 같은 값 적용">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border x:Name="bd" Background="White" BorderBrush="#D7E0E7" BorderThickness="1" CornerRadius="5" Padding="7,2">
                                                                    <TextBlock x:Name="tx" Text="⇄ 반전" FontSize="12" Foreground="#52606A"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#4A6FA5"/></Trigger>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="#FFF1E3"/>
                                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#E67E22"/>
                                                                        <Setter TargetName="tx" Property="Text" Value="⇄ 반전됨"/>
                                                                        <Setter TargetName="tx" Property="Foreground" Value="#A4520C"/>
                                                                        <Setter TargetName="tx" Property="FontWeight" Value="SemiBold"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border Grid.Row="2" BorderBrush="#D7E0E7" BorderThickness="0,1,0,0" Padding="10,0">
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock VerticalAlignment="Center" Foreground="#3A6EA5" Text="{Binding ReversedCount, StringFormat=방향 반전 {0}건}"/>
                                            <Button Content="선택 반전" Style="{StaticResource CancelButtonStyle}" Padding="10,2" HorizontalAlignment="Right" Command="{Binding ReverseSelectedCommand}"/>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- 선형 전체 개요도 — 칸 크기 고정, 줌·이동은 컨트롤 안에서 -->
                            <Border Grid.Column="2" BorderBrush="#D7E0E7" BorderThickness="1" CornerRadius="8" Background="White" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="#F8FAFC" BorderBrush="#D7E0E7" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="10,0">
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock Text="선형 전체 개요도" FontWeight="SemiBold" Foreground="#4A6FA5"/>
                                            <TextBlock Text="휠 확대·축소 · 드래그 이동 · 더블클릭 전체 보기 · 띠 클릭 → 구간 선택" FontSize="11" Foreground="#52606A" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
                                        </DockPanel>
                                    </Border>
                                    <controls:AlignmentOverviewControl x:Name="OverviewControl" Grid.Row="1" Margin="0,0,0,6" Model="{Binding Overview, Mode=OneWay}"
                                                                       SelectLineCommand="{Binding SelectOverviewLineCommand}" SelectZoneCommand="{Binding SelectOverviewZoneCommand}"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <WrapPanel Grid.Row="1" Margin="2,6,0,8">
                            <Rectangle Width="18" Height="4" Fill="#4A6FA5" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="선택 선형" FontSize="11" Foreground="#52606A" Margin="0,0,14,0"/>
                            <Rectangle Width="18" Height="4" Fill="#B7C4D0" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="기타 선형" FontSize="11" Foreground="#52606A" Margin="0,0,14,0"/>
                            <TextBlock Text="● 시점 · ▶ 진행 방향(6m 분절 시작 쪽)" FontSize="11" Foreground="#52606A" Margin="0,0,14,0"/>
                            <Rectangle Width="18" Height="8" Fill="#73C0392B" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="배치 제외 구간" FontSize="11" Foreground="#52606A" Margin="0,0,14,0"/>
                            <TextBlock Text="Sta.: 엑셀 Station 열은 위치 고정 · 없으면 진행 방향 시점부터" FontSize="11" Foreground="#52606A"/>
                        </WrapPanel>
                        <!-- 배치 제외 구간 표 — 선택 선형의 구간만(전체 보기 토글) -->
                        <Grid Grid.Row="2" DataContext="{Binding Exclusions}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="배치 제외 구간" FontWeight="SemiBold" Foreground="#4A6FA5" VerticalAlignment="Center"/>
                                <TextBlock Text="  구간 내 관·곡관 미배치 (밸브실 등) · 선택 선형의 구간만 표시" Foreground="#52606A" FontSize="11" VerticalAlignment="Center"/>
                                <CheckBox Style="{StaticResource PrimaryCheckBoxStyle}" Content="전체 보기" IsChecked="{Binding ShowAllRows, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid x:Name="ExclusionGrid" Grid.Row="1" Style="{StaticResource PrimaryDataGridStyle}" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                      SelectionMode="Extended" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" CanUserDeleteRows="False"
                                      VerticalScrollBarVisibility="Auto" PreviewKeyDown="ExclusionGrid_PreviewKeyDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index, Mode=OneWay}" IsReadOnly="True" Width="42"/>
                                    <DataGridTextColumn Header="구간명" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="120"/>
                                    <DataGridTemplateColumn Header="대상 선형" Width="*" MinWidth="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource PrimaryComboBoxStyle}" DisplayMemberPath="Label"
                                                          ItemsSource="{Binding DataContext.Targets, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          SelectedItem="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="시작 Sta." Binding="{Binding StartText, UpdateSourceTrigger=LostFocus}" Width="105">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="끝 Sta." Binding="{Binding EndText, UpdateSourceTrigger=LostFocus}" Width="105">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="길이(m)" Binding="{Binding LengthText, Mode=OneWay}" IsReadOnly="True" Width="75">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="상태" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" ToolTip="{Binding MessagesText}">
                                                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="0,0,6,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Warning"><Setter Property="Foreground" Value="#B26B00"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Foreground" Value="#C0392B"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding FirstMessage}" Foreground="#52606A" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel Grid.Row="2" Margin="0,8,0,0">
                                <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="28" Command="{Binding AddCommand}" ToolTip="구간 추가" Margin="0,0,6,0">
                                    <iconPacks:PackIconMaterial Kind="Plus" Width="16" Height="16"/>
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="28" Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedItems, ElementName=ExclusionGrid}"
                                        ToolTip="선택 구간 삭제 (Ctrl·Shift로 다중 선택)" Margin="0,0,6,0">
                                    <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="16" Height="16"/>
                                </Button>
                                <Button Content="측점순 정렬" Style="{StaticResource CancelButtonStyle}" Command="{Binding SortCommand}" Padding="10,3"/>
                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#52606A" TextWrapping="Wrap"
                                           Text="측점: 0+352.5 · 352.5 · STA.0+352.5 · 엑셀(구간명·시작·끝) Ctrl+V"/>
                            </DockPanel>
                        </Grid>
                    </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
        <Grid Grid.Row="2" Margin="20,0,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
                <!-- docs/220 § E — [진단] 탭 대체. 주의 절점 표는 고정폭 텍스트로 싣는다. -->
                <Border Padding="10,8" Background="White" BorderBrush="#D7E0E7" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="진단" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="스냅 허용오차(mm)" VerticalAlignment="Center" Foreground="#52606A"/>
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Width="70" Margin="8,0" Text="{Binding SnapToleranceMm}"/>
                            <Button Content="진단 실행" Style="{StaticResource PrimaryButtonStyle}" Padding="12,3" Command="{Binding RunCommand}"/>
                        </StackPanel>
                        <TextBox Height="110" Margin="0,6,0,0" Text="{Binding DiagnosisText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Malgun Gothic" FontSize="12"
                                 Background="#FBFCFD" BorderBrush="#D7E0E7" Padding="6,4" IsTabStop="False"/>
                    </StackPanel>
                </Border>
                <StackPanel Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="{Binding PhaseText, Mode=OneWay}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ProgressDetail, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#52606A"/>
                    </Grid>
                    <ProgressBar Style="{StaticResource PrimaryProgressBarStyle}" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"/>
                </StackPanel>
                <Border Margin="0,8,0,0" Padding="10" Background="#E8F1FF" CornerRadius="6"
                        Visibility="{Binding IsAwaitingPreviewConfirm, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding PreviewConfirmMessage, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="미리보기 유지·중단" Style="{StaticResource CancelButtonStyle}"
                                    Command="{Binding CancelPreviewCommand}" Margin="0,0,8,0"/>
                            <Button Content="계속 생성" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ConfirmPreviewCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Margin="0,8,0,0" Padding="10" Background="#FFF8E8" CornerRadius="6"
                        Visibility="{Binding HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ResultSummary, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <ScrollViewer MaxHeight="110" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                            <TextBox Style="{StaticResource PrimaryTextBoxStyle}" Text="{Binding ResultWarningsText, Mode=OneWay}"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     Foreground="#B26B00" Background="Transparent" BorderThickness="0"
                                     Padding="0" IsTabStop="False"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <Border Margin="0,8,0,0" Padding="10" Background="#FFF8E8" CornerRadius="6"
                        Visibility="{Binding HasPreflightIssues, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="모델 생성 전 확인"/>
                        <ItemsControl ItemsSource="{Binding PreflightIssues, Mode=OneWay}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2,0,0">
                                        <Hyperlink Foreground="#B26B00" TextDecorations="Underline" Command="{Binding DataContext.NavigatePreflightIssueCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                            <Run Text="{Binding Message, Mode=OneWay}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="배치 취소" Style="{StaticResource CancelButtonStyle}" Command="{Binding CancelModelingCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="닫기" Style="{StaticResource CancelButtonStyle}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                <Button Content="모델 생성" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateCommand}"
                        IsEnabled="{Binding CanCreateModel, Mode=OneWay}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
