<Window x:Class="DHBIMWATER.UI.Views.Documentation.JunctionDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DHBIMWATER.UI.Views.Documentation"
        xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls"
        xmlns:core="clr-namespace:DHBIMWATER.Core.Piping;assembly=DHBIMWATER.Core"
        Title="격점상세 재료표 설정" Width="1260" Height="850" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource MainBackgroundBrush}"
        WindowStyle="None" AllowsTransparency="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BooleanInverterConverter x:Key="BooleanInverterConverter"/>
        <DataTemplate x:Key="GenericSymbol"><Rectangle Width="24" Height="24" Stroke="{StaticResource MainTextBrush}" StrokeThickness="1"/></DataTemplate>
        <DataTemplate x:Key="PipeSymbol"><Grid Width="28" Height="36">
            <Rectangle Width="12" Height="28" Stroke="{StaticResource MainTextBrush}" StrokeThickness="1"/>
            <Rectangle Width="24" Height="3" VerticalAlignment="Top" Fill="{StaticResource MainTextBrush}"/>
            <Rectangle Width="24" Height="3" VerticalAlignment="Bottom" Fill="{StaticResource MainTextBrush}"/>
        </Grid></DataTemplate>
        <DataTemplate x:Key="TeeSymbol"><Grid Width="34" Height="30">
            <Rectangle Width="32" Height="10" Stroke="{StaticResource MainTextBrush}" StrokeThickness="1" VerticalAlignment="Bottom"/>
            <Rectangle Width="10" Height="18" Stroke="{StaticResource MainTextBrush}" StrokeThickness="1" VerticalAlignment="Top"/>
        </Grid></DataTemplate>
        <DataTemplate x:Key="GateSymbol"><Canvas Width="34" Height="34">
            <Polygon Points="2,3 17,17 2,17" Stroke="{StaticResource MainTextBrush}" Fill="{StaticResource WhiteBrush}"/>
            <Polygon Points="32,3 17,17 32,17" Stroke="{StaticResource MainTextBrush}" Fill="{StaticResource WhiteBrush}"/>
            <Line X1="17" Y1="17" X2="17" Y2="31" Stroke="{StaticResource MainTextBrush}"/>
            <Ellipse Canvas.Left="12" Canvas.Top="27" Width="10" Height="5" Stroke="{StaticResource MainTextBrush}"/>
        </Canvas></DataTemplate>
        <DataTemplate x:Key="AirSymbol"><Grid Width="32" Height="34">
            <Rectangle Width="26" Height="3" VerticalAlignment="Bottom" Fill="{StaticResource MainTextBrush}"/>
            <Ellipse Width="20" Height="20" Stroke="{StaticResource MainTextBrush}" VerticalAlignment="Top"/>
            <Line X1="16" Y1="3" X2="16" Y2="0" Stroke="{StaticResource MainTextBrush}"/>
        </Grid></DataTemplate>
        <Style x:Key="JunctionSymbolStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource GenericSymbol}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="{x:Static core:JunctionSymbolKind.Pipe}"><Setter Property="ContentTemplate" Value="{StaticResource PipeSymbol}"/></DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="{x:Static core:JunctionSymbolKind.Tee}"><Setter Property="ContentTemplate" Value="{StaticResource TeeSymbol}"/></DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="{x:Static core:JunctionSymbolKind.Gate}"><Setter Property="ContentTemplate" Value="{StaticResource GateSymbol}"/></DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="{x:Static core:JunctionSymbolKind.Air}"><Setter Property="ContentTemplate" Value="{StaticResource AirSymbol}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="GroupBox" BasedOn="{StaticResource PrimaryGroupBox}">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource PrimaryCheckBoxStyle}">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource PrimaryDataGridStyle}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource AlternatingRowBrush}"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <controls:TitleBar Grid.Row="0"/>
      <Grid Grid.Row="1" Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource WhiteBrush}" CornerRadius="5" Padding="12" Margin="0,0,0,12">
            <TextBlock Text="{Binding HeaderSummary, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="작성 항목">
                        <StackPanel>
                            <CheckBox Content="배관재료표 일람표" IsChecked="{Binding CreateSchedule, Mode=TwoWay}"/>
                            <CheckBox Content="배관재료표 도면(드래프팅뷰)" IsChecked="{Binding CreateDrafting, Mode=TwoWay}"/>
                            <CheckBox Content="격점 평면 상세도" IsChecked="{Binding CreatePlan, Mode=TwoWay}"/>
                            <CheckBox Content="값이 없는 부재는 재료표 값부터 재기록"
                                      IsChecked="{Binding Backfill, Mode=TwoWay}"
                                      IsEnabled="{Binding IsBackfillEnabled, Mode=OneWay}"/>
                            <TextBlock Text="{Binding BackfillMessage, Mode=OneWay}" Foreground="{StaticResource TextSubBrush}" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="접합·부설·절단 수는 문서 전체를 규칙으로 다시 계산합니다. 손으로 고친 개수는 규칙 값으로 바뀝니다. 이 문서에 외부에서 만든 이음쇠·밸브류가 있으면 해제하고, 대상 부재만 선택한 뒤 다시 여세요."
                                       Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="수직분기 오프셋">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <RadioButton Content="위로 펼침" GroupName="Expand" IsChecked="{Binding ExpandVertical, Mode=TwoWay}" Margin="0,0,14,0"/>
                                <RadioButton Content="펼치지 않음" GroupName="Expand" IsChecked="{Binding ExpandVertical, Mode=TwoWay, Converter={StaticResource BooleanInverterConverter}}"/>
                            </StackPanel>
                            <TextBlock Text="부재 간격 (도면 위)" Margin="0,8,0,2"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding StepPaperMm, Mode=OneWay, StringFormat={}{0:F1} mm}" Width="72" VerticalAlignment="Center"/>
                                <Slider Minimum="5" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        IsEnabled="{Binding ExpandVertical, Mode=OneWay}" Value="{Binding StepPaperMm, Mode=TwoWay}"/>
                            </DockPanel>
                            <TextBlock Text="뷰 축척" Margin="0,8,0,2"/>
                            <ComboBox SelectedValue="{Binding ViewScale, Mode=TwoWay}" SelectedValuePath="Tag" Width="130" HorizontalAlignment="Left">
                                <ComboBoxItem Content="1/20" Tag="20"/><ComboBoxItem Content="1/50" Tag="50"/><ComboBoxItem Content="1/100" Tag="100"/>
                            </ComboBox>
                            <TextBlock Text="펼침 방향: 시트 위쪽(고정)" Margin="0,8,0,2"/>
                            <TextBlock Text="모델에는 n × 간격 × 축척이 심볼오프셋 값으로 기록됩니다. 부재 위치·연결·형상은 바뀌지 않습니다. 주관은 실제 길이 간격 그대로입니다."
                                       FontSize="11" Foreground="{StaticResource TextSubBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="상세도 · 표 옵션">
                        <StackPanel>
                            <CheckBox Content="부재 번호 원(태그)" IsChecked="{Binding PlaceTags, Mode=TwoWay}" IsEnabled="{Binding CanPlaceTags, Mode=OneWay}"/>
                            <TextBlock Text="{Binding TagTypeMessage, Mode=OneWay}" Foreground="{StaticResource TextSubBrush}" FontSize="11"/>
                            <ComboBox ItemsSource="{Binding TagTypes, Mode=OneWay}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedTagType, Mode=TwoWay}" IsEnabled="{Binding CanPlaceTags, Mode=OneWay}" Margin="0,3,0,8"/>
                            <CheckBox Content="재료표 형상 열에 유형 이미지" IsChecked="{Binding UseTypeImage, Mode=TwoWay}"/>
                            <TextBlock Text="이미 있는 뷰" Margin="0,6,0,2"/>
                            <RadioButton Content="그대로 둠" GroupName="Redraw" IsChecked="{Binding RedrawExistingDrafting, Mode=TwoWay, Converter={StaticResource BooleanInverterConverter}}" Margin="0,3"/>
                            <RadioButton Content="다시 그림" GroupName="Redraw" IsChecked="{Binding RedrawExistingDrafting, Mode=TwoWay}" Margin="0,3"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TabControl Grid.Row="0" Style="{StaticResource PrimaryTabControlStyle}">
                    <TabItem Header="격점 평면 상세도" Style="{StaticResource PrimaryTabItemStyle}">
                        <Grid Background="White" ClipToBounds="True">
                            <Canvas Background="White" Margin="10">
                                <Line X1="20" Y1="370" X2="740" Y2="370" Stroke="{StaticResource MainTextBrush}" StrokeThickness="1" StrokeDashArray="4 3"/>
                                <Rectangle Canvas.Left="50" Canvas.Top="355" Width="150" Height="30" Stroke="{StaticResource MainTextBrush}" StrokeThickness="1" Fill="{StaticResource WhiteBrush}"/>
                                <Rectangle Canvas.Left="200" Canvas.Top="355" Width="140" Height="30" Stroke="{StaticResource MainTextBrush}" StrokeThickness="1" Fill="{StaticResource WhiteBrush}"/>
                                <Rectangle Canvas.Left="262" Canvas.Top="337" Width="16" Height="18" Stroke="{StaticResource MainTextBrush}" StrokeThickness="1" Fill="{StaticResource WhiteBrush}"/>
                                <Rectangle Canvas.Left="340" Canvas.Top="355" Width="220" Height="30" Stroke="{StaticResource MainTextBrush}" StrokeThickness="1" Fill="{StaticResource WhiteBrush}"/>
                                <Rectangle Canvas.Left="558" Canvas.Top="355" Width="3" Height="30" Fill="{StaticResource CommonBorderBrush}"/>
                                <Rectangle Canvas.Left="190" Canvas.Top="285" Width="160" Height="145" Stroke="{StaticResource CommonBorderBrush}" StrokeDashArray="3 3"/>
                                <TextBlock Canvas.Left="196" Canvas.Top="290" Text="밸브실" Foreground="{StaticResource TextSubBrush}"/>
                                <Ellipse Canvas.Left="117" Canvas.Top="405" Width="20" Height="20" Stroke="{StaticResource PrimaryBrush}" Fill="{StaticResource WhiteBrush}"/>
                                <TextBlock Canvas.Left="124" Canvas.Top="407" Text="1" FontSize="10"/>
                                <Ellipse Canvas.Left="260" Canvas.Top="405" Width="20" Height="20" Stroke="{StaticResource PrimaryBrush}" Fill="{StaticResource WhiteBrush}"/>
                                <TextBlock Canvas.Left="267" Canvas.Top="407" Text="2" FontSize="10"/>
                                <ItemsControl ItemsSource="{Binding PreviewPoints, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding CanvasLeft, Mode=OneWay}"/><Setter Property="Canvas.Top" Value="{Binding CanvasTop, Mode=OneWay}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="28" Height="28" CornerRadius="14" BorderBrush="#2196F3" BorderThickness="1" Background="White">
                                                <TextBlock Text="{Binding Item.ItemNumber, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ContentControl Width="40" Height="42" Margin="8,0" Content="{Binding Item.SymbolKind, Mode=OneWay}" Style="{StaticResource JunctionSymbolStyle}"/>
                                                <StackPanel Margin="2,4">
                                                    <TextBlock Text="{Binding Item.Name, Mode=OneWay}"/>
                                                    <TextBlock Text="{Binding Item.Spec, Mode=OneWay}" FontSize="10" Foreground="{StaticResource TextSubBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Grid>
                    </TabItem>
                    <TabItem Header="재료표 도면" Style="{StaticResource PrimaryTabItemStyle}">
                    <DataGrid ItemsSource="{Binding TableRows, Mode=OneWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="번호" Binding="{Binding ItemNumber, Mode=OneWay}" Width="55"/>
                                <DataGridTextColumn Header="명칭" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="규격" Binding="{Binding Spec, Mode=OneWay}" Width="*"/>
                                <DataGridTemplateColumn Header="형상" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><Image Source="{Binding TypeImagePath, Mode=OneWay}" Width="38" Height="24" Stretch="Uniform"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="수량" Binding="{Binding Count, Mode=OneWay}" Width="55"/>
                                <DataGridTextColumn Header="비고" Binding="{Binding Remark, Mode=OneWay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
                <GroupBox Grid.Row="1" Header="모델에 기록할 심볼오프셋 (미리보기)" Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding OffsetRows, Mode=OneWay}" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="번호" Binding="{Binding ItemNumber, Mode=OneWay}" Width="45"/>
                            <DataGridTextColumn Header="부재" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="순번" Binding="{Binding Order, Mode=OneWay}" Width="45"/>
                            <DataGridTextColumn Header="월드 +위" Binding="{Binding WorldUpMm, Mode=OneWay}" Width="70"/>
                            <DataGridTextColumn Header="회전" Binding="{Binding Rotation, Mode=OneWay}" Width="55"/>
                            <DataGridTextColumn Header="로컬 X" Binding="{Binding LocalXmm, Mode=OneWay}" Width="60"/>
                            <DataGridTextColumn Header="로컬 Y" Binding="{Binding LocalYmm, Mode=OneWay}" Width="60"/>
                            <DataGridTextColumn Header="상태" Binding="{Binding Status, Mode=OneWay}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
                <TextBlock Grid.Row="2" Text="회전한 부재는 월드 위쪽을 부재 로컬 좌표로 바꿔 기록합니다." Foreground="{StaticResource TextSubBrush}" FontSize="10" Margin="3,4"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding SummaryLine, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                <TextBox Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" MaxHeight="70" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="오프셋만 0으로 되돌리기" Command="{Binding ResetOffsetsCommand, Mode=OneWay}" FontSize="10" Padding="12,6" Margin="4,0"/>
                <Button Content="취소" Command="{Binding CancelCommand, Mode=OneWay}" Padding="12,6" Margin="4,0"/>
                <Button Content="실행" Command="{Binding RunCommand, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}" Background="{StaticResource PrimaryBrush}" Foreground="{StaticResource WhiteBrush}" FontWeight="Bold" Padding="12,6" Margin="4,0"/>
            </StackPanel>
        </Grid>
      </Grid>
    </Grid>
</Window>
