<Window x:Class="DHBIMWATER.UI.Views.Documentation.JunctionDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DHBIMWATER.UI.Views.Documentation"
        xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls"
        xmlns:core="clr-namespace:DHBIMWATER.Core.Piping;assembly=DHBIMWATER.Core"
        Title="격점상세도" Width="1260" Height="850" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource MainBackgroundBrush}"
        WindowStyle="None" AllowsTransparency="False"
        FontFamily="Segoe UI, Malgun Gothic">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BooleanInverterConverter x:Key="BooleanInverterConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- 미리보기 도형 선 굵기. 도면 축소(Viewbox)에도 선이 가늘어지지 않게 한다. -->
        <Style x:Key="SymbolLine" TargetType="Shape">
            <Setter Property="Stroke" Value="{StaticResource MainTextBrush}"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
        <!-- 심볼은 44×44 칸의 중심(22,22)이 부재 위치다. 세로축 부재를 평면에서 본 개략 기호이며 플랜지는 별도 부재가 아니라 단관·밸브에 포함해 그린다. -->
        <DataTemplate x:Key="GenericSymbol"><Canvas Width="44" Height="44">
            <Rectangle Canvas.Left="10" Canvas.Top="10" Width="24" Height="24" Style="{StaticResource SymbolLine}" Fill="{StaticResource WhiteBrush}"/>
        </Canvas></DataTemplate>
        <DataTemplate x:Key="PipeSymbol"><Canvas Width="44" Height="44">
            <Rectangle Canvas.Left="14" Canvas.Top="6" Width="16" Height="32" Style="{StaticResource SymbolLine}" Fill="{StaticResource WhiteBrush}"/>
            <Rectangle Canvas.Left="8" Canvas.Top="3" Width="28" Height="4" Fill="{StaticResource MainTextBrush}"/>
            <Rectangle Canvas.Left="8" Canvas.Top="37" Width="28" Height="4" Fill="{StaticResource MainTextBrush}"/>
        </Canvas></DataTemplate>
        <DataTemplate x:Key="TeeSymbol"><Canvas Width="44" Height="44">
            <Rectangle Canvas.Left="2" Canvas.Top="22" Width="40" Height="16" Style="{StaticResource SymbolLine}" Fill="{StaticResource WhiteBrush}"/>
            <Rectangle Canvas.Left="14" Canvas.Top="6" Width="16" Height="16" Style="{StaticResource SymbolLine}" Fill="{StaticResource WhiteBrush}"/>
        </Canvas></DataTemplate>
        <DataTemplate x:Key="GateSymbol"><Canvas Width="44" Height="44">
            <Polygon Points="9,6 35,6 22,22" Style="{StaticResource SymbolLine}" Fill="{StaticResource WhiteBrush}"/>
            <Polygon Points="9,38 35,38 22,22" Style="{StaticResource SymbolLine}" Fill="{StaticResource WhiteBrush}"/>
            <Rectangle Canvas.Left="8" Canvas.Top="3" Width="28" Height="3" Fill="{StaticResource MainTextBrush}"/>
            <Rectangle Canvas.Left="8" Canvas.Top="38" Width="28" Height="3" Fill="{StaticResource MainTextBrush}"/>
            <Line X1="22" Y1="22" X2="42" Y2="22" Style="{StaticResource SymbolLine}" StrokeThickness="1"/>
            <Line X1="42" Y1="17" X2="42" Y2="27" Style="{StaticResource SymbolLine}" StrokeThickness="1"/>
        </Canvas></DataTemplate>
        <DataTemplate x:Key="AirSymbol"><Canvas Width="44" Height="44">
            <Rectangle Canvas.Left="17" Canvas.Top="26" Width="10" Height="12" Style="{StaticResource SymbolLine}" Fill="{StaticResource WhiteBrush}"/>
            <Ellipse Canvas.Left="8" Canvas.Top="4" Width="28" Height="28" Style="{StaticResource SymbolLine}" Fill="{StaticResource WhiteBrush}"/>
            <Rectangle Canvas.Left="8" Canvas.Top="38" Width="28" Height="3" Fill="{StaticResource MainTextBrush}"/>
            <Line X1="22" Y1="4" X2="22" Y2="-2" Style="{StaticResource SymbolLine}" StrokeThickness="1"/>
        </Canvas></DataTemplate>        <Style x:Key="JunctionSymbolStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource GenericSymbol}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="{x:Static core:JunctionSymbolKind.Pipe}"><Setter Property="ContentTemplate" Value="{StaticResource PipeSymbol}"/></DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="{x:Static core:JunctionSymbolKind.Tee}"><Setter Property="ContentTemplate" Value="{StaticResource TeeSymbol}"/></DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="{x:Static core:JunctionSymbolKind.Gate}"><Setter Property="ContentTemplate" Value="{StaticResource GateSymbol}"/></DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="{x:Static core:JunctionSymbolKind.Air}"><Setter Property="ContentTemplate" Value="{StaticResource AirSymbol}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="GroupBox" BasedOn="{StaticResource PrimaryGroupBox}">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource PrimaryCheckBoxStyle}">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource PrimaryDataGridStyle}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource AlternatingRowBrush}"/>
        </Style>
        <!-- 다른 창과 같은 컨트롤 모양을 쓰도록 암묵 스타일을 건다(종전에는 ComboBox·RadioButton·TextBox가 기본 WPF 모양이었다). -->
        <Style TargetType="RadioButton" BasedOn="{StaticResource PrimaryRadioButtonStyle}">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PrimaryComboBoxStyle}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource PrimaryTextBoxStyle}"/>
        <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelTextBlockStyle}">
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <controls:TitleBar Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- 왼쪽: 설정 3칸. 시안(279_격점상세도_창_목업.html)의 fieldset 순서·번호와 같게 둔다. -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel Margin="0,14,0,0">
                    <!-- 일람표·도면·평면 상세도는 항상 작성. 값 빈 부재는 실행 시 자동 기록. 체크는 문서 전체 개수 재산정 포함 -->
                    <GroupBox Header="1. 값 재기록">
                        <StackPanel>
                            <CheckBox Content="접합·부설·절단 수 다시 계산 (문서 전체)"
                                      IsChecked="{Binding Backfill, Mode=TwoWay}"
                                      IsEnabled="{Binding IsBackfillEnabled, Mode=OneWay}"/>
                            <TextBlock Text="{Binding BackfillMessage, Mode=OneWay}" Style="{StaticResource HintText}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 펼침 항상 켬, 축척 1/50 고정. 수직분기 세트(수평 부재에서 이어진 수직 구간)마다 축·간격 입력 -->
                    <GroupBox Header="2. 수직분기 오프셋 (세트별)">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,6" FontWeight="Normal"
                                       Text="간격은 도면 mm. 실제 이동 = 순서 × 간격 × 축척. 음수 = 반대 방향, 0 = 펼치지 않음."/>
                            <TextBlock Text="수직분기 세트가 없습니다." FontWeight="Normal">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HintText}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOffsetSets, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding OffsetSets, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource CommonBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label, Mode=OneWay}"/>
                                                <TextBlock Text="{Binding Members, Mode=OneWay}" Style="{StaticResource HintText}" TextWrapping="Wrap" FontWeight="Normal"/>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <RadioButton Content="X축" GroupName="{Binding AxisGroupName, Mode=OneWay}" Tag="6,0,0,6" Margin="0" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding IsX, Mode=TwoWay}"/>
                                                        <RadioButton Content="Y축" GroupName="{Binding AxisGroupName, Mode=OneWay}" Tag="0,6,6,0" Margin="-1,0,0,0" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding IsY, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="간격" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" FontWeight="Normal"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- 입력 0.3초 뒤 반영(포커스 안 잃어도). 숫자 아니면 이전 값 유지 + 빨간 테두리 -->
                                                        <TextBox Width="64" HorizontalContentAlignment="Right" ToolTip="도면 위 간격(mm). 음수 = 반대 방향"
                                                                 Text="{Binding StepText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}">
                                                            <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource PrimaryTextBoxStyle}"><Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasError, Mode=OneWay}" Value="True"><Setter Property="BorderBrush" Value="#E74C3C"/></DataTrigger>
                                                            </Style.Triggers></Style></TextBox.Style>
                                                        </TextBox>
                                                        <TextBlock Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" FontWeight="Normal"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding DirectionText, Mode=OneWay}" Style="{StaticResource HintText}" FontWeight="Normal"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 모든 세트 같은 값 -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="모든 세트" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Normal"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Content="X축" GroupName="BulkAxis" Tag="6,0,0,6" Margin="0" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding BulkAxisX, Mode=TwoWay}"/>
                                    <RadioButton Content="Y축" GroupName="BulkAxis" Tag="0,6,6,0" Margin="-1,0,0,0" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding BulkAxisY, Mode=TwoWay}"/>
                                </StackPanel>
                                <TextBox Grid.Column="3" Width="64" HorizontalContentAlignment="Right" Margin="8,0,6,0" VerticalAlignment="Center"
                                         Text="{Binding BulkStepText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="4" Content="적용" Command="{Binding ApplyAllSetsCommand, Mode=OneWay}" Style="{StaticResource CancelButtonStyle}" MinWidth="0" Padding="10,2"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="3. 상세도 · 표 옵션">
                        <StackPanel>
                            <CheckBox Content="부재 번호 원(태그) 붙이기" IsChecked="{Binding PlaceTags, Mode=TwoWay}" IsEnabled="{Binding CanPlaceTags, Mode=OneWay}"/>
                            <Grid Margin="22,2,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="태그 유형" Style="{StaticResource HintText}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding TagTypes, Mode=OneWay}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedTagType, Mode=TwoWay}" IsEnabled="{Binding CanPlaceTags, Mode=OneWay}"/>
                            </Grid>
                            <TextBlock Text="{Binding TagTypeMessage, Mode=OneWay}" Style="{StaticResource HintText}" Margin="22,0,0,4"/>
                            <CheckBox Content="재료표 형상 열에 유형 이미지 넣기" IsChecked="{Binding UseTypeImage, Mode=TwoWay}"/>
                            <TextBlock Text="이미 있는 뷰" Style="{StaticResource FieldLabel}"/>
                            <RadioButton Content="그대로 둠 (건너뜀)" GroupName="Redraw"
                                         IsChecked="{Binding RedrawExistingDrafting, Mode=TwoWay, Converter={StaticResource BooleanInverterConverter}}"/>
                            <RadioButton Content="다시 그림" GroupName="Redraw" IsChecked="{Binding RedrawExistingDrafting, Mode=TwoWay}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- 오른쪽: 요약 줄 · 미리보기 탭 · 기록할 오프셋 · 결과 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource CommonBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                    <TextBlock Text="{Binding HeaderSummary, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>

                <TabControl Grid.Row="1" Style="{StaticResource PrimaryTabControlStyle}">
                    <TabItem Header="격점 평면 상세도" Style="{StaticResource PrimaryTabItemStyle}">
                        <Grid Background="{StaticResource WhiteBrush}">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <!-- 760×450 설계 좌표를 Viewbox가 창 크기에 맞춰 줄인다. 종전에는 창 높이보다 큰 좌표(y=370)를 그대로 써서 아래가 잘렸다. -->
                            <!-- 휠 확대·축소, 가운데 버튼 끌기 이동, 더블클릭 맞춤. 보기 전용 변환이라 code-behind 처리 -->
                            <Border Grid.Row="0" ClipToBounds="True" Margin="8">
                            <Viewbox Stretch="Uniform">
                                <Canvas x:Name="PreviewCanvas" Width="{Binding PreviewCanvasWidth, Mode=OneWay}" Height="{Binding PreviewCanvasHeight, Mode=OneWay}" Background="{StaticResource WhiteBrush}"
                                        MouseWheel="OnPreviewMouseWheel" MouseDown="OnPreviewMouseDown"
                                        MouseMove="OnPreviewMouseMove" MouseUp="OnPreviewMouseUp">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="PreviewScale"/>
                                            <TranslateTransform x:Name="PreviewTranslate"/>
                                        </TransformGroup>
                                    </Canvas.RenderTransform>
                                    <!-- 중심선: 주관(수평 부재 사이) + 세트(뿌리 → 마지막 부재) -->
                                    <Path Data="{Binding PreviewCenterGeometry, Mode=OneWay}" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1" StrokeDashArray="6 3 1.5 3" IsHitTestVisible="False"/>
                                    <!-- 격점 부재 전부(실제 평면 위치). 컨테이너 위치(X,Y) = 부재 원점. 번호 원 = Revit 태그 자리. 명칭은 툴팁 -->
                                    <ItemsControl ItemsSource="{Binding PreviewPoints, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X, Mode=OneWay}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y, Mode=OneWay}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Canvas Width="0" Height="0">
                                                    <Grid Width="20" Height="20" Canvas.Left="{Binding NumberLeft, Mode=OneWay}" Canvas.Top="{Binding NumberTop, Mode=OneWay}" ToolTip="{Binding ToolTip, Mode=OneWay}">
                                                        <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                                                            <DataTrigger Binding="{Binding Item.ItemNumber, Mode=OneWay}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        </Style.Triggers></Style></Grid.Style>
                                                        <Ellipse Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.4" Fill="{StaticResource WhiteBrush}"/>
                                                        <TextBlock Text="{Binding Item.ItemNumber, Mode=OneWay}" FontSize="11" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <!-- 기호선 좌표가 부재 원점 기준이라 (0,0)에 둔다. 연결 끊긴 부재 = 빨강 -->
                                                    <Path Data="{Binding ShapeGeometry, Mode=OneWay}" StrokeThickness="1.4" ToolTip="{Binding ToolTip, Mode=OneWay}">
                                                        <Path.Style><Style TargetType="Path" BasedOn="{StaticResource SymbolLine}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasShape, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Item.Connected, Mode=OneWay}" Value="False"><Setter Property="Stroke" Value="#E74C3C"/></DataTrigger>
                                                        </Style.Triggers></Style></Path.Style>
                                                    </Path>
                                                    <!-- 기호선 없는 패밀리: 종류별 대체 기호(흐리게) -->
                                                    <ContentControl Canvas.Left="{Binding SymbolLeft, Mode=OneWay}" Canvas.Top="{Binding SymbolTop, Mode=OneWay}" Width="44" Height="44" RenderTransformOrigin="0.5,0.5"
                                                                    Content="{Binding Item.SymbolKind, Mode=OneWay}" Opacity="0.55" ToolTip="{Binding ToolTip, Mode=OneWay}">
                                                        <ContentControl.Style><Style TargetType="ContentControl" BasedOn="{StaticResource JunctionSymbolStyle}"><Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasShape, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        </Style.Triggers></Style></ContentControl.Style>
                                                        <ContentControl.RenderTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></ContentControl.RenderTransform>
                                                    </ContentControl>
                                </Canvas>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 세트별 간격 치수(순서 1→2) -->
                                    <ItemsControl ItemsSource="{Binding PreviewDimensions, Mode=OneWay}" IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Canvas>
                                                    <Path Data="{Binding Geometry, Mode=OneWay}" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1"/>
                                                    <TextBlock Canvas.Left="{Binding LabelLeft, Mode=OneWay}" Canvas.Top="{Binding LabelTop, Mode=OneWay}"
                                                               Text="{Binding Text, Mode=OneWay}" Foreground="{StaticResource PrimaryBrush}" FontSize="11"/>
                                                </Canvas>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Viewbox>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="10,0,10,6">
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                           Text="패밀리 기호선을 실제 평면 위치에 그린 예상도입니다(낮음 상세수준). 기호선 없는 패밀리는 대체 기호, 연결 끊긴 부재는 빨간색입니다. 부재에 마우스를 올리면 명칭이 보입니다."/>
                                <ItemsControl ItemsSource="{Binding PreviewWarnings, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Mode=OneWay, StringFormat=⚠ {0}}" Foreground="#E74C3C" FontSize="11" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="재료표 도면" Style="{StaticResource PrimaryTabItemStyle}">
                        <DataGrid ItemsSource="{Binding TableRows, Mode=OneWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="번호" Binding="{Binding ItemNumber, Mode=OneWay}" Width="55"/>
                                <DataGridTextColumn Header="명칭" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="규격" Binding="{Binding Spec, Mode=OneWay}" Width="*"/>
                                <DataGridTemplateColumn Header="형상" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><Image Source="{Binding TypeImagePath, Mode=OneWay}" Width="38" Height="24" Stretch="Uniform"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="수량" Binding="{Binding Count, Mode=OneWay}" Width="55"/>
                                <DataGridTextColumn Header="비고" Binding="{Binding Remark, Mode=OneWay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>

                <GroupBox Grid.Row="2" Header="모델에 기록할 심볼오프셋 (미리보기)" Margin="0,16,0,0">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding OffsetRows, Mode=OneWay}" FontSize="11" MaxHeight="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="번호" Binding="{Binding ItemNumber, Mode=OneWay}" Width="45"/>
                                <DataGridTextColumn Header="부재" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="세트" Binding="{Binding Set, Mode=OneWay}" Width="80"/>
                                <DataGridTextColumn Header="순번" Binding="{Binding Order, Mode=OneWay}" Width="45"/>
                                <DataGridTextColumn Header="월드 이동(mm)" Binding="{Binding WorldUpMm, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="회전" Binding="{Binding Rotation, Mode=OneWay}" Width="55"/>
                                <DataGridTextColumn Header="로컬 X(mm)" Binding="{Binding LocalXmm, Mode=OneWay}" Width="100"/>
                                <DataGridTextColumn Header="로컬 Y(mm)" Binding="{Binding LocalYmm, Mode=OneWay}" Width="100"/>
                                <DataGridTextColumn Header="상태" Binding="{Binding Status, Mode=OneWay}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource HintText}" Text="세트별 펼침 방향을 부재의 로컬 좌표로 바꿔 기록합니다."/>
                    </StackPanel>
                </GroupBox>

                <Expander Grid.Row="3" Header="기호선 읽기 진단" IsExpanded="False" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ShapeDiagnosticSummary, Mode=OneWay}" FontWeight="SemiBold" Margin="4,4"/>
                        <ItemsControl ItemsSource="{Binding ShapeDiagnosticLines, Mode=OneWay}" MaxHeight="130">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Mode=OneWay}" TextWrapping="Wrap" FontSize="11" Margin="4,2"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- 실행 결과: 시안의 '완료' 영역. 결과 줄이 없으면 숨긴다. -->
                <Border Grid.Row="4" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource CommonBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultLines.Count, Mode=OneWay}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding ResultLines, Mode=OneWay}" MaxHeight="90">
                            <ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Mode=OneWay, StringFormat=• {0}}" TextWrapping="Wrap" FontSize="12" Margin="0,1"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 아래 줄: 요약(왼쪽) · 버튼(오른쪽) -->
        <Border Grid.Row="2" BorderBrush="{StaticResource CommonBorderBrush}" BorderThickness="0,1,0,0" Background="{StaticResource WhiteBrush}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SummaryLine, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="오프셋만 0으로 되돌리기" Command="{Binding ResetOffsetsCommand, Mode=OneWay}" Style="{StaticResource CancelButtonStyle}" Margin="4,0"/>
                    <Button Content="취소" Command="{Binding CancelCommand, Mode=OneWay}" Style="{StaticResource CancelButtonStyle}" Margin="4,0"/>
                    <Button Content="실행" Command="{Binding RunCommand, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0" MinWidth="90"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
