<Window x:Class="DHBIMWATER.UI.Views.Documentation.JunctionDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DHBIMWATER.UI.Views.Documentation"
        xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls"
        xmlns:vm="clr-namespace:DHBIMWATER.UI.ViewModels.Documentation"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="배관상세도" Width="1260" Height="850" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource MainBackgroundBrush}"
        WindowStyle="None" AllowsTransparency="False"
        FontFamily="Segoe UI, Malgun Gothic">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BooleanInverterConverter x:Key="BooleanInverterConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <!-- 세트 선택 강조색(docs/290). Color.Warning 브러시가 공용에 없어 여기서 만든다 -->
            <SolidColorBrush x:Key="SetHighlightBrush" Color="{StaticResource Color.Warning}"/>
            <!-- 미리보기 선 굵기(화면 px, PipeLayout 수준). code-behind가 캔버스→화면 배율로 나눠 덮어씀 → Viewbox 축소·휠 확대에도 화면 굵기 고정(docs/294) -->
            <sys:Double x:Key="Stroke.Symbol">2</sys:Double>
            <sys:Double x:Key="Stroke.SymbolHighlight">3</sys:Double>
            <sys:Double x:Key="Stroke.Wall">1.5</sys:Double>
            <sys:Double x:Key="Stroke.Center">1.2</sys:Double>
            <sys:Double x:Key="Stroke.CenterHighlight">2</sys:Double>
            <sys:Double x:Key="Stroke.Tag">1.4</sys:Double>
            <sys:Double x:Key="Stroke.TagHighlight">2</sys:Double>
            <sys:Double x:Key="Stroke.Dimension">1</sys:Double>
            <sys:Double x:Key="Stroke.DimensionHighlight">1.6</sys:Double>
            <sys:Double x:Key="Stroke.Thin">1</sys:Double>
        <!-- 미리보기 도형 선 굵기. Stroke.* 리소스 사용 → 도면 축소(Viewbox)에도 선 안 가늘어짐(docs/294) -->
        <Style x:Key="SymbolLine" TargetType="Shape">
            <Setter Property="Stroke" Value="{StaticResource MainTextBrush}"/>
            <Setter Property="StrokeThickness" Value="{DynamicResource Stroke.Symbol}"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
        <Style TargetType="GroupBox" BasedOn="{StaticResource PrimaryGroupBox}">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- 비활성 흐리게(docs/291). TODO: 전역 PrimaryCheckBoxStyle에도 비활성 표시 필요 — 지금은 활성과 똑같이 보임 -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource PrimaryCheckBoxStyle}">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource PrimaryDataGridStyle}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource AlternatingRowBrush}"/>
        </Style>
        <!-- 다른 창과 같은 컨트롤 모양을 쓰도록 암묵 스타일을 건다(종전에는 ComboBox·RadioButton·TextBox가 기본 WPF 모양이었다). -->
        <Style TargetType="RadioButton" BasedOn="{StaticResource PrimaryRadioButtonStyle}">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource PrimaryComboBoxStyle}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource PrimaryTextBoxStyle}"/>
        <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelTextBlockStyle}">
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <controls:TitleBar Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- 왼쪽: 설정 2칸. "값 재기록" 칸은 제거(docs/291) — 값 빈 부재 자동 기록만 유지, 문서 전체 재산정 없음 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel Margin="0,14,0,0">
                    <!-- 새 시트 도곽 + 평면·3D 축척 일괄. 축척은 실행 때 Revit 뷰에만 씀, 미리보기 캔버스는 그대로 -->
                    <GroupBox Header="1. 시트 · 축척">
                        <StackPanel>
                            <TextBlock Text="도곽 (제목 블록)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding TitleBlocks, Mode=OneWay}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedTitleBlock, Mode=TwoWay}" FontWeight="Normal"
                                      ToolTip="{Binding SelectedTitleBlock.Name, Mode=OneWay}"/>
                            <TextBlock Text="{Binding TitleBlockMessage, Mode=OneWay}" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" FontWeight="Normal" FontSize="11">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                    <DataTrigger Binding="{Binding TitleBlockMessage, Mode=OneWay}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" FontWeight="Normal"
                                       Text="새로 만드는 시트에만 적용합니다. 이미 있는 시트의 도곽은 바꾸지 않습니다."/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="뷰 축척" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ScaleChoices, Mode=OneWay}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedScale, Mode=TwoWay}" FontWeight="Normal"/>
                                <!-- '사용자' 선택 시만 입력칸. 1:n의 n 정수(1~24000), 틀리면 빨간 테두리 + 실행 막음 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsCustomScale, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="1 :" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Normal"/>
                                    <TextBox Width="64" HorizontalContentAlignment="Right" ToolTip="축척 분모(1~24000 정수)"
                                             Text="{Binding CustomScaleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}">
                                        <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource PrimaryTextBoxStyle}"><Style.Triggers>
                                            <DataTrigger Binding="{Binding HasScaleError, Mode=OneWay}" Value="True"><Setter Property="BorderBrush" Value="#E74C3C"/></DataTrigger>
                                        </Style.Triggers></Style></TextBox.Style>
                                    </TextBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" FontWeight="Normal"
                                       Text="평면뷰·3D뷰에 적용합니다. 재료표 드래프팅뷰는 1:1 그대로입니다. 축척이 바뀐 시트는 세 뷰를 다시 배치합니다."/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 펼침 항상 켬. 수직분기 세트(수평 부재에서 이어진 수직 구간)마다 축·간격 입력 -->
                    <GroupBox Header="2. 수직분기 오프셋 (세트별)">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,6" FontWeight="Normal"
                                       Text="간격은 실제 mm(심볼오프셋 값). 순서 n 부재 = n × 간격. 음수 = 반대 방향, 0 = 펼치지 않음."/>
                            <TextBlock Text="수직분기 세트가 없습니다." FontWeight="Normal">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HintText}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOffsetSets, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding OffsetSets, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 카드 클릭 = 세트 선택 → 캔버스 강조(docs/290). 선택 시 테두리 2px, 안쪽 여백 1px 줄여 내용 위치 고정 -->
                                        <Border CornerRadius="4" Margin="0,0,0,6" Background="Transparent" Cursor="Hand"
                                                PreviewMouseLeftButtonDown="OnSetCardMouseDown" GotKeyboardFocus="OnSetCardKeyboardFocus">
                                            <Border.Style><Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource CommonBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, Mode=OneWay}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource SetHighlightBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Setter Property="Padding" Value="7,5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style></Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label, Mode=OneWay}"/>
                                                <TextBlock Text="{Binding Members, Mode=OneWay}" Style="{StaticResource HintText}" TextWrapping="Wrap" FontWeight="Normal"/>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <RadioButton Content="X축" GroupName="{Binding AxisGroupName, Mode=OneWay}" Tag="6,0,0,6" Margin="0" MinWidth="56" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding IsX, Mode=TwoWay}"/>
                                                        <RadioButton Content="Y축" GroupName="{Binding AxisGroupName, Mode=OneWay}" Tag="0,6,6,0" Margin="-1,0,0,0" MinWidth="56" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding IsY, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                    <!-- 토글 기본 MinWidth 86 × 2면 이 칸 폭이 0에 가까워 글자가 토글 위로 넘침 → 토글 56 + 말줄임(docs/290) -->
                                                    <TextBlock Grid.Column="1" Text="간격" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" FontWeight="Normal" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- 입력 0.3초 뒤 반영(포커스 안 잃어도). 숫자 아니면 이전 값 유지 + 빨간 테두리 -->
                                                        <TextBox Width="64" HorizontalContentAlignment="Right" ToolTip="순서 1칸 실제 간격(mm) = 심볼오프셋 값. 음수 = 반대 방향"
                                                                 Text="{Binding StepText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}">
                                                            <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource PrimaryTextBoxStyle}"><Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasError, Mode=OneWay}" Value="True"><Setter Property="BorderBrush" Value="#E74C3C"/></DataTrigger>
                                                            </Style.Triggers></Style></TextBox.Style>
                                                        </TextBox>
                                                        <TextBlock Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" FontWeight="Normal"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding DirectionText, Mode=OneWay}" Style="{StaticResource HintText}" FontWeight="Normal"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 모든 세트 같은 값 -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="모든 세트" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Normal"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Content="X축" GroupName="BulkAxis" Tag="6,0,0,6" Margin="0" MinWidth="56" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding BulkAxisX, Mode=TwoWay}"/>
                                    <RadioButton Content="Y축" GroupName="BulkAxis" Tag="0,6,6,0" Margin="-1,0,0,0" MinWidth="56" Style="{StaticResource SegmentRadioButtonStyle}" IsChecked="{Binding BulkAxisY, Mode=TwoWay}"/>
                                </StackPanel>
                                <TextBox Grid.Column="3" Width="64" HorizontalContentAlignment="Right" Margin="8,0,6,0" VerticalAlignment="Center"
                                         Text="{Binding BulkStepText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="4" Content="적용" Command="{Binding ApplyAllSetsCommand, Mode=OneWay}" Style="{StaticResource CancelButtonStyle}" MinWidth="0" Padding="10,2"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="3. 상세도 · 표 옵션">
                        <StackPanel>
                            <CheckBox Content="부재 번호 원(태그) 붙이기" IsChecked="{Binding PlaceTags, Mode=TwoWay}" IsEnabled="{Binding CanPlaceTags, Mode=OneWay}"/>
                            <Grid Margin="22,2,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="태그 유형" Style="{StaticResource HintText}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding TagTypes, Mode=OneWay}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedTagType, Mode=TwoWay}" IsEnabled="{Binding CanPlaceTags, Mode=OneWay}"/>
                            </Grid>
                            <TextBlock Text="{Binding TagTypeMessage, Mode=OneWay}" Style="{StaticResource HintText}" Margin="22,0,0,4" TextWrapping="Wrap"/>
                            <!-- 태그 방향(docs/296). 지시선 자유 끝 = 부재 중심, 태그 중심과 직선 -->
                            <Grid Margin="22,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="태그 위치" Style="{StaticResource HintText}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding TagSideOptions, Mode=OneWay}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                          SelectedValue="{Binding TagSide, Mode=TwoWay}" IsEnabled="{Binding PlaceTags, Mode=OneWay}"
                                          ToolTip="자동 = 상하좌우 중 다른 기호·번호와 덜 겹치는 쪽, 같으면 격점 바깥쪽"/>
                            </Grid>
                            <!-- 기존 도면 뷰: 내용 바뀐 경우만 자동 다시 그림, 사용자 주석 보존(docs/291). 선택 라디오 제거 -->
                            <CheckBox Content="재료표 형상 열에 유형 이미지 넣기" IsChecked="{Binding UseTypeImage, Mode=TwoWay}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- 오른쪽: 요약 줄 · 미리보기 탭 · 기록할 오프셋 · 결과 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource CommonBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                    <TextBlock Text="{Binding HeaderSummary, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>

                <TabControl Grid.Row="1" Style="{StaticResource PrimaryTabControlStyle}">
                    <TabItem Header="배관상세도" Style="{StaticResource PrimaryTabItemStyle}">
                        <Grid Background="{StaticResource WhiteBrush}">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <!-- 760×450 설계 좌표를 Viewbox가 창 크기에 맞춰 줄인다. 종전에는 창 높이보다 큰 좌표(y=370)를 그대로 써서 아래가 잘렸다. -->
                            <!-- 휠 확대·축소, 가운데 버튼 끌기 이동, 더블클릭 맞춤. 보기 전용 변환이라 code-behind 처리 -->
                            <Border x:Name="PreviewHost" Grid.Row="0" ClipToBounds="True" Margin="8" SizeChanged="OnPreviewLayoutChanged">
                            <Viewbox Stretch="Uniform">
                                <Canvas x:Name="PreviewCanvas" Width="{Binding PreviewCanvasWidth, Mode=OneWay}" Height="{Binding PreviewCanvasHeight, Mode=OneWay}" Background="{StaticResource WhiteBrush}"
                                        MouseWheel="OnPreviewMouseWheel" MouseDown="OnPreviewMouseDown"
                                        MouseMove="OnPreviewMouseMove" MouseUp="OnPreviewMouseUp" SizeChanged="OnPreviewLayoutChanged">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="PreviewScale"/>
                                            <TranslateTransform x:Name="PreviewTranslate"/>
                                        </TransformGroup>
                                    </Canvas.RenderTransform>
                                    <!-- 밸브실 벽 외곽선 + 안쪽 치수(가로 x 세로, m). 문자는 벽 바깥 우측 상단(docs/293) -->
                                    <Path Data="{Binding PreviewWallGeometry, Mode=OneWay}" Stroke="{StaticResource TextSubBrush}" StrokeThickness="{DynamicResource Stroke.Wall}" IsHitTestVisible="False"/>
                                    <TextBlock Text="{Binding RoomLabel, Mode=OneWay}" Canvas.Right="{Binding RoomLabelRight, Mode=OneWay}" Canvas.Bottom="{Binding RoomLabelBottom, Mode=OneWay}"
                                               FontSize="11" Foreground="{StaticResource TextSubBrush}" IsHitTestVisible="False"/>
                                    <!-- 중심선: 주관(수평 부재 사이) + 세트(뿌리 → 마지막 부재) -->
                                    <!-- 세트 선택 중이면 선택 세트 외 중심선 흐림. 선택 세트 중심선은 아래 강조 Path -->
                                    <Path Data="{Binding PreviewCenterGeometry, Mode=OneWay}" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="{DynamicResource Stroke.Center}" StrokeDashArray="6 3 1.5 3" IsHitTestVisible="False">
                                        <Path.Style><Style TargetType="Path"><Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreviewDimmed, Mode=OneWay}" Value="True"><Setter Property="Opacity" Value="0.3"/></DataTrigger>
                                        </Style.Triggers></Style></Path.Style>
                                    </Path>
                                    <Path Data="{Binding PreviewHighlightCenterGeometry, Mode=OneWay}" Stroke="{StaticResource SetHighlightBrush}" StrokeThickness="{DynamicResource Stroke.CenterHighlight}" StrokeDashArray="6 3 1.5 3" IsHitTestVisible="False"/>
                                    <!-- 격점 부재 전부(실제 평면 위치). 컨테이너 위치(X,Y) = 부재 원점. 번호 원 = Revit 태그 자리. 명칭은 툴팁 -->
                                    <ItemsControl ItemsSource="{Binding PreviewPoints, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X, Mode=OneWay}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y, Mode=OneWay}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Canvas Width="0" Height="0">
                                                    <Canvas.Style><Style TargetType="Canvas"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding Highlight, Mode=OneWay}" Value="{x:Static vm:SetHighlight.Dimmed}"><Setter Property="Opacity" Value="0.3"/></DataTrigger>
                                                    </Style.Triggers></Style></Canvas.Style>
                                                    <!-- 지시선(docs/296): 부재 중심 → 번호 원 가장자리 -->
                                                    <Line X1="{Binding LeaderX1, Mode=OneWay}" Y1="{Binding LeaderY1, Mode=OneWay}" X2="{Binding LeaderX2, Mode=OneWay}" Y2="{Binding LeaderY2, Mode=OneWay}"
                                                          StrokeThickness="{DynamicResource Stroke.Thin}" IsHitTestVisible="False">
                                                        <Line.Style><Style TargetType="Line">
                                                            <Setter Property="Stroke" Value="{StaticResource PrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Highlight, Mode=OneWay}" Value="{x:Static vm:SetHighlight.Highlighted}"><Setter Property="Stroke" Value="{StaticResource SetHighlightBrush}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style></Line.Style>
                                                    </Line>
                                                    <Grid Width="20" Height="20" Canvas.Left="{Binding NumberLeft, Mode=OneWay}" Canvas.Top="{Binding NumberTop, Mode=OneWay}" ToolTip="{Binding ToolTip, Mode=OneWay}">
                                                        <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                                                            <DataTrigger Binding="{Binding Item.ItemNumber, Mode=OneWay}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        </Style.Triggers></Style></Grid.Style>
                                                        <!-- 선택 세트 = 강조색. 트리거가 이기도록 색·굵기는 Setter로 둔다 -->
                                                        <Ellipse Fill="{StaticResource WhiteBrush}">
                                                            <Ellipse.Style><Style TargetType="Ellipse">
                                                                <Setter Property="Stroke" Value="{StaticResource PrimaryBrush}"/>
                                                                <Setter Property="StrokeThickness" Value="{DynamicResource Stroke.Tag}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Highlight, Mode=OneWay}" Value="{x:Static vm:SetHighlight.Highlighted}">
                                                                        <Setter Property="Stroke" Value="{StaticResource SetHighlightBrush}"/>
                                                                        <Setter Property="StrokeThickness" Value="{DynamicResource Stroke.TagHighlight}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style></Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Item.ItemNumber, Mode=OneWay}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style><Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Highlight, Mode=OneWay}" Value="{x:Static vm:SetHighlight.Highlighted}"><Setter Property="Foreground" Value="{StaticResource SetHighlightBrush}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style></TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                    <!-- 기호선 좌표가 부재 원점 기준이라 (0,0)에 둔다. 연결 끊긴 부재 = 빨강 -->
                                                    <!-- 굵기는 SymbolLine Setter(Stroke.Symbol). 선택 세트 = 강조색·굵게, 연결 끊김 빨강이 뒤 트리거라 이김 -->
                                                    <Path Data="{Binding ShapeGeometry, Mode=OneWay}" ToolTip="{Binding ToolTip, Mode=OneWay}">
                                                        <Path.Style><Style TargetType="Path" BasedOn="{StaticResource SymbolLine}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasShape, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Highlight, Mode=OneWay}" Value="{x:Static vm:SetHighlight.Highlighted}">
                                                                <Setter Property="Stroke" Value="{StaticResource SetHighlightBrush}"/>
                                                                <Setter Property="StrokeThickness" Value="{DynamicResource Stroke.SymbolHighlight}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Item.Connected, Mode=OneWay}" Value="False"><Setter Property="Stroke" Value="#E74C3C"/></DataTrigger>
                                                        </Style.Triggers></Style></Path.Style>
                                                    </Path>
                                                    <!-- 기호선 없는 패밀리: 빨강 사각형 + X(심볼 없음 표시). 35px = 대체 범위(도면 ±2.2mm) -->
                                                    <Canvas Canvas.Left="-17.6" Canvas.Top="-17.6" Width="35.2" Height="35.2" Background="Transparent" ToolTip="{Binding ToolTip, Mode=OneWay}">
                                                        <Canvas.Style><Style TargetType="Canvas"><Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasShape, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        </Style.Triggers></Style></Canvas.Style>
                                                        <Rectangle Width="35.2" Height="35.2" Stroke="#E74C3C" StrokeThickness="{DynamicResource Stroke.Symbol}"/>
                                                        <Path Data="M0,0 L35.2,35.2 M35.2,0 L0,35.2" Stroke="#E74C3C" StrokeThickness="{DynamicResource Stroke.Thin}"/>
                                                    </Canvas>
                                </Canvas>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 세트별 간격 치수(순서 1→2) -->
                                    <ItemsControl ItemsSource="{Binding PreviewDimensions, Mode=OneWay}" IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Canvas>
                                                    <Canvas.Style><Style TargetType="Canvas"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding Highlight, Mode=OneWay}" Value="{x:Static vm:SetHighlight.Dimmed}"><Setter Property="Opacity" Value="0.3"/></DataTrigger>
                                                    </Style.Triggers></Style></Canvas.Style>
                                                    <Path Data="{Binding Geometry, Mode=OneWay}">
                                                        <Path.Style><Style TargetType="Path">
                                                            <Setter Property="Stroke" Value="{StaticResource PrimaryBrush}"/>
                                                            <Setter Property="StrokeThickness" Value="{DynamicResource Stroke.Dimension}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Highlight, Mode=OneWay}" Value="{x:Static vm:SetHighlight.Highlighted}">
                                                                    <Setter Property="Stroke" Value="{StaticResource SetHighlightBrush}"/>
                                                                    <Setter Property="StrokeThickness" Value="{DynamicResource Stroke.DimensionHighlight}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style></Path.Style>
                                                    </Path>
                                                    <TextBlock Canvas.Left="{Binding LabelLeft, Mode=OneWay}" Canvas.Top="{Binding LabelTop, Mode=OneWay}"
                                                               Text="{Binding Text, Mode=OneWay}" FontSize="11">
                                                        <TextBlock.Style><Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Highlight, Mode=OneWay}" Value="{x:Static vm:SetHighlight.Highlighted}"><Setter Property="Foreground" Value="{StaticResource SetHighlightBrush}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style></TextBlock.Style>
                                                    </TextBlock>
                                                </Canvas>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Viewbox>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="10,0,10,6">
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                           Text="패밀리 기호선을 실제 평면 위치에 그린 예상도입니다(낮음 상세수준). 기호선 없는 패밀리는 대체 기호, 연결 끊긴 부재는 빨간색입니다. 부재에 마우스를 올리면 명칭이 보입니다."/>
                                <ItemsControl ItemsSource="{Binding PreviewWarnings, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Mode=OneWay, StringFormat=⚠ {0}}" Foreground="{StaticResource ErrorTextBrush}" FontSize="11" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="재료표 도면" Style="{StaticResource PrimaryTabItemStyle}">
                        <DataGrid ItemsSource="{Binding TableRows, Mode=OneWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="번호" Binding="{Binding ItemNumber, Mode=OneWay}" Width="55"/>
                                <DataGridTextColumn Header="명칭" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="규격" Binding="{Binding Spec, Mode=OneWay}" Width="*"/>
                                <DataGridTemplateColumn Header="형상" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><Image Source="{Binding TypeImagePath, Mode=OneWay}" Width="38" Height="24" Stretch="Uniform"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="수량" Binding="{Binding Count, Mode=OneWay}" Width="55"/>
                                <DataGridTextColumn Header="비고" Binding="{Binding Remark, Mode=OneWay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>

                <GroupBox Grid.Row="2" Header="모델에 기록할 심볼오프셋 (미리보기)" Margin="0,16,0,0">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding OffsetRows, Mode=OneWay}" FontSize="11" MaxHeight="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="번호" Binding="{Binding ItemNumber, Mode=OneWay}" Width="45"/>
                                <DataGridTextColumn Header="부재" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="세트" Binding="{Binding Set, Mode=OneWay}" Width="80"/>
                                <DataGridTextColumn Header="순번" Binding="{Binding Order, Mode=OneWay}" Width="45"/>
                                <DataGridTextColumn Header="월드 이동(mm)" Binding="{Binding WorldUpMm, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="회전" Binding="{Binding Rotation, Mode=OneWay}" Width="55"/>
                                <DataGridTextColumn Header="로컬 X(mm)" Binding="{Binding LocalXmm, Mode=OneWay}" Width="100"/>
                                <DataGridTextColumn Header="로컬 Y(mm)" Binding="{Binding LocalYmm, Mode=OneWay}" Width="100"/>
                                <DataGridTextColumn Header="상태" Binding="{Binding Status, Mode=OneWay}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource HintText}" Text="세트별 펼침 방향을 부재의 로컬 좌표로 바꿔 기록합니다."/>
                    </StackPanel>
                </GroupBox>

                <Expander Grid.Row="3" Header="기호선 읽기 진단" IsExpanded="False" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ShapeDiagnosticSummary, Mode=OneWay}" FontWeight="SemiBold" Margin="4,4"/>
                        <!-- 높이 넘으면 스크롤. 읽기 전용 텍스트박스 → 드래그·Ctrl+A 복사 -->
                        <TextBox Text="{Binding ShapeDiagnosticText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 MaxHeight="160" FontSize="11" Margin="4,2"/>
                    </StackPanel>
                </Expander>

                <!-- 실행 결과: 시안의 '완료' 영역. 결과 줄이 없으면 숨긴다. -->
                <Border Grid.Row="4" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource CommonBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultLines.Count, Mode=OneWay}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding ResultLines, Mode=OneWay}" MaxHeight="90">
                            <ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Mode=OneWay, StringFormat=• {0}}" TextWrapping="Wrap" FontSize="12" Margin="0,1"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 아래 줄: 요약(왼쪽) · 버튼(오른쪽) -->
        <Border Grid.Row="2" BorderBrush="{StaticResource CommonBorderBrush}" BorderThickness="0,1,0,0" Background="{StaticResource WhiteBrush}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SummaryLine, Mode=OneWay}" ToolTip="{Binding SummaryToolTip, Mode=OneWay}"
                           TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="취소" Command="{Binding CancelCommand, Mode=OneWay}" Style="{StaticResource CancelButtonStyle}" Margin="4,0"/>
                    <Button Content="실행" Command="{Binding RunCommand, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0" MinWidth="90"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
