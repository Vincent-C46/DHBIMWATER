<Window x:Class="DHBIMWATER.UI.Views.Documentation.PipeMaterialRefreshView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DHBIMWATER.UI.Controls"
        xmlns:vm="clr-namespace:DHBIMWATER.UI.ViewModels.Documentation"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PipeMaterialRefreshViewModel, IsDesignTimeCreatable=False}"
        Title="DHBIMWATER - 부재 정보 갱신" Width="560" Height="600" WindowStartupLocation="CenterScreen"
        Background="#F4F7F9" WindowStyle="None" FontFamily="Segoe UI, Malgun Gothic">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="15" GlassFrameThickness="1" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DHBIMWATER.UI;component/Styles/Generic.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <controls:TitleBar Grid.Row="0"/>

        <!-- 대상 개수. 선택 안에 후보 있으면 선택 범위만 -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16,12" Margin="20,12,20,8"><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="{Binding ScopeText, Mode=OneWay, StringFormat=범위: {0}}" FontWeight="SemiBold" Margin="0,0,0,6" Grid.ColumnSpan="2"/>
            <TextBlock Grid.Row="1" Text="값 빈 배관 이음쇠·밸브류" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CandidateCount, Mode=OneWay, StringFormat={}{0}개}" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="2" Text="값 빈 계획관로 가변 패밀리" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AdaptiveCount, Mode=OneWay, StringFormat={}{0}개}" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="3" Text="값 빈 MEP 배관" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MepPipeCount, Mode=OneWay, StringFormat={}{0}개}" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="4" Text="관종(DH_관종) 빈 부재 / 재질로 판정 못 함" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="4" Grid.Column="1" FontWeight="SemiBold">
                <Run Text="{Binding MaterialMissingCount, Mode=OneWay}"/><Run Text="개 / "/><Run Text="{Binding MaterialUnresolvedCount, Mode=OneWay}"/><Run Text="개"/>
            </TextBlock>
            <TextBlock Grid.Row="5" Text="이미 값 있는 배관 부재 (재산정 대상, 문서 전체)"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RecountCount, Mode=OneWay, StringFormat={}{0}개}" FontWeight="SemiBold"/>
        </Grid></Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16,12" Margin="20,0,20,8"><StackPanel>
            <!-- 판정 못 한 부재만 대상. 재질·이름으로 정해진 부재와 이미 값 있는 부재는 안 바뀜 -->
            <DockPanel IsEnabled="{Binding HasUnresolvedMaterial, Mode=OneWay}" Margin="0,0,0,10">
                <TextBlock Text="판정 못 한 부재 관종" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <ComboBox ItemsSource="{Binding MaterialChoices, Mode=OneWay}" SelectedItem="{Binding FallbackMaterial, Mode=TwoWay}"
                          DisplayMemberPath="Label" Width="200" HorizontalAlignment="Left"/>
            </DockPanel>
            <CheckBox Content="개수까지 문서 전체 재산정" IsChecked="{Binding RecountAll, Mode=TwoWay}" FontWeight="SemiBold"/>
            <TextBlock Foreground="#B03A2E" FontSize="11" TextWrapping="Wrap" Margin="20,4,0,0"
                       Text="켜면 이미 값 있는 부재의 접합·부설·절단 수를 수량 규칙으로 다시 씁니다. 손으로 고친 개수는 덮어씁니다."/>
            <TextBlock Foreground="#7F8C8D" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="명칭·규격·번호·무게는 커넥터·배치점 실측으로, 관종은 재질 → 유형·패밀리 이름 순으로 채웁니다. MEP 배관은 연장 그대로, 접합 수는 6 m 정척 본수로 환산합니다. 격점번호는 채우지 않고 야간은 해제로 둡니다."/>
        </StackPanel></Border>

        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="12" Margin="20,0,20,8">
            <TextBox Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Background="Transparent"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
            <Button Content="실행" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" Width="90"/>
            <Button Content="닫기" Click="OnCloseClick" Style="{StaticResource CancelButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
